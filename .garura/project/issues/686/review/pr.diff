+        bad["gaps"][0]["from"] = ["b2", "b3"]
+        md = MD + "".join(f"G{i}\n" for i in range(1, 10))
+        self.assertTrue(any("at most 7" in p for p in cb.check(bad, md, BUILD, 7)[0]))
