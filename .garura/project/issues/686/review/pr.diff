+
+def quiet(fn, *args):
+    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
+        return fn(*args)
+
+
+BUILD = {"groups": [
+    {"id": "b1", "closed_by": "update", "update": "mu-9"},
+    {"id": "b2", "closed_by": "proposal"},
+    {"id": "b3", "closed_by": "proposal"},
+    {"id": "b4", "closed_by": "prototype-feedback"},
