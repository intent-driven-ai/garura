@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Tests for /review-knowledge's scripts: checking the brief, recording the person's reply."""
+import contextlib
+import io
+import json
+import os
+import shutil
+import sys
+import tempfile
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import check_brief as cb  # noqa: E402
