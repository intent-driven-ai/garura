diff --git a/core/tools/lint-components/lib/rules/asking-a-person.js b/core/tools/lint-components/lib/rules/asking-a-person.js
new file mode 100644
index 00000000..e159bb85
--- /dev/null
+++ b/core/tools/lint-components/lib/rules/asking-a-person.js
@@ -0,0 +1,53 @@
+'use strict';
+
+// A play or loop that asks a person a question must point to the shared rule for asking a
+// person, memory/standards/rules/asking-a-person.md (#821, follows #820).
+
+const fs = require('fs');
+
+const RULE_ID = 'asking-a-person/missing-pointer';
+const RULE_FILE = 'asking-a-person.md';
+
+// Signals that a play stops for a person's typed answer. Each one is a phrase compiled plays
+// use for a checkpoint or a question shown for a typed reply. AskUserQuestion is never used.
+const ASKS_A_PERSON = [
+  /\bcheckpoint\s*\(class:/i, // a compiled checkpoint step
+  /\bwait(?:s|ing)?\s+for\s+(?:a|the)?\s*(?:\w+'s\s+)?typed\b/i, // "wait for the typed reply"
+  /\btyped\s+(?:yes|approval|approve|answers?|repl(?:y|ies)|responses?|confirmation|decision)\b/i,
+  /\btypes?\s+[*`"]*yes\b/i, // "type **yes**"
+  /\basks?\s+for\s+approval\b/i,
+  /\binterviews?\s+the\s+(?:user|person)\b/i,
+];
+
+function asksAPerson(content) {
+  const lines = content.split('\n');
+  for (let i = 0; i < lines.length; i++) {
+    for (const signal of ASKS_A_PERSON) {
+      if (signal.test(lines[i])) return { line: i + 1, text: lines[i].trim() };
+    }
+  }
+  return null;
+}
+
+function checkPlay(component) {
+  const content = fs.readFileSync(component.file, 'utf8');
+  const asks = asksAPerson(content);
+  if (!asks || content.includes(RULE_FILE)) return [];
+  return [{
+    file: component.file,
+    rule: RULE_ID,
+    severity: 'error',
+    message: `${component.type} "${component.name}" asks a person a question (line ${asks.line}) but does not ` +
+      `point to the shared rule memory/standards/rules/${RULE_FILE}; name that file where the play asks`,
+    line: asks.line,
+  }];
+}
+
+function check(components) {
+  const all = [].concat(components.plays || [], components.loops || []);
+  let out = [];
+  for (const c of all) out = out.concat(checkPlay(c));
+  return out;
+}
+
+module.exports = { check, checkPlay, asksAPerson, RULE_ID };
diff --git a/core/tools/lint-components/test/asking-a-person.test.js b/core/tools/lint-components/test/asking-a-person.test.js
new file mode 100644
index 00000000..567b6097
--- /dev/null
+++ b/core/tools/lint-components/test/asking-a-person.test.js
@@ -0,0 +1,47 @@
+'use strict';
+// #821: a play that asks a person a question must point to asking-a-person.md.
+const assert = require('assert');
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { execFileSync } = require('child_process');
+const { checkPlay, RULE_ID } = require('../lib/rules/asking-a-person');
+let passed = 0;
+function t(label, got, want) { assert.deepStrictEqual(got, want, label); passed++; console.log(`  [PASS] ${label}`); }
+
+const ASKS = '**Step 2 — Checkpoint 1** · Owner: play · Checkpoint (class: standard)\n' +
+  'Show the draft, and ask the product owner to type **yes**, or **change: <what>**.\n';
+const POINTER = 'Every draft shown follows `standards/rules/asking-a-person.md`.\n';
+const SILENT = '**Step 1 — Count the files** · Owner: play (script)\nRun the script; no one is asked.\n';
+
+function play(body) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'asking-'));
+  fs.mkdirSync(path.join(dir, 'plays', 'shape-thing'), { recursive: true });
+  const file = path.join(dir, 'plays', 'shape-thing', 'SKILL.md');
+  fs.writeFileSync(file, `---\nname: shape-thing\ndescription: x\n---\n\n# shape-thing\n\n## Workflow\n${body}`);
+  return { dir, file };
+}
+function rules(body) {
+  const { file } = play(body);
+  return checkPlay({ file, name: 'shape-thing', type: 'play' }).map((v) => v.rule);
+}
+
+t('a play that asks a person and has no pointer fails', rules(ASKS), [RULE_ID]);
+t('a play that asks a person and points to the rule passes', rules(ASKS + POINTER), []);
+t('a play that asks no one passes', rules(SILENT), []);
+t('a play that waits for a typed reply and has no pointer fails',
+  rules('Show the summary and wait for the typed approval.\n'), [RULE_ID]);
+
+// Through the linter itself, with --target on any folder that holds plays/<name>/SKILL.md.
+function lint(body) {
+  const { dir } = play(body);
+  let out;
+  try {
+    out = execFileSync('node', [path.join(__dirname, '..', 'index.js'), '--target', dir], { encoding: 'utf8' });
+  } catch (e) { out = e.stdout; }
+  return JSON.parse(out).violations.filter((v) => v.rule === RULE_ID).length;
+}
+t('the linter names the play with no pointer (--target)', lint(ASKS), 1);
+t('the linter passes the play with the pointer (--target)', lint(ASKS + POINTER), 0);
+
+console.log(`\n${passed} passed, 0 failed`);
