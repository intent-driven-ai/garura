+            "branch": branch, "issue": issue, "round": rnd,
+            "review_dir": str(contract["review_dir"]),
+            "inputs": (contract.get("inputs") or {}).get(play) or {},
+            "answers": (contract.get("answers") or {}).get(play) or {}}
