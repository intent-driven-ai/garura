-def load_spine(path):
-    if yaml is None:
-        sys.stderr.write("lint_grounding.py: PyYAML required for --spine mode (pip install pyyaml)\n")
-        sys.exit(2)
-    with open(path, encoding="utf-8") as fh:
-        return model_names.check_spine(yaml.safe_load(fh) or {}, path)
