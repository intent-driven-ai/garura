-    title = None
-    sections = []  # list of [heading_text, body_lines]
-    in_fence = False
-    cur = None
-    for raw in text.splitlines():
-        stripped = raw.strip()
-        if stripped.startswith("```"):
-            in_fence = not in_fence
-            if cur is not None:
-                cur[1].append(raw)
-            continue
-        if in_fence:
-            if cur is not None:
-                cur[1].append(raw)
-            continue
-        if stripped.startswith("# ") and title is None:
-            title = stripped[2:].strip()
-            continue
-        if stripped.startswith("## "):
-            cur = [stripped[3:].strip(), []]
-            sections.append(cur)
-            continue
-        if cur is not None:
-            cur[1].append(raw)
-    return title, sections
