-        print(json.dumps(r))
-
-
-def main(argv=None):
-    ap = argparse.ArgumentParser()
-    sub = ap.add_subparsers(dest="cmd", required=True)
-
-    a = sub.add_parser("append")
-    a.add_argument("--ledger", required=True)
