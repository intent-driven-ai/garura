+POINTER = re.compile(r"\b(superseded|amended)\b|\[ADR (\d{3})\]\(", re.IGNORECASE)
+
+
+def pointers(status):
+    """The newer ADRs a Status line points to, by kind, in the order written: each forward
+    pointer reads "superseded ... by [ADR NNN](...)" or "amended ... by [ADR NNN](...)", and an
+    "and by [ADR NNN](...)" after one keeps its kind."""
+    found, kind = {"superseded": [], "amended": []}, None
+    for m in POINTER.finditer(status):
+        if m.group(1):
+            kind = m.group(1).lower()
+        elif kind and m.group(2) not in found[kind]:
+            found[kind].append(m.group(2))
+    return found
+
+
+def index_status(status, name):
+    """The index's Status cell: the status, and the newer ADRs that supersede or amend it, so a
+    reader of the index sees that an accepted ADR no longer holds in full (#1044)."""
+    if name.startswith("SUPERSEDED-"):
+        return "Superseded"
+    if not status:
+        return "(not recorded)"
+    found = pointers(status)
+    base = status.split(" — ")[0].split(" (")[0].strip()
+    if base.lower().startswith("superseded by"):
+        return "Superseded by " + ", ".join(found["superseded"]) if found["superseded"] else "Superseded"
+    parts = [base]
+    if found["superseded"]:
+        parts.append("superseded in part by " + ", ".join(found["superseded"]))
+    if found["amended"]:
+        parts.append("amended in part by " + ", ".join(found["amended"]))
+    return "; ".join(parts)
+
+
