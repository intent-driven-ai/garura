+# check-change, Step 2 (Assess Categories). PR #891, issue 875, base plan/788/base.
+# Derived from the content of the diff, not from a presumed list. Treatments are copied from the
+# playbook copies in short-term memory (.garura/project/issues/875/context/memory/knowledge/review/).
+pr: 891
+issue: 875
+base: plan/788/base
+severity_taxonomy: .garura/project/issues/875/context/memory/standards/rules/pr.md
+review_shelf: .garura/project/issues/875/context/memory/knowledge/review/
+next_map: .garura/project/issues/875/context/templates/standards/rules/pipeline-next.md
+categories:
+  - name: harness
+    what: "The shape-plan play: its compiled SKILL.md, its ICE source and its stop condition. The epic's tracker type changes from Feature to Epic (description, C13, F11, S1, D4)."
+    design_bearing: true
+    evidence:
+      - core/components/plays/shape-plan/SKILL.md
+      - core/components/plays/shape-plan/reference/ice.md
+      - core/components/plays/shape-plan/stop-condition.yaml
+    playbook: review/harness
+    treatment:
+      reviewer: "human (the design) + tool (conformance)"
+      layers: [1, 2]
+      linters:
+        - name: lint-components (source layout)
+          command: "node .garura/core/tools/lint-components/index.js --layout source --target core/components"
+        - name: lint-play (shape-plan)
+          command: "python3 .garura/core/tools/lint-play/lint_play.py core/components/plays/shape-plan/SKILL.md --next-map .garura/project/issues/875/context/templates/standards/rules/pipeline-next.md"
+      runnable_checks:
+        - "Only a violation whose file is in the PR's changed paths is a finding; count the others as 'there before'."
+        - "A tool not installed is recorded 'not installed'; a tool that crashes is recorded 'did not run: <first error line>'. Neither is a pass."
+        - "ICE-source rule applies (the repository holds the plays' source): the intent change in SKILL.md (description) must trace to reference/ice.md, and ice.md must be the source. Checked by hand."
+      design_grounding: "Layer 2 from committed sources on the base ref (docs/philosophy/**, docs/adr/**, standards/rules/**, glossary); never from the branch's new prose."
+
+  - name: memory
+    what: "The product ontology schema (version 11 to 12): the Epic is an issue of type Epic with no label; new rules R1 and R3; Q20 answer changed."
+    design_bearing: true
+    evidence:
+      - core/components/memory/standards/schemas/product-os/ontology.md
+    playbook: review/memory
+    treatment:
+      reviewer: "human (the design) + tool (conformance)"
+      layers: [1, 2]
+      linters:
+        - name: memory-integrity (GAP, no installed tool)
+          command: null
+      runnable_checks:
+        - "By hand, citing each: structure follows the schema's own shape; [[...]] and evolve_when cross-references resolve to real files; frontmatter version/updated moved together (11 to 12, 2026-10-25); the Epic's kind page, Q20 and the five-line summary agree with each other (the Epic row, R1, R3, the label rule)."
+        - "By hand: no duplicate or contradicting rule inside the ontology (for example, R2 is missing between R1 and R3; check that the numbering is intended)."
+      design_grounding: "Layer 2 from committed sources: the ontology on the base ref (git show plan/788/base:<path>), ADRs, the memory design files; not from the edit-ontology draft files this branch adds."
+
+  - name: executable-code
+    what: "Python scripts the shape-plan play runs: the epic type constant EPIC_TYPE changes from Feature to Epic; messages, docstrings and the brief text follow."
+    design_bearing: false
+    evidence:
+      - core/components/plays/shape-plan/scripts/check_tracker.py
+      - core/components/plays/shape-plan/scripts/plan_common.py
+      - core/components/plays/shape-plan/scripts/render_brief.py
+      - core/components/plays/shape-plan/scripts/write_work_items.py
+    playbook: review/code
+    treatment:
+      reviewer: "the tool, against industry best practice"
+      layers: [1]
+      linters:
+        - name: ruff (language linter the repo commits; installed at ~/.local/bin/ruff)
+          command: "ruff check core/components/plays/shape-plan/scripts/check_tracker.py core/components/plays/shape-plan/scripts/plan_common.py core/components/plays/shape-plan/scripts/render_brief.py core/components/plays/shape-plan/scripts/write_work_items.py"
+        - name: "check-pr-quality (pr.md taxonomy: SEC-*, CODE-*, ARCH-*, BE-*, PERF-*, DATA-*)"
+          command: "run by the play / quality-auditor against the diff with the pr.md copy above"
+      runnable_checks:
+        - "Weight the data-safety paths: write_work_items.py writes to the tracker (type change, label removal, sub-issue moves); confirm it still writes only after the recorded approval and that the type change is idempotent."
+        - "By hand: no stray debug output, no secrets, deterministic where it claims to be."
+      design_grounding: "none (the standard is industry best practice and the pr.md taxonomy)."
+
+  - name: tests
+    what: "Self-checking test scripts of the shape-plan play, updated to expect type Epic (and to use Feature as the wrong type)."
+    design_bearing: false
+    evidence:
+      - core/components/plays/shape-plan/scripts/test_check_tracker.py
+      - core/components/plays/shape-plan/scripts/test_render_brief.py
+      - core/components/plays/shape-plan/scripts/test_write_work_items.py
+    playbook: review/tests
+    treatment:
+      reviewer: "the tool"
+      layers: [1]
+      linters:
+        - name: ruff on the test code (clear assertions, no skipped or disabled tests, no test that asserts nothing)
+          command: "ruff check core/components/plays/shape-plan/scripts/test_check_tracker.py core/components/plays/shape-plan/scripts/test_render_brief.py core/components/plays/shape-plan/scripts/test_write_work_items.py"
+        - name: check-pr-quality (pr.md TEST-* rows)
+          command: "run by the play / quality-auditor against the diff with the pr.md copy above"
+      runnable_checks:
+        - "Run, do not just read. A red suite is a blocker."
+        - "cd core/components/plays/shape-plan/scripts && python3 test_check_tracker.py"
+        - "cd core/components/plays/shape-plan/scripts && python3 test_render_brief.py"
+        - "cd core/components/plays/shape-plan/scripts && python3 test_write_work_items.py"
+        - "Also run the unchanged tests that use the changed code (test_check_plan.py, test_find_work_items.py, test_gather_plan.py, test_write_plan_file.py, test_record_approval.py, test_check_drafts.py), since plan_common.EPIC_TYPE is shared. If one cannot run, say 'not run', never 'passed'."
+      design_grounding: "none."
+
+  - name: docs
+    what: "managing-work.md, the written rules for how work is tracked (CLAUDE.md points to it): the Epic is now filed as issue type Epic, and the type Feature is kept only from before. Human-read prose; not a play, skill, agent, ADR or memory file."
+    design_bearing: false
+    note: "Playbook review/docs governs (Layer 1 only). The rule it states is the same fact the harness and memory categories change, so its agreement with them is checked by hand under Layer 1 (terminology consistency); the grounding of that fact is done under harness and memory, not here."
+    evidence:
+      - .garura/user-provided/managing-work.md
+    playbook: review/docs
+    treatment:
+      reviewer: "the tool; the human opts out unless they choose to read it"
+      layers: [1]
+      linters:
+        - name: prose-linter (GAP, none committed in-repo)
+          command: null
+      runnable_checks:
+        - "By hand, citing each: spelling and grammar; dead links (the standard it names, docs/standards/harness-standard.md); heading hierarchy; leftover TODOs; terminology consistent with the ontology and the shape-plan files (Epic = type Epic, Feature as a model term only); completeness (the tree line, the 'Type lives in the type field' bullet)."
+      design_grounding: "none."
+
+  - name: plan-record
+    what: "A plan file (the work-order tree of business intent 788): status flips only (#875 next to now; #882 and #884 now/next to done)."
+    design_bearing: false
+    evidence:
+      - .garura/project/plans/788.yaml
+    playbook: null
+    playbook_missing: "No playbook covers a plan file. It is not a config map (it points at no file or directory by path) and not a doc. Create a follow-up task: write review/plan-records (who reviews, layers, linter = the plan checker the plan plays use, and the rule that a status flip must match the issue's real state)."
+    treatment:
+      reviewer: "the tool"
+      layers: [1]
+      linters: []
+      runnable_checks:
+        - "By hand (no playbook): the YAML parses; each changed status is one of the plan's allowed values; the flips match the tracker state of #875, #882, #884; no other node changed."
+      design_grounding: "none until a playbook says otherwise."
+
+  - name: run-records
+    what: "The change's own run records in the issue's short-term memory (analysis, branch, commits, PR body, self-review, edit-ontology draft files, a copy of the ontology template, the memory manifest). They record what the runs did; they are not shipped behaviour."
+    design_bearing: false
+    note: "They are branch-added content and are never used as grounding for any principle. They are read only as the stated intent of the change."
+    evidence:
+      - .garura/project/issues/875/context/analysis.yaml
+      - .garura/project/issues/875/context/branch.json
+      - .garura/project/issues/875/context/commits.yaml
+      - .garura/project/issues/875/context/edit-ontology/ (change-check.json, decisions.json, draft-kinds.md, draft-links.md, draft-questions.md, need.md, ontology-before.md, ontology-check.json)
+      - .garura/project/issues/875/context/issue.json
+      - .garura/project/issues/875/context/memory/manifest.json
+      - .garura/project/issues/875/context/memory/standards/templates/product-ontology.md
+      - .garura/project/issues/875/context/porcelain.txt
+      - .garura/project/issues/875/context/pr-body.md
+      - .garura/project/issues/875/context/pr.json
+      - .garura/project/issues/875/context/resolved-rules.json
+      - .garura/project/issues/875/context/self-review.md
+      - .garura/project/issues/875/context/work-description.txt
+    playbook: null
+    playbook_missing: "No playbook covers short-term-memory run records. Create a follow-up task: write review/run-records (these are evidence, not work; the review only checks no secrets or personal data, and that they do not stand in as grounding)."
+    treatment:
+      reviewer: "the tool"
+      layers: []
+      linters: []
+      runnable_checks:
+        - "By hand (no playbook): no secret, token, or personal name in these files (the garura history must stay free of client and personal references)."
+        - "Do not grade their design, and do not cite them as a basis for any finding."
+      design_grounding: "none."
+
+design_bearing: [harness, memory]
+playbook_missing: [plan-record, run-records]
