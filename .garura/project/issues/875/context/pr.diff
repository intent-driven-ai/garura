+---
+id: review/code
+title: "Reviewing executable code"
+conditions:
+  recognises: "the PR changes real executable source"
+  signals: ["bin/**", "lib/**", "src/**", "scripts/**/*.py", "**/*.{py,js,ts,mjs,cjs,go,java,rb}", "files the runtime actually executes"]
