+            fh.write("  owner: someone's edit in progress\n")
+        code, report, run = run_cli(self.target)
+        self.assertEqual(code, 0, run.stderr)
+        self.assertEqual(old_names_left(model), [])
+        self.assertFalse(report["committed"])
