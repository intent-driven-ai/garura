+            if f.endswith((".yaml", ".yml", ".md")):
+                t = open(p, encoding="utf-8", errors="ignore").read()
+                if re.search(r"^\s*functionalities\s*:|functionality_refs?\b|for_kind:\s*functionality\b", t, re.M):
