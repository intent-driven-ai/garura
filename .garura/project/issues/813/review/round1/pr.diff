-
-```json
-{
-  "status": "failed",
-  "error": {
-    "what_failed": "intent-recognition",
-    "details": "Intent '{goal}' does not match any skill in product-keeper's pool",
-    "responsible_domain": "<guess>",
-    "suggested_agent": "<guess or null>"
-  },
-  "task_id": "<echoed>"
-}
-```
