+class RemoveDecisions(RemovePartCase):
+    """The model's decision files go (ADR 069: no decision file lives in the model)."""
+
+    def setUp(self):
+        super().setUp()
+        self.write("_spine.yaml", SPINE.replace("  decisions:\n  - dec-2\n", ""))
