-
-
-# --------------------------------------------------------------------------
-# Verbs (stable contract — JSON in, JSON out)
-# --------------------------------------------------------------------------
-
-def rebuild():
-    """Regenerate the index by reusing pageindex's builder."""
-    proc = subprocess.run(
