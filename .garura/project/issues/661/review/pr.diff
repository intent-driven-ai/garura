+implement:
+  plan-tracking: true
+
+# review-pr play configuration
+review-pr:
+  bypass: true
+  confidence_threshold: 0.5
+  reviewer_count: 3
+  standards_order: [kb, ltm, stm]
+  fallback_reviewers: []
+  activity_window_days: 90
+
