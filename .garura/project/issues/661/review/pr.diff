diff --git a/core/tools/memory/contract/v5.json b/core/tools/memory/contract/v5.json
new file mode 100644
index 000000000..bd4b8d409
--- /dev/null
+++ b/core/tools/memory/contract/v5.json
@@ -0,0 +1,1358 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Memory tool contract",
+  "version": "5.0.0",
+  "contract_version": "5",
+  "description": "The one agreement between agents and the memory tool: the commands to find memory and to update it, what each takes and gives back, and how each fails. A request is a JSON object; on the command line its fields are the flags, and on a server they are the request body. A response is always a JSON object with ok, contract_version and command. Plain-words guide: ../README.md. Version 2 (#657): a lookup of Garura or Phoenix memory works without an issue; a glob never steps outside its tier; Phoenix memory is read only at its approved version; a file read from Phoenix memory is saved into Garura memory. Version 3 (#658): every memory update lands in an issue's short-term memory — moving memory up is the /learn-memory and /promote-memory plays, not this tool; an update says whether it blocks the work; a person decides each update in the review tool; a used file is never saved over a different Garura file. Version 4 (#659): every decision is recorded with the memory it rests on — cite records the question, the answer, who decided, the play, and each source's tier, file, lines and fingerprint (or the approved memory update it came from); citations lists an issue's decision records and checks that each source still exists and still says the same thing; a waiting draft is never found by a lookup. Version 5 (#661, ADR 039): the tool never copies a Phoenix file — read writes nothing, and pull and pulled are gone; Garura memory is its folders in order, core/memory then the product model, product (part of Garura memory), and nothing else in its root; every write the tool makes goes to the issue's short-term memory, and moving memory up is a promotion a person makes.",
+  "tiers": {
+    "short-term": "One issue's own memory: the plans, specs and context of the work on that issue. Root: the folder that holds one folder per issue. A lookup that names an issue reads short-term memory only in that issue's folder ('<issue>/'), never in another issue's; otherwise another issue's notes would answer first, and Garura and Phoenix memory would never be reached. A lookup with no issue has no short-term memory. Every memory update lands here.",
+    "garura": "Garura memory: the project's own memory. Its root is the project's Garura folder, and only its folders are read, in order: core/memory (garura_folders' first entry), then the product model, product — part of Garura memory, not all of it. Nothing else in that root is Garura memory. It is built from only the part of Phoenix memory the project needs (by initialize) and from what people promote; it never holds a copy the tool made (ADR 039).",
+    "phoenix": "Phoenix memory: the global memory and the superset. Its own git repository until Griffin serves it. Read only at its approved version: the commit the setting phoenix_ref names. A change reaches it when a person approves it outside Garura; until then (on a branch, or edited on disk) the tool does not read it."
+  },
+  "lookup_order": [
+    "short-term",
+    "garura",
+    "phoenix"
+  ],
+  "lookup_rule": "find and search look in lookup_order and stop at the first tier with at least one result. tier asks one tier only. every_tier looks in all three and does not stop. A lookup never skips a tier: one that reaches a tier with no setting, or one it cannot reach, fails with tier_missing. 'Never blocks a play' (ADR 035 §3) means a piece Garura memory does not hold is found a level up, not that a tier may be skipped. Short-term memory is only the request's issue: the tool looks in '<issue>/' under its root and nowhere else. A request that names no issue has no short-term memory: its lookup order is garura then phoenix, and asking for tier short-term without an issue is bad_request.",
+  "request_rules": {
+    "issue": "find, search and read name the issue the work is on when there is one. Short-term memory is read only in that issue's folder: a read of a short-term path outside it is bad_request. Without an issue, short-term memory is not part of the lookup (work can look things up before its issue exists); tier short-term without an issue is bad_request.",
+    "glob": "Shell-style: * matches within one folder, ** matches any depth, ? matches one character. A glob is a path pattern inside its tier: it never starts with a slash and never contains '..' (so '../613/**' is refused). In short-term memory it is matched inside the issue's folder.",
+    "pattern": "An extended regular expression, as grep -E reads it, unless fixed is true; then it is plain text.",
+    "tier_and_every_tier": "Asking for tier and every_tier together is bad_request.",
+    "read_lines": "start defaults to 1 and end to the last line. end before start is bad_request. Lines outside the file are out_of_range.",
+    "every_tier_answered_by": "With every_tier, answered_by is the first tier in lookup_order that has a result."
+  },
+  "answer_rules": {
+    "looked_in": "looked_in lists the tiers looked in, in the request's lookup order: lookup_order, without short-term when the request names no issue.",
+    "nothing_found": "answered_by null (nothing found) is allowed only after every tier of the request's lookup order was looked in, or just the asked tier when tier is given. Anything else is a silent skip.",
+    "first_answer_stops": "Without every_tier, answered_by is the last tier in looked_in.",
+    "results_from_looked_in": "Every hit and match comes from a tier in looked_in; without every_tier, only from answered_by.",
+    "fingerprint_is_the_text": "A fingerprint is the sha256 of the exact text it travels with: read.text, a hit's text.",
+    "short_term_is_this_issue": "Every short-term path in an answer (a match, a hit, a read, a trace step's source, where a cite is stored) starts with '<issue>/', the request's issue.",
+    "update_matches_its_status": "waiting: no decision yet (decided_by, reply, decided_at, decided_in and applied_version are null). approved or rejected: decided_by, reply, decided_at and decided_in are set; applied_version is null. applied: the decision is set and applied_version is the version written (null for a folder).",
+    "short_term_update_names_its_issue": "An update to short-term memory names its issue, and its target_path starts with '<issue>/'.",
+    "propose_waits": "propose answers status waiting, with the request's issue, missing, target_tier, target_path, draft, draft_source, sources and requested_by as given, and blocking as given (false when not given).",
+    "decide_records_the_person": "decide answers approve as approved and reject as rejected, for the update named, with decided_by, reply and decided_in exactly as given. A person decides each update on its own, in the review tool (decided_in review-tool); an agent never decides one.",
+    "apply_writes_only_approved": "apply answers ok only with status applied, for the update named. written.tier and written.path are the update's target_tier and target_path, and applied_version is written.version. Any update a person has not approved is not_approved.",
+    "updates_filter": "With status, updates lists only updates with that status.",
+    "answered_by_has_a_result": "answered_by names a tier only when that tier has at least one result, and it is null only when there are no results.",
+    "every_tier_looks_everywhere": "With every_tier, looked_in is the request's whole lookup order, and answered_by is the first tier in it that has a result.",
+    "read_answers_what_was_asked": "read answers the tier and path asked, the start and end asked (start 1 and the last line when not given), and end is never before start.",
+    "refusals": "A request the contract refuses is answered with that error, never with ok: tier with every_tier, a read with end before start, and a read of a short-term path outside the issue are bad_request. So are, since version 2: tier short-term without an issue, and a glob or path that steps outside its tier.",
+    "researched_goes_to_short_term": "Every memory update targets the issue's short-term memory, whatever drafted it (Kapil, 2026-10-18: \"STM - always STM\"). Moving memory up — to Garura memory (/learn-memory) or Phoenix memory (/promote-memory) — is done by those plays, not by this tool.",
+    "blocking": "An update with blocking false lets the rest of the work go on while it waits; only the work that needs the answer waits. An update with blocking true stops the work until a person decides (Kapil, 2026-10-18).",
+    "waiting_drafts_are_hidden": "A lookup (find, search, read) never returns a memory update that waits for a person, however its path is spelled (the tool decides on the file a path reaches, and a path has one spelling): updates are kept apart in the issue's short-term memory, and only an applied update's written file can be found. Otherwise a draft from the web or the model would drive the work with no person in between (ADR 036). Decision records are not memory either: a lookup never returns them, so an agent never decides from its own earlier decision.",
