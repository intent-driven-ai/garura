      "intents": [
        "bi-6"
      ],
      "one_line": "Names the business intents, capabilities and features each finding bears on, with why, or names it as fitting none, a possible new need, and names a defect or a part no page names for its owner.",
      "doc": "software-delivery-planning/understand-consumers-and-competition/fn-place-findings/feature.md",
      "identified_by": ""
    },
    {
      "id": "fn-hand-on-findings",
