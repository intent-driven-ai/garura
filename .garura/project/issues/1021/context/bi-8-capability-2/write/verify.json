   "slug": "fn-open-review",
   "capability": "cap-review-agent-work",
   "intents": [
    "bi-8"
   ],
   "status": "proposed",
   "one_line": "At a loop's end, Garura works out by meaning what the run changed, sends it to Argus as a review pack, opens the review for the person, and keeps each action as a file on the run's branch as it happens, so no agent reads the web page.",
   "doc": "software-delivery-planning/review-agent-work/fn-open-review/feature.md",
   "depends_on": [],
   "identified_by": "",
   "decisions": [],
   "metadata": {
    "created_by": "product-os-keeper (reorganise business intents, #1021)",
    "deepen": true
   }
  },
  "fn-read-outcome": {
   "id": "fn-read-outcome",
   "slug": "fn-read-outcome",
   "capability": "cap-review-agent-work",
   "intents": [
    "bi-8"
   ],
   "status": "proposed",
   "one_line": "One calm page shows the whole model's approval state first, then each changed intent with its ICE and each changed domain, capability, feature, limit and decision, in plain words with why it changed, never as files.",
   "doc": "software-delivery-planning/review-agent-work/fn-read-outcome/feature.md",
   "depends_on": [],
   "identified_by": "",
   "decisions": [],
   "metadata": {
    "created_by": "product-os-keeper (reorganise business intents, #1021)",
    "deepen": true
   }
  },
