    "new_entries": {
      "cap-fix-defects-test-first": {
        "capability": null,
        "domain": "dom-software-delivery-planning",
        "intents": [
          "bi-3"
        ],
        "status": "proposed",
        "one_line": "Fix a reported defect quickly and test first: the defect is understood against the product model, its tests and its code, the tests that prove it are written and shown to fail, then the code is fixed while every test of the project is run, and then tidied while they all pass. The builder never sees the tests; a separate check runs them.",
        "doc": "software-delivery-planning/fix-defects-test-first/capability.md",
        "metadata": {
          "created_by": "product-os-keeper (reorganise business intents, #1021)",
          "deepen": true
        }
      },
      "fn-understand-defect": {
        "capability": "cap-fix-defects-test-first",
        "domain": null,
        "intents": [
          "bi-3"
        ],
        "status": "proposed",
        "one_line": "From a defect reported anywhere, the developer who will write its tests finds the feature the defect breaks, the tests that already check that behaviour and why they pass, and the root cause, and writes only what the fix needs; a defect no feature covers is named as a new need and not fixed.",
        "doc": "software-delivery-planning/fix-defects-test-first/fn-understand-defect/feature.md",
        "metadata": {
          "created_by": "product-os-keeper (reorganise business intents, #1021)",
          "deepen": true
        }
      },
      "fn-write-defect-tests": {
        "capability": "cap-fix-defects-test-first",
        "domain": null,
        "intents": [
          "bi-3"
        ],
        "status": "proposed",
        "one_line": "Before any fix code, a test writer who is not the builder writes a code-level test for each wrong result the report names, and the separate check shows each one fails because the defect is there.",
        "doc": "software-delivery-planning/fix-defects-test-first/fn-write-defect-tests/feature.md",
        "metadata": {
          "created_by": "product-os-keeper (reorganise business intents, #1021)",
          "deepen": true
        }
      },
      "fn-fix-defect-code": {
        "capability": "cap-fix-defects-test-first",
        "domain": null,
        "intents": [
          "bi-3"
        ],
        "status": "proposed",
        "one_line": "The builder changes the code from the cause and what the fix changes until a separate check, which runs every test of the project through a tool on the model or service the test model setting names, finds them all passing, then tidies the code it changed while they stay passing; when a test still fails after the tries the project allows, the defect goes back to be understood again.",
        "doc": "software-delivery-planning/fix-defects-test-first/fn-fix-defect-code/feature.md",
        "metadata": {
          "created_by": "product-os-keeper (reorganise business intents, #1021)",
          "deepen": true
        }
      },
