+{
+  "by": "product-os-keeper (reorganise business intents, #1021); pages and one-lines taken as approved by the product owner",
+  "parts": [
+    {
+      "id": "cap-standards",
+      "kind": "capability",
+      "mode": "new",
+      "slug": "standards",
+      "domain": "dom-software-delivery-planning",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "Standards: Everything is built on the ICE model, with written standards for parts, sub-agents and naming, and checks that hold them.",
+      "doc": "software-delivery-planning/standards/capability.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-737",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "One page names each kind of part, sets out eleven principles, each with its reason and the ADR it comes from, and says how the standard is kept."
+    },
+    {
+      "id": "fn-738",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "Every change to the standard or its rule files is an accepted ADR that names each older ADR it supersedes or amends, and each older ADR points forward to it."
+    },
+    {
+      "id": "fn-build-from-ice",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-build-from-ice",
+      "capability": "cap-standards",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "Each play and loop is compiled from its ICE source and records its fingerprint, so a check can tell when the compiled part no longer matches its ICE.",
+      "doc": "software-delivery-planning/standards/fn-build-from-ice/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-standard-per-kind",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-standard-per-kind",
+      "capability": "cap-standards",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "Each kind of part, play, loop, sub-agent, skill, script, shared file and tool, has a written standard that says what it is and what it does.",
+      "doc": "software-delivery-planning/standards/fn-standard-per-kind/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-736",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "Every part is named by one rule: plain words, the verb first, one meaning per verb, never a coding tool's own command, with five roles owning the verbs."
+    },
+    {
+      "id": "fn-741",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "One rename map, and a read-only check that finds each use of an old name outside past records."
+    },
+    {
+      "id": "fn-743",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "The harness plays and the loop carry the standard's names, and move to each new name the standard sets."
+    },
+    {
+      "id": "fn-744",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "The change, plan, knowledge and record plays carry the standard's names, and move to each new name the standard sets."
+    },
+    {
+      "id": "fn-745",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "The lifecycle and lens plays carry the standard's names, and move to each new name the standard sets."
+    },
+    {
+      "id": "fn-746",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "Every skill carries a verb from the skill verb list, and moves to each new name the standard sets."
+    },
+    {
+      "id": "fn-740",
+      "kind": "feature",
+      "mode": "update",
+      "one_line": "The component linter, the play linter, the loop linter and the old-name check fail every part that breaks a written rule."
+    },
+    {
+      "id": "fn-rules-for-every-part",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-rules-for-every-part",
+      "capability": "cap-standards",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "Each rule every part follows, such as asking a person and staying on scope, is written once and binds every part without the part naming it.",
+      "doc": "software-delivery-planning/standards/fn-rules-for-every-part/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-one-severity",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-one-severity",
+      "capability": "cap-standards",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "One value, from written rules that start from an industry standard, says how bad a finding is and what is fixed first.",
+      "doc": "software-delivery-planning/standards/fn-one-severity/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-check-no-tracker-named",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-check-no-tracker-named",
+      "capability": "cap-standards",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "A check names each part that names a tracker, warns while the parts move onto the Agent-work tool, and fails after.",
+      "doc": "software-delivery-planning/standards/fn-check-no-tracker-named/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "cap-build-your-own-harness",
+      "kind": "capability",
+      "mode": "new",
+      "slug": "build-your-own-harness",
+      "domain": "dom-software-delivery-planning",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "Build your own harness: You can keep building your harness with your own plays, loops, sub-agents and skills, in a consistent way.",
+      "doc": "software-delivery-planning/build-your-own-harness/capability.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-build-play",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-build-play",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "/create-play builds a play from its ICE: it works out its scripts, skills and sub-agents, adds the change plays and the shared close, records the fingerprint and runs the play linter until clean.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-build-play/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-change-play",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-change-play",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "/edit-play changes a play through its ICE first, compiles it again with a new fingerprint and runs the play linter, so the play always matches its intent.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-change-play/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-build-loop",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-build-loop",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "/create-loop builds a loop from its ICE as its own values and a pointer to the shared loop run, with its Done means, settings and fingerprint, and runs the loop linter until clean.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-build-loop/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-change-loop",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-change-loop",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "/edit-loop changes a loop through its ICE first, on the person's typed approval, carries the change through and runs the loop linter, which fails a loop whose ICE changed since it was built.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-change-loop/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-check-loop-principles",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-check-loop-principles",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "The loop builders ask for each part the loop principles need, such as a goal a script can check and what starts the loop, and the loop linter fails a loop that misses one.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-check-loop-principles/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-add-gate",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-add-gate",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "The builders place a play's checkpoint where its workflow puts it, with its class, and pinning or unpinning it is a change to the play's intent through /edit-play.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-add-gate/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-mark-play-running",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-mark-play-running",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "Each play writes a record that it is running when it starts and clears it at its close, so the guardrails the install lays can refuse a shortcut taken without the play.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-mark-play-running/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-build-agent-skill",
+      "kind": "feature",
