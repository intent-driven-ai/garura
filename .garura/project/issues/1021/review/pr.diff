+{
+  "checked_on": "2026-11-10",
+  "tool": ".claude/skills/discover-capabilities/scripts/lint_grounding.py",
+  "first_run": "three feature pages failed once, each on short label bullets over their sub-bullets (fn-mark-item-type, fn-see-issues-worth-attention, fn-record-defect-under-story); each label was written out in full and the check run again",
