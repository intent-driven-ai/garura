+        "bi-10"
+      ],
+      "one_line": "A team builds a new sub-agent or skill to the written standard for its kind, and a check holds it to that standard, with no ICE of its own.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-build-agent-skill/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "fn-harness-in-own-repo",
+      "kind": "feature",
+      "mode": "new",
+      "slug": "fn-harness-in-own-repo",
+      "capability": "cap-build-your-own-harness",
+      "intents": [
+        "bi-10"
+      ],
+      "one_line": "A team installs Garura's builders in its own repository and builds its own plays and loops there, reading a written architecture of what each part may do.",
+      "doc": "software-delivery-planning/build-your-own-harness/fn-harness-in-own-repo/feature.md",
+      "identified_by": ""
+    },
+    {
+      "id": "cap-structure",
