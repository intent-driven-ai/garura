+-      "inputs":  { "domain":        "<id + slug + path under product-os>",
+-                   "product_base":  "<product_base>",
+-                   "manifest_path": "<working>/shape-manifest.yaml" },
+-      "outputs": { "routing":       "<working>/routing.yaml",
+-                   "manifest":      "<working>/shape-manifest.yaml" }
+-    }
