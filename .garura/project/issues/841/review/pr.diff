-    folder = os.path.dirname(os.path.normpath(os.path.join(root, path)))
-    while folder != stop and folder.startswith(stop + os.sep) and os.path.isdir(folder) \
-            and not os.listdir(folder):
-        os.rmdir(folder)
-        folder = os.path.dirname(folder)
-
-
-def main(argv=None):
