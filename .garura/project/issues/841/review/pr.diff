-    # new at base: drop it entirely
-    git(root, "rm", "-f", "--cached", "--ignore-unmatch", "--", path)
-    abspath = os.path.join(root, path)
-    if os.path.isfile(abspath):
-        os.remove(abspath)
-    return "removed"
-
-
-def prune_empty(root, path, stop_rel):
