-    rc, text = git_out(root, "show", f"{base_ref}:{path}")
-    if rc != 0:
-        return []
-    return text.splitlines()
-
-
-def is_decision_path(rel):
-    return "decision" in rel.replace(os.sep, "/").lower()
-
-
-def is_profile_path(rel):
-    return "profile" in os.path.basename(rel).lower()
