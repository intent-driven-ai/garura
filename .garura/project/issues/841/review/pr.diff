+-           "status_flips": status_flips}
+-    with open(args.out_manifest, "w", encoding="utf-8") as fh:
+-        json.dump(out, fh, indent=2)
+-    print(json.dumps(out, indent=2))
+-    return 0
+-
+-
+-if __name__ == "__main__":
+-    sys.exit(main(sys.argv[1:]))
