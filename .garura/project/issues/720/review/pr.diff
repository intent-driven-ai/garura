+++        with redirect_stdout(out):
+++            code = render_screen.main(["--screen", name, "--template", UPDATE, "--view-template", VIEW,
+++                                       "--work", self.work, "--at", at, "--plan-file", self.plan])
+++        self.assertEqual(code, 0)
+++        return out.getvalue()
