+++    def land(self):
+++        """What the landing does, with a stand-in for the tracker writes."""
+++        self.landing_list()
+++        ops = self.ops()
+++        shutil.copy(self.plan, self.p("plan-before.yaml"))
+++        after = json.loads(json.dumps(SNAP))
