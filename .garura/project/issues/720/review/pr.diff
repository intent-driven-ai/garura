++    rec["main_commit"] = git(["rev-parse", "HEAD"], repo).stdout.strip()
++    if remote:
++        git(["push", "--quiet", args.remote, args.main], repo)
++    git(["checkout", "--quiet", "-b", plan_branch], repo)
++    if remote:
