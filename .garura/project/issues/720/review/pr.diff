--- /dev/null
+++ b/core/components/plays/update-plan/scripts/check_agreement.py
@@ -0,0 +1,194 @@
+#!/usr/bin/env python3
+"""check_agreement.py — after the landing, the plan file, the tracker and the model agree (C6, C7, C11).
+
+    python3 check_agreement.py --changes <changes.yaml> --plan-before <plan-before.yaml> \
+        --plan-file <plans>/<id>.yaml --snapshot-before <snapshot-before.json> \
+        --snapshot-after <snapshot-after.json> --github-record <github-record.json> \
+        [--model-record <model-record.json>] [--spine <_spine.yaml>] \
+        [--evals-before <evals-before.json>] [--evals-after <evals-after.json>] \
+        --out <agreement.json>
+    python3 check_agreement.py hash-evals --plans-dir <plans> --out <evals.json>
+
+For each item the list names (its number from the tracker record for a new one):
+  - the plan file's status and the tracker agree: Done is closed as completed, Dropped is closed
+    as not planned, every other status is open;
+  - the plan file's title is the tracker's title;
+  - the item's parent in the plan file is its parent in the tracker (an item at the top of the
+    plan has the plan's business intent as its parent);
+  - the tracker type is its kind's type, after an add or a kind change;
+  - after a text change, the tracker's text is the new text.
+Nothing else changed: every node and every top field of the plan file that the list does not name
+reads as before (`updated` aside), and every issue of the snapshot that the list does not name
+reads as before in the tracker. For a new feature: the model record names its page and its
+entry, the spine has the feature with `metadata.thin: true` and its story's issue, its page has
+the Thin line, and its story's node stands for it (`features_ok`). The evals folders hash as
+before (`evals_unchanged`). The overrides and what is owed are named in the landing's commit
+message (commit_plan.py), not here.
+
+Output: {ok, problems: [..], features_ok, evals_unchanged, checked: [..]}.
+Exit 0 ok; 1 not ok (written); 2 bad input. Reads only.
+"""
+
+import argparse
+import glob
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_session as ps  # noqa: E402
+
+THIN_PREFIX = "Thin: "
+
+
+def hash_evals(plans_dir):
+    out = {}
+    for path in sorted(glob.glob(os.path.join(plans_dir, "*", "evals", "**", "*"), recursive=True)):
+        if os.path.isfile(path):
+            out[os.path.relpath(path, plans_dir)] = ps.sha256_of(path)
+    return out
+
+
+def node_parent(plan, issue, plan_id):
+    node, parent = ps.find(plan, issue)
+    if node is None:
+        return None, None
+    return node, (int(parent["issue"]) if parent else int(plan_id))
+
+
+def check(args):
+    changes = ps.load_list(args.changes) or {}
+    plan_id = str(changes.get("plan"))
+    before = ps.load_plan(args.plan_before)
+    after = ps.load_plan(args.plan_file)
+    snap0 = ps.read_json(args.snapshot_before, "the snapshot before")
+    snap1 = ps.read_json(args.snapshot_after, "the snapshot after")
+    rec = ps.read_json(args.github_record, "the tracker record") if os.path.isfile(args.github_record) else {"done": {}}
+    problems = []
+    numbers = {}
+    for e in changes.get("entries") or []:
+        made = (rec.get("done") or {}).get(f"{e['n']}-create")
+        numbers[e["n"]] = made["result"] if made else e.get("issue")
+    named = {str(numbers[e["n"]]) for e in changes.get("entries") or [] if numbers.get(e["n"]) is not None}
+    issues1 = snap1.get("issues") or {}
+
+    for e in changes.get("entries") or []:
+        n = numbers.get(e["n"])
+        if n is None:
+            continue
+        node, parent = node_parent(after, n, plan_id)
+        if node is None:
+            problems.append(f"#{n} (entry {e['n']}) is not in the plan file")
+            continue
+        now = issues1.get(str(n))
+        if now is None:
+            problems.append(f"#{n} was not read back from the tracker")
+            continue
+        status = node.get("status")
+        if status in ps.CLOSED:
+            want = ps.REASON_OF[ps.CLOSED[status]]
+            if now["state"] != "CLOSED" or now.get("state_reason") != want:
+                problems.append(f"#{n} is {status} in the plan file but {now['state'].lower()}"
+                                f" ({now.get('state_reason') or 'no reason'}) in the tracker")
+        elif now["state"] != "OPEN":
+            problems.append(f"#{n} is {status} in the plan file but closed in the tracker")
+        if now["title"] != node.get("title"):
+            problems.append(f"#{n}'s title differs: plan file '{node.get('title')}', tracker '{now['title']}'")
+        if e["op"] in ("add", "move", "new-feature") and str(now.get("parent")) != str(parent):
+            problems.append(f"#{n}'s parent is #{parent} in the plan file but #{now.get('parent')} in the tracker")
+        if e["op"] in ("add", "kind") and now.get("type") != ps.TYPES.get(node.get("kind")):
+            problems.append(f"#{n} is a {node.get('kind')} in the plan file but type {now.get('type')} in the tracker")
+        if e["op"] == "text" and now.get("body") != e.get("body"):
+            problems.append(f"#{n}'s text is not the approved text")
+
+    # Nothing else changed: the plan file.
+    before_nodes = {str(nd.get("issue")): nd for nd, _ in ps.walk(before.get("tree"))}
+    after_nodes = {str(nd.get("issue")): nd for nd, _ in ps.walk(after.get("tree"))}
+
+    def flat(nd):
+        return {k: v for k, v in nd.items() if k != "children"}
+
+    for issue, nd in before_nodes.items():
+        if issue in named:
+            continue
+        if issue not in after_nodes:
+            problems.append(f"#{issue} left the plan file, but the list does not name it")
+        elif flat(nd) != flat(after_nodes[issue]):
+            problems.append(f"#{issue} changed in the plan file, but the list does not name it")
+    for issue in after_nodes:
+        if issue not in before_nodes and issue not in named:
+            problems.append(f"#{issue} joined the plan file, but the list does not name it")
+    plan_ops = {e["op"] for e in changes.get("entries") or []}
+    for key in set(before) | set(after):
+        if key in ("tree", "updated"):
+            continue
+        if key == "status" and "plan-status" in plan_ops or key == "direction" and "plan-direction" in plan_ops:
+            continue
+        if before.get(key) != after.get(key):
+            problems.append(f"the plan's '{key}' changed, but the list does not name it")
+    # Nothing else changed: the tracker.
+    for issue, was in (snap0.get("issues") or {}).items():
+        if issue in named:
+            continue
+        now = issues1.get(issue)
+        keys = ("title", "state", "state_reason", "type", "body", "parent")
+        if now is not None and any(was.get(k) != now.get(k) for k in keys):
+            problems.append(f"#{issue} changed in the tracker, but the list does not name it")
+
+    features = [e for e in changes.get("entries") or [] if e["op"] == "new-feature"]
+    features_ok = True
+    if features:
+        model = ps.read_json(args.model_record, "the model record") if args.model_record else {}
+        spine = ps.yaml.safe_load(ps.read_text(args.spine)) if args.spine else {}
+        by_id = {f.get("id"): f for f in (spine or {}).get("features") or []}
+        for e in features:
+            f = by_id.get(e["feature"])
+            node, _ = ps.find(after, numbers.get(e["n"]))
+            page = os.path.join(os.path.dirname(args.spine), f["doc"]) if f and f.get("doc") else None
+            ok = (f is not None and (f.get("metadata") or {}).get("thin") is True
+                  and page and os.path.isfile(page)
+                  and any(ln.startswith(THIN_PREFIX) for ln in ps.read_text(page).splitlines())
+                  and str(f.get("issue")) == str(numbers.get(e["n"]))
+                  and node is not None and node.get("represents") == e["feature"]
+                  and e["feature"] in [p.get("feature") for p in model.get("parts") or []])
+            if not ok:
+                features_ok = False
+                problems.append(f"the new feature {e['feature']} is not whole: its page, its thin marks, "
+                                "its entry or its story is missing")
+    evals_unchanged = True
+    if args.evals_before and args.evals_after:
+        evals_unchanged = ps.read_json(args.evals_before, "evals before") == ps.read_json(args.evals_after, "evals after")
+        if not evals_unchanged:
+            problems.append("the evals folder changed")
+    return {"ok": not problems, "problems": problems, "features_ok": features_ok, "evals_unchanged": evals_unchanged,
+            "checked": sorted(int(i) for i in named)}
+
+
+def main(argv=None):
+    if argv is None:
+        argv = sys.argv[1:]
+    if argv and argv[0] == "hash-evals":
+        ap = argparse.ArgumentParser()
+        ap.add_argument("cmd")
+        ap.add_argument("--plans-dir", required=True)
+        ap.add_argument("--out", required=True)
+        a = ap.parse_args(argv)
+        ps.write_json(a.out, hash_evals(a.plans_dir))
+        return 0
+    ap = argparse.ArgumentParser(description="check the plan file, the tracker and the model agree")
+    for name in ("--changes", "--plan-before", "--plan-file", "--snapshot-before", "--snapshot-after",
+                 "--github-record", "--out"):
+        ap.add_argument(name, required=True)
+    for name in ("--model-record", "--spine", "--evals-before", "--evals-after"):
+        ap.add_argument(name)
+    args = ap.parse_args(argv)
+    try:
+        out = check(args)
+    except (ps.Refused, KeyError, TypeError) as e:
+        print(f"refused: {e}", file=sys.stderr)
+        return 2
+    ps.write_json(args.out, out)
+    return 0 if out["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/update-plan/scripts/check_entries.py b/core/components/plays/update-plan/scripts/check_entries.py
new file mode 100644
index 000000000..f54637914
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/check_entries.py
@@ -0,0 +1,290 @@
+#!/usr/bin/env python3
+"""check_entries.py — check each drafted entry against the plan's rules before it joins the list (C3, C4, C8).
+
+    python3 check_entries.py --draft <draft-entries.json> --plan-file <plans>/<id>.yaml \
+        --snapshot <snapshot.json> --changes <changes.yaml> --view-template <plan-view.md> \
+        --out <checked.json>
+
+For each entry of the draft (author-plan-changes) it fills in what the draft leaves out — the
+old value from the plan file and the tracker, the item's kind and parent — and decides, by fixed
+rules only:
+
+  - `problem` and `fix`: the entry breaks a rule, and what works instead. The rules: a kind the
+    plan may hold (epic, feature, story, spike, chore, bug); a parent of the right kind (an epic
+    at the top; a feature under an epic; a story under an epic or a feature; a spike, a chore or
+    a bug under a story); a status the plan knows; an item that is in the plan (or, for `add`,
+    is not); an issue the tracker has; no labels on an issue that joins the plan; a parent that
+    is not the item itself or under it; a title that is not empty; one story for each feature in
+    an epic. `fix` names up to three open items of a kind that works, near the parent asked for.
+  - `big` and `big_why`: dropping an epic, moving a feature, a new feature (a model change), or
+    closing an item with open work under it (work the list or the draft closes counts as closed). A big entry is shown and confirmed first.
+  - `already`: the entry changes nothing (the item already reads so); it is not added.
+  - `where`: what the landing will write — on GitHub (close as completed, close as not
+    planned, reopen, a new issue, parent, title, text, type) and in the model (thin page, index,
+    slice).
+An issue the snapshot does not hold is listed in `unknown_issues`: the play has it read and runs
+the check again. No status or direction is ever added that the draft does not name (no roll-ups).
+
+Output: {"entries": [...], "questions": [...], "unknown_issues": [...]}. `questions` holds the
+skill's questions and then place_feature.py's (`placement_questions`), each in the four parts of
+`_shared/asking-a-person.md`.
+Exit 0 written; 2 bad input (nothing written). No git, no network.
+"""
+
+import argparse
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_session as ps  # noqa: E402
+
+
+def a(kind):
+    return ("an " if kind and kind[0] in "aeiou" else "a ") + str(kind)
+
+
+def open_status(status):
+    return status not in ps.CLOSED
+
+
+def near(plan, parent_issue, kinds, skip, pending=None):
+    """Open items of the given kinds near the parent asked for: its own line, then its children."""
+    out = []
+    node, _ = ps.find(plan, parent_issue) if parent_issue is not None else (None, None)
+    pool = []
+    if node is not None:
+        chain, at = [], node
+        while at is not None:
+            chain.append(at)
+            at = ps.find(plan, at.get("issue"))[1]
+        pool = chain + ps.descendants(node)
+    else:
+        pool = [n for n, _ in ps.walk(plan.get("tree"))]
+    for n in pool:
+        status = (pending or {}).get(str(n.get("issue")), n.get("status"))
+        if n.get("kind") in kinds and open_status(status) and n.get("issue") not in skip:
+            if all(o["issue"] != n.get("issue") for o in out):
+                out.append({"issue": n.get("issue"), "title": n.get("title")})
+        if len(out) == 3:
+            break
+    return out
+
+
+def fix_text(cands, kinds):
+    if not cands:
+        return "put it under " + " or ".join(a(k) for k in kinds if k) if any(kinds) else "put it at the top"
+    return "put it under " + " or ".join(f"#{c['issue']} ({c['title']})" for c in cands)
+
+
+def check(entry, plan, snap, items, plan_statuses, directions, listed, pending):
+    e = dict(entry)
+    e.update({"problem": None, "fix": None, "big": False, "big_why": None, "already": False,
+              "status_now": "Not Started", "where": {"github": [], "model": []}})
+    op = e.get("op")
+    issues = snap.get("issues") or {}
+    unknown = []
+
+    def tracker(n):
+        if n is None:
+            return None
+        got = issues.get(str(n))
+        if got is None:
+            unknown.append(int(n))
+        return got
+
+    def broke(problem, fix=None):
+        if e["problem"] is None:
+            e["problem"], e["fix"] = problem, fix
+
+    def parent_rule(kind, parent_issue, skip=()):
+        allowed = ps.PARENTS.get(kind, ())
+        if parent_issue is None:
+            pkind = None
+        else:
+            pnode, _ = ps.find(plan, parent_issue)
+            pkind = pnode.get("kind") if pnode is not None else ("new" if str(parent_issue) in listed else None)
+            if pnode is None and pkind is None:
+                broke(f"#{parent_issue} is not in this plan", "name a parent that is in the plan")
+                return
+            if pkind == "new":
+                pkind = listed[str(parent_issue)]
+        if pkind not in allowed:
+            where = "at the top of the plan" if pkind is None else f"under {a(pkind)}"
+            want = " or ".join("the top of the plan" if k is None else a(k) for k in allowed)
+            broke(f"{a(kind)} does not sit {where}; it sits under {want}",
+                  fix_text(near(plan, parent_issue, [k for k in allowed if k], skip, pending), allowed))
+
+    if op in ("status", "move", "retitle", "text", "kind"):
+        node, parent = ps.find(plan, e.get("issue"))
+        if node is None:
+            broke(f"#{e.get('issue')} is not in this plan", "add it first, with its parent")
+            return e, unknown
+        e["title"], e["kind"], e["status_now"] = node.get("title"), node.get("kind"), node.get("status")
+        now = tracker(e["issue"])
+    if op == "status":
+        e["from"] = node.get("status")
+        if e.get("to") not in items:
+            broke(f"'{e.get('to')}' is not a status of an item", "use one of: " + ", ".join(items))
+        elif e["to"] == e["from"]:
+            e["already"] = True
+        else:
+            if e["to"] in ps.CLOSED:
+                want = ps.REASON_OF[ps.CLOSED[e["to"]]]
+                if not now or now["state"] != "CLOSED" or now.get("state_reason") != want:
+                    e["where"]["github"].append("close-completed" if e["to"] == "Done" else "close-not-planned")
+                open_under = [d for d in ps.descendants(node)
+                              if open_status(pending.get(str(d.get("issue")), d.get("status")))]
+                if node.get("kind") == "epic" and e["to"] == "Dropped":
+                    e["big"], e["big_why"] = True, "it drops an epic"
+                elif open_under:
+                    e["big"] = True
+                    e["big_why"] = "open work stays under it: " + ", ".join(f"#{d.get('issue')}" for d in open_under[:5])
+            elif now and now["state"] == "CLOSED":
+                e["where"]["github"].append("reopen")
+    elif op == "add":
+        kind = e.get("kind")
+        if kind not in ps.KINDS:
+            broke(f"'{kind}' is not a kind a plan holds", "use one of: " + ", ".join(ps.KINDS))
+        if e.get("issue") is not None:
+            if ps.find(plan, e["issue"])[0] is not None:
+                broke(f"#{e['issue']} is already in this plan", "move it instead")
+            now = tracker(e["issue"])
+            if now:
+                e["title"] = now["title"]
+                if now.get("labels"):
+                    broke(f"#{e['issue']} has labels ({', '.join(now['labels'])}); an item in a plan has none",
+                          "take the labels off first")
+                if now.get("type") != ps.TYPES.get(kind):
+                    e["where"]["github"].append("type")
+                if str(now.get("parent")) != str(e.get("parent")):
+                    e["where"]["github"].append("parent")
+        else:
+            if not (e.get("title") or "").strip():
+                broke("a new item needs a title", "give its title")
+            e["where"]["github"].append("create")
+        if kind in ps.KINDS:
+            parent_rule(kind, e.get("parent"))
+    elif op == "move":
+        e["from"] = parent.get("issue") if parent else None
+        to = e.get("to")
+        if str(to) == str(e["issue"]) or any(str(d.get("issue")) == str(to) for d in ps.descendants(node)):
+            broke(f"#{e['issue']} cannot sit under itself or under its own work", None)
+        elif str(to) == str(e["from"]):
+            e["already"] = True
+        else:
+            parent_rule(node.get("kind"), to, skip=(e["issue"],))
+            e["where"]["github"].append("parent")
+            if node.get("kind") == "feature":
+                e["big"], e["big_why"] = True, "it moves a feature to another place in the plan"
+    elif op == "retitle":
+        e["from"] = node.get("title")
+        if not (e.get("to") or "").strip():
+            broke("a title cannot be empty", "give the new title")
+        elif e["to"] == e["from"] and (not now or now["title"] == e["to"]):
+            e["already"] = True
+        else:
+            e["where"]["github"].append("title")
+    elif op == "text":
+        if not (e.get("body") or "").strip():
+            broke("the new text is empty", "give the new text")
+        elif now and now["body"] == e["body"]:
+            e["already"] = True
+        else:
+            e["where"]["github"].append("body")
+    elif op == "kind":
+        e["from"] = node.get("kind")
+        if e.get("to") not in ps.KINDS:
+            broke(f"'{e.get('to')}' is not a kind a plan holds", "use one of: " + ", ".join(ps.KINDS))
+        elif e["to"] == e["from"]:
+            e["already"] = True
+        else:
+            parent_rule(e["to"], parent.get("issue") if parent else None, skip=(e["issue"],))
+            for d in node.get("children") or []:
+                if e["to"] not in ps.PARENTS.get(d.get("kind"), ()):
+                    broke(f"#{d.get('issue')} ({a(d.get('kind'))}) could not sit under {a(e['to'])}", None)
+            e["where"]["github"].append("type")
+    elif op == "new-feature":
+        e["kind"] = "story"
+        e["big"], e["big_why"] = True, "it adds a feature to the product model"
+        if not (e.get("title") or "").strip():
+            broke("a new feature needs a title", "give its title")
+        if e.get("issue") is not None:
+            node, _ = ps.find(plan, e["issue"])
+            now = tracker(e["issue"])
+            if node is not None and node.get("represents"):
+                broke(f"#{e['issue']} already stands for {node.get('represents')}", None)
+            e["where"]["github"].append("body")
+            if node is None or (now and str(now.get("parent")) != str(e.get("parent"))):
+                e["where"]["github"].append("parent")
+        else:
+            e["where"]["github"].append("create")
+        parent_rule("story", e.get("parent"))
+        feature = e.get("feature")
+        epic = e.get("parent")
+        if feature and epic is not None:
+            pnode, _ = ps.find(plan, epic)
+            if pnode is not None and any(d.get("represents") == feature for d in ps.descendants(pnode)):
+                broke(f"{feature} already has a story under #{epic}; one story for each feature", None)
+        e["where"]["model"] = ["model-page", "model-index"] + (["model-slice"] if e.get("slice") else [])
+    elif op == "plan-status":
+        e["from"] = plan.get("status")
+        if e.get("to") not in plan_statuses:
+            broke(f"'{e.get('to')}' is not a status of a plan", "use one of: " + ", ".join(plan_statuses))
+        elif e["to"] == e["from"]:
+            e["already"] = True
+    elif op == "plan-direction":
+        e["from"] = plan.get("direction")
+        to = e.get("to")
+        if to is not None and to not in directions:
+            broke(f"'{to}' is not a direction", "use 1, 2, 3 or none")
+        elif to == e["from"]:
+            e["already"] = True
+    elif op not in ("status", "move", "retitle", "text", "kind"):
+        broke(f"'{op}' is not a change a session makes", None)
+    return e, unknown
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="check drafted entries against the plan's rules")
+    ap.add_argument("--draft", required=True)
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--snapshot", required=True)
+    ap.add_argument("--changes", required=True)
+    ap.add_argument("--view-template", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    try:
+        draft = ps.read_json(args.draft, "draft-entries.json")
+        plan = ps.load_plan(args.plan_file)
+        snap = ps.read_json(args.snapshot, "snapshot.json")
+        items, _, plan_statuses, directions = ps.statuses(ps.load_block(args.view_template, "plan-view"))
+        current = ps.load_list(args.changes) or {}
+    except ps.Refused as e:
+        print(f"refused: {e}", file=sys.stderr)
+        return 2
+    # Items the list already adds can be parents of later entries ("new" until they land).
+    listed = {}
+    for ent in current.get("entries") or []:
+        if ent.get("op") in ("add", "new-feature") and ent.get("issue") is not None:
+            listed[str(ent["issue"])] = ent.get("kind")
+        if ent.get("op") in ("add", "new-feature") and ent.get("issue") is None:
+            listed[f"@{ent.get('n')}"] = ent.get("kind")
+    # The statuses the list and this draft set: closing an item whose open work the same list
+    # closes is not "closing with open work under it".
+    pending = {}
+    for ent in (current.get("entries") or []) + (draft.get("entries") or []):
+        if ent.get("op") == "status" and ent.get("issue") is not None:
+            pending[str(ent["issue"])] = ent.get("to")
+    out, unknown = [], []
+    for entry in draft.get("entries") or []:
+        e, miss = check(entry, plan, snap, items, plan_statuses, directions, listed, pending)
+        out.append(e)
+        unknown += [m for m in miss if m not in unknown]
+    ps.write_json(args.out, {"instruction": draft.get("instruction"), "entries": out,
+                             "questions": (draft.get("questions") or []) + (draft.get("placement_questions") or []),
+                             "unknown_issues": unknown})
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/update-plan/scripts/check_stop_condition.py b/core/components/plays/update-plan/scripts/check_stop_condition.py
new file mode 100644
index 000000000..eeb7e8c4e
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/check_stop_condition.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""
+check_stop_condition.py — evaluate a play's baked stop condition (#464).
+
+A play ends because "done" was PROVEN, not because its step list ran out.
+The proof is this script: it reads the play's compiled stop-condition
+manifest (stop-condition.yaml, baked by create-play from the ICE's
+"### Done means" section) and evaluates every clause against what actually
+exists on disk at close. Pure assertions — it executes nothing, so the
+close gate stays instant and side-effect-free (implement's hand-built
+check_done.py pattern, made play-agnostic).
+
+Clause types (mechanical, closed set):
+    artifact_exists     {path}                       — glob ok, ≥1 match
+    field_equals        {file, field, equals}        — dot-path into JSON/YAML
+    gate_outcomes_pass  {file}                       — check-quality-gates output: ok == true
+
+Manifest shape (content.done is the clause list):
+    schema: {name: stop-condition}
+    content:
+      done:
+        - id: D1
+          says: "the commits exist and the tree is clean"   # human sentence
+          check: {type: artifact_exists, path: "...commits.yaml"}
+
+Usage:
+    python3 check_stop_condition.py --manifest <stop-condition.yaml> \
+        --base <run/STM root for relative paths> --out <verdict.yaml>
+
+Verdict: {stop_condition: held|unmet, clauses: [{id, says, status, detail}]}
+Exit 0 held, 1 unmet, 2 manifest/clause error (an unevaluable clause is an
+error, never a silent pass — the check-quality-gates rule, reused).
+"""
+
+import argparse
+import glob
+import json
+import os
+import sys
+
+try:
+    import yaml
+except ImportError:
+    print("PyYAML required: pip install pyyaml", file=sys.stderr)
+    sys.exit(2)
+
+
+def load_doc(path):
+    with open(path, "r", encoding="utf-8") as fh:
+        if path.endswith(".json"):
+            return json.load(fh)
+        return yaml.safe_load(fh)
+
+
+def dot_get(doc, field):
+    cur = doc
+    for part in field.split("."):
+        if isinstance(cur, list):
+            cur = cur[int(part)]
+        elif isinstance(cur, dict) and part in cur:
+            cur = cur[part]
+        else:
+            return None, False
+    return cur, True
+
+
+def eval_clause(clause, base):
+    check = clause.get("check") or {}
+    ctype = check.get("type")
+    try:
+        if ctype == "artifact_exists":
+            pattern = os.path.join(base, check["path"])
+            hits = glob.glob(pattern)
+            return ("held" if hits else "unmet",
+                    f"{len(hits)} match(es) for {check['path']}")
+        if ctype == "field_equals":
+            fpath = os.path.join(base, check["file"])
+            if not os.path.exists(fpath):
+                return "unmet", f"file missing: {check['file']}"
+            value, found = dot_get(load_doc(fpath), check["field"])
+            if not found:
+                return "unmet", f"field missing: {check['field']}"
+            ok = value == check["equals"]
+            return ("held" if ok else "unmet",
+                    f"{check['field']} = {value!r} (want {check['equals']!r})")
+        if ctype == "gate_outcomes_pass":
+            fpath = os.path.join(base, check["file"])
+            if not os.path.exists(fpath):
+                return "unmet", f"gate outcomes missing: {check['file']}"
+            doc = load_doc(fpath)
+            ok = bool(doc.get("ok"))
+            counts = doc.get("counts", {})
+            return ("held" if ok else "unmet", f"gates ok={ok} counts={counts}")
+        return "error", f"unknown check type: {ctype!r}"
+    except Exception as exc:  # noqa: BLE001 — an unevaluable clause is an error
+        return "error", f"clause evaluation failed: {exc}"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--manifest", required=True)
+    ap.add_argument("--base", required=True,
+                    help="root for the manifest's relative paths (the run's STM)")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    doc = load_doc(args.manifest) or {}
+    clauses = (doc.get("content") or {}).get("done") or []
+    if not clauses:
+        verdict = {"stop_condition": "error",
+                   "clauses": [],
+                   "detail": "manifest has no content.done clauses"}
+        code = 2
+    else:
+        results = []
+        for c in clauses:
+            status, detail = eval_clause(c, args.base)
+            results.append({"id": c.get("id"), "says": c.get("says"),
+                            "status": status, "detail": detail})
+        if any(r["status"] == "error" for r in results):
+            overall, code = "error", 2
+        elif all(r["status"] == "held" for r in results):
+            overall, code = "held", 0
+        else:
+            overall, code = "unmet", 1
+        verdict = {"stop_condition": overall, "clauses": results}
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    with open(args.out, "w", encoding="utf-8") as fh:
+        yaml.safe_dump(verdict, fh, sort_keys=False)
+    print(json.dumps(verdict, indent=2))
+    sys.exit(code)
+
+
+if __name__ == "__main__":
+    main()
