++        before = ps.load_plan(self.plan_file)
++        numbers = {}
++        for e in entries:
++            if e["op"] in ("add", "new-feature") and e.get("issue") is None:
++                numbers[e["n"]] = numbers[f"@{e['n']}"] = f"@{e['n']}"
++        after = wpc.data_apply(before, ch, numbers)
++        touched = set()
++        for e in entries:
