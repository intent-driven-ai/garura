++++class TrackChangesTest(unittest.TestCase):
++++    def setUp(self):
++++        self.tmp = tempfile.TemporaryDirectory()
++++        d = self.tmp.name
++++        self.tracker = os.path.join(d, "tracker.json")
++++        self.changes = os.path.join(d, "changes.yaml")
