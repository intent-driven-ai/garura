++            lines[p["children_line"]] = " " * (p["indent"] + 2) + "children: []"
++    d0 = node["indent"]
++
++    def shifted(d):
++        return [(" " * (d - d0) + ln) if d >= d0 else (ln[d0 - d:] if ln.startswith(" " * (d0 - d)) else ln)
++                for ln in block]
++    insert_under(lines, to, shifted)
