+++            elif o["op"] == "title":
+++                i["title"] = o["title"]
+++            elif o["op"] == "parent":
+++                i["parent"] = o["to"]
+++            done[o["id"]] = {"op": o["op"], "issue": o["issue"], "result": None, "how": "done"}
