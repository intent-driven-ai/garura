++        return 0
++    except (ps.Refused, KeyError, TypeError) as e:
++        print(f"refused: {e}", file=sys.stderr)
++        ps.write_json(args.out, {"ok": False, "path": args.plan_file, "error": str(e)})
++        return 2
++
++
++if __name__ == "__main__":
++    sys.exit(main())
