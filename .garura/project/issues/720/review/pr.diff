index 000000000..31c2fcda1
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/commit_plan.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""commit_plan.py — one commit on the plan's branch, pushed (C7).
+
+    python3 commit_plan.py --plan <id> --plan-branch plan/<id>/base --plan-file <plans>/<id>.yaml \
+        --changes <changes.yaml> [--model-record <model-record.json>] [--records-dir <stm>/<id>/] \
+        [--repo R] [--remote origin] --out <commit.json>
+
+It refuses (exit 2, nothing committed) unless the branch checked out is the plan's branch. It
+stages and commits only the plan file, the model files the model record names (`files`; each
+must be a path inside the repository) and, with
+--records-dir, the changed files in the plan's own short-term folder (the decision records the
+session's sub-agents wrote there, such as citations.jsonl), and commits them as one commit,
+pushed. The plan file keeps no history; this commit is the record. Its message:
+
+    chore(plan): plan <id> — update: <n> changes (#<id>)
+
+    Asked: <each instruction, as the person typed it>
+    Override: #<issue>: <the rule it breaks>        (one line each; none when there are none)
+    Owed: <what a new feature still needs>          (one line each)
+
+With nothing staged, it makes no commit. The record: {ok, commit, pushed, files, message,
+overrides_recorded}. Exit 0 done; 1 the push failed (the commit is kept and named); 2 refused.
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+import time
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_session as ps  # noqa: E402
+
+
+def git(args, repo, check=True):
+    for _ in range(8):
+        done = subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)
+        if done.returncode == 0 or "index.lock" not in done.stderr:
+            break
+        time.sleep(2)
+    if check and done.returncode != 0:
+        raise ps.Refused(f"git {' '.join(args)} failed: {(done.stderr or done.stdout).strip()}")
+    return done
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="one commit on the plan's branch, pushed")
+    ap.add_argument("--plan", required=True)
+    ap.add_argument("--plan-branch", required=True)
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--model-record")
+    ap.add_argument("--records-dir")
+    ap.add_argument("--repo", default=".")
+    ap.add_argument("--remote", default="origin")
+    ap.add_argument("--changes", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    rec = {"ok": False, "commit": None, "pushed": False, "files": []}
+    try:
+        changes = ps.load_list(args.changes) or {}
+        entries = changes.get("entries") or []
+        made = {}
+        gh = os.path.join(os.path.dirname(os.path.abspath(args.changes)), "github-record.json")
+        if os.path.isfile(gh):
+            made = {k: v.get("result") for k, v in (ps.read_json(gh, "the tracker record").get("done") or {}).items()}
+        lines = [f"chore(plan): plan {args.plan} — update: {len(entries)} changes (#{args.plan})", ""]
+        lines += [f"Asked: {a}" for a in changes.get("asked") or []]
+        overrides = []
+        for e in entries:
+            if e.get("override"):
+                n = made.get(f"{e['n']}-create") or e.get("issue")
+                overrides.append(f"Override: #{n}: {e['override']}")
+        lines += overrides + [f"Owed: {o}" for o in ps.owed_of(changes)]
+        rec["message"] = "\n".join(lines).rstrip() + "\n"
+        rec["overrides_recorded"] = len(overrides) == len([e for e in entries if e.get("override")])
+        on = git(["branch", "--show-current"], args.repo).stdout.strip()
+        if on != args.plan_branch:
+            raise ps.Refused(f"on {on}, not on the plan's branch {args.plan_branch}; nothing is committed")
+        root = os.path.realpath(args.repo)
+        files = [args.plan_file]
+        if args.model_record and os.path.isfile(args.model_record):
+            files += ps.read_json(args.model_record, "the model record").get("files") or []
+        for f in files:
+            full = os.path.realpath(os.path.join(root, f))
+            if os.path.isabs(f) or not full.startswith(root + os.sep):
+                raise ps.Refused(f"{f} is not a path inside the repository; nothing is committed")
+        if args.records_dir:
+            out = git(["status", "--porcelain", "-z", "--untracked-files=all", "--", args.records_dir],
+                      args.repo).stdout
+            entries, i = out.split("\0"), 0
+            while i < len(entries):
+                entry = entries[i]
+                i += 1
+                if len(entry) < 4:
+                    continue
+                if entry[0] in "RC":
+                    i += 1
+                files.append(entry[3:])
+        git(["add", "--", *files], args.repo)
+        if git(["diff", "--cached", "--quiet", "--", *files], args.repo, check=False).returncode == 0:
+            rec.update(ok=True, files=[])
+            ps.write_json(args.out, rec)
+            return 0
+        # Only the named files go into the commit, whatever else a person had staged.
+        git(["commit", "--quiet", "-m", rec["message"], "--", *files], args.repo)
+        rec["commit"] = git(["rev-parse", "HEAD"], args.repo).stdout.strip()
+        rec["files"] = files
+        remotes = git(["remote"], args.repo).stdout.split()
+        if args.remote in remotes:
+            if git(["push", "--quiet", args.remote, args.plan_branch], args.repo, check=False).returncode != 0:
+                ps.write_json(args.out, rec)
+                return 1
+            rec["pushed"] = True
+        rec["ok"] = True
+        ps.write_json(args.out, rec)
+        return 0
+    except ps.Refused as e:
+        rec["error"] = str(e)
+        ps.write_json(args.out, rec)
+        print(f"refused: {e}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/update-plan/scripts/find_plan.py b/core/components/plays/update-plan/scripts/find_plan.py
new file mode 100644
index 000000000..1139592e2
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/find_plan.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""find_plan.py — which plan the session is about, from a number or a description (C1).
+
+    python3 find_plan.py find    --args "<the play's arguments>" [--plans-dir D] --out <plan.json>
+    python3 find_plan.py confirm --out <plan.json>
+
+`find`:
+  - a number (`717` or `#717`) is used as given when its plan file exists: plan.json reads
+    `by: number, confirmed: true`;
+  - a description is matched against each plan's title (each shared word counts 2) and its
+    items' titles (each shared word counts 1; words of three letters or more, without the most
+    common ones). The one best plan is written with `by: description, confirmed: false`, the
+    words it matched on and where; the person confirms it, then `confirm` sets `confirmed: true`.
+  - no plan, a number with no plan file, or two plans with the same best score: exit 1, and
+    plan.json reads `plan: null` with up to three candidates. Nothing is guessed, and no plan
+    is made.
+Exit 0 one plan; 1 none or a tie; 2 bad input. Reads only the plan files.
+"""
+
+import argparse
+import glob
+import os
+import re
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_session as ps  # noqa: E402
+
+COMMON = {"the", "and", "for", "with", "that", "this", "plan", "one", "its", "from", "into", "are",
+          "can", "who", "what", "when", "they", "their", "them", "out", "has", "have", "not", "all",
+          "our", "you", "your", "helping", "helps", "about"}
+
+
+def words(text):
+    return {w for w in re.findall(r"[a-z0-9]+", (text or "").lower()) if len(w) >= 3 and w not in COMMON}
+
+
+def plans(plans_dir):
+    out = []
+    for path in sorted(glob.glob(os.path.join(plans_dir, "*.yaml"))):
+        if os.path.basename(path) == "index.yaml":
+            continue
+        plan = ps.load_plan(path)
+        out.append((str(plan.get("id", os.path.splitext(os.path.basename(path))[0])), plan))
+    return out
+
+
+def find(args):
+    raw = (args.args or "").strip()
+    num = re.fullmatch(r"#?(\d+)", raw)
+    every = plans(args.plans_dir)
+    by_id = dict(every)
+    if num:
+        pid = num.group(1)
+        if pid in by_id:
+            return 0, {"plan": pid, "title": by_id[pid].get("title"), "by": "number", "confirmed": True}
+        return 1, {"plan": None, "by": "number", "asked": raw, "candidates": []}
+    want = words(raw)
+    if not want:
+        return 1, {"plan": None, "by": "description", "asked": raw, "candidates": []}
+    scored = []
+    for pid, plan in every:
+        title_hit = want & words(plan.get("title"))
+        best_item, item_hit = None, set()
+        items = 0
+        for node, _ in ps.walk(plan.get("tree")):
+            hit = want & words(node.get("title"))
+            items += len(hit)
+            if len(hit) > len(item_hit):
+                best_item, item_hit = node, hit
+        score = 2 * len(title_hit) + items
+        if score:
+            where = "the plan's title" if len(title_hit) >= len(item_hit) or not best_item \
+                else f"#{best_item.get('issue')}"
+            scored.append((score, pid, plan, sorted(title_hit if where == "the plan's title" else item_hit), where))
+    scored.sort(key=lambda s: (-s[0], int(s[1]) if s[1].isdigit() else 0))
+    cands = [{"plan": s[1], "title": s[2].get("title"), "score": s[0]} for s in scored[:3]]
+    if not scored or (len(scored) > 1 and scored[0][0] == scored[1][0]):
+        return 1, {"plan": None, "by": "description", "asked": raw, "candidates": cands}
+    s = scored[0]
+    return 0, {"plan": s[1], "title": s[2].get("title"), "by": "description", "asked": raw,
+               "matched": " ".join(s[3]), "where": s[4], "confirmed": False, "candidates": cands}
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="find the plan of an /update-plan session")
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    f = sub.add_parser("find")
+    f.add_argument("--args", required=True)
+    f.add_argument("--plans-dir", default=os.path.join(".garura", "project", "plans"))
+    f.add_argument("--out", required=True)
+    c = sub.add_parser("confirm")
+    c.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    try:
+        if args.cmd == "confirm":
+            rec = ps.read_json(args.out, "plan.json")
+            if not rec.get("plan"):
+                raise ps.Refused("plan.json names no plan to confirm")
+            rec["confirmed"] = True
+            ps.write_json(args.out, rec)
+            return 0
+        code, rec = find(args)
+    except ps.Refused as e:
+        print(f"refused: {e}", file=sys.stderr)
+        return 2
+    ps.write_json(args.out, rec)
+    return code
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/update-plan/scripts/place_feature.py b/core/components/plays/update-plan/scripts/place_feature.py
new file mode 100644
index 000000000..955819cf2
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/place_feature.py
@@ -0,0 +1,158 @@
+#!/usr/bin/env python3
+"""place_feature.py — place each new feature of a draft by fixed rules (C11, C9).
+
+    python3 place_feature.py --draft <draft-entries.json> --plan-file <plans>/<id>.yaml \
+        --spine <product_base>product-os/_spine.yaml --plan <id> [--suggestion <routing-result.json>]
+
+For each `new-feature` entry of the draft it fills in, and writes back into the draft:
+  - `capability`: the one the entry names (the person said it) when it is in the spine; else the
+    spine capability whose `issue` is the issue of the entry's parent in the plan, or of an item
+    above it (a feature item and its capability share an issue number); else none — and a
+    question asks which capability, with the placement skill's suggestion when --suggestion
+    names one;
+  - `slice`: the spine slices whose `intents` hold `bi-<id>`: none → null (a slice is owed);
+    one → that slice, shown to the person at the confirm screen; several → none, and a question
+    names them;
+  - `slice_in_progress`: when that slice's epic is past ready (in_delivery, validated,
+    fix_required or delivered — the rule /shape-slice uses, ADR 058), each such epic with its
+    issue and status; the confirm screen says the slice is in progress and names the epic as out
+    of date (ADR 062). Else an empty list;
+  - `feature`: `fn-<issue>` when the story exists, else `fn-<slug of the title>`, never one the
+    spine has;
+  - `one_line`: the title, as the person gave it.
+No ICE is drafted here: the page skill writes the thin ICE at the landing, from the person's
+words. The script makes no judgment: what it cannot settle by a rule becomes a question for
+the person, in the four parts of `_shared/asking-a-person.md` (question, answer, why, examples).
+Its questions go in the draft's `placement_questions`, which it owns and replaces on every run,
+so a second run (with --suggestion) never repeats a question; the skill's own `questions` are
+left as they are. Exit 0 written; 2 bad input. Reads the plan file and the spine only.
+"""
+
+import argparse
+import os
+import re
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_session as ps  # noqa: E402
+
+
+def slug(text):
+    s = re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-")
+    return "-".join(s.split("-")[:6]) or "feature"
+
+
+def chain(plan, issue):
+    """The issue numbers from the item up to the top of the plan."""
+    out, current = [], issue
+    while current is not None:
+        node, parent = ps.find(plan, current)
+        if node is None:
+            break
+        out.append(str(node.get("issue")))
+        current = parent.get("issue") if parent else None
+    return out
+
+
+IN_PROGRESS = ("in_delivery", "validated", "fix_required", "delivered")  # past ready (ADR 058)
+
+EXAMPLES = ["a clinic: 'Send a reminder' goes under the capability that books visits",
+            "a shop: 'Save a wish list' goes under the capability that keeps a basket",
+            "a bank: 'Freeze a card' goes under the capability that manages cards"]
+
+
+def ask(question, answer, why):
+    return {"question": question, "answer": answer, "why": why, "examples": EXAMPLES}
+
+
+def place(entry, plan, spine, plan_id, suggestion):
+    questions = []
+    entry.setdefault("capability", None)
+    entry.setdefault("slice", None)
+    caps = {c.get("id"): c for c in spine.get("capabilities") or []}
+    by_issue = {str(c.get("issue")): c.get("id") for c in caps.values() if c.get("issue") is not None}
+    title = entry.get("title") or ""
+    named = entry.get("capability")
+    if named and named not in caps:
+        entry["capability"] = None
+    if not entry.get("capability"):
+        for issue in chain(plan, entry.get("parent")):
+            if issue in by_issue:
+                entry["capability"] = by_issue[issue]
+                break
+    if named and named not in caps:
+        found = f" Its parent in the plan points to {entry['capability']}." if entry["capability"] else ""
+        questions.append(ask(f"Which capability does the new feature '{title}' belong under?",
+                             f"'{named}' is not a capability in the model.{found}",
+                             "The feature's page is written under that capability, and the wrong one puts it "
+                             "where the people who use that part of the product will not look for it."))
+    elif not entry.get("capability"):
+        answer = (f"Proposed: {suggestion} (the placement skill's suggestion)." if suggestion
+                  else "No answer yet: its parent in the plan names no capability.")
+        questions.append(ask(f"Which capability does the new feature '{title}' belong under?", answer,
+                             "The feature's page is written under that capability, and nothing lands until "
+                             "it has one."))
+    intent = f"bi-{plan_id}"
+    slices = [s.get("id") for s in spine.get("slices") or [] if intent in (s.get("intents") or [])]
+    if entry.get("slice") and entry["slice"] not in slices:
+        entry["slice"] = None
+    if not entry.get("slice"):
+        if len(slices) == 1:
+            entry["slice"] = slices[0]
+        elif len(slices) > 1:
+            questions.append(ask(f"Which slice does the new feature '{title}' join?",
+                                 "No answer yet: these slices serve the plan's business intent: "
+                                 + ", ".join(slices) + ".",
+                                 "The feature is built and tested with that slice; in the wrong one its "
+                                 "tester never reaches it."))
+    entry["slice_in_progress"] = [
+        {"epic": e.get("issue_ref") or e.get("id"), "status": e.get("status")}
+        for e in spine.get("epics") or []
+        if isinstance(e, dict) and entry.get("slice") and e.get("slice_ref") == entry["slice"]
+        and e.get("status") in IN_PROGRESS]
+    taken = {f.get("id") for f in spine.get("features") or []}
+    feature = f"fn-{entry['issue']}" if entry.get("issue") is not None else f"fn-{slug(title)}"
+    base, n = feature, 2
+    while feature in taken:
+        feature = f"{base}-{n}"
+        n += 1
+    entry["feature"] = feature
+    entry["one_line"] = entry.get("one_line") or title
+    entry.pop("ice", None)
+    return questions
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="place each new feature of a draft by fixed rules")
+    ap.add_argument("--draft", required=True)
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--spine", required=True)
+    ap.add_argument("--plan", required=True)
+    ap.add_argument("--suggestion")
+    args = ap.parse_args(argv)
+    try:
+        draft = ps.read_json(args.draft, "draft-entries.json")
+        plan = ps.load_plan(args.plan_file)
+        if not os.path.isfile(args.spine):
+            raise ps.Refused(f"no model index at {args.spine}")
+        spine = ps.yaml.safe_load(ps.read_text(args.spine)) or {}
+        suggestion = None
+        if args.suggestion and os.path.isfile(args.suggestion):
+            route = ps.read_json(args.suggestion, "routing-result.json")
+            route = route.get("routing_result", route)
+            best = (route.get("placements") or [{}])[0]
+            suggestion = best.get("capability")
+    except (ps.Refused, ps.yaml.YAMLError) as e:
+        print(f"refused: {e}", file=sys.stderr)
+        return 2
+    asked = []
+    for entry in draft.get("entries") or []:
+        if entry.get("op") == "new-feature":
+            asked += place(entry, plan, spine, args.plan, suggestion)
+    draft["placement_questions"] = asked
+    ps.write_json(args.draft, draft)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/update-plan/scripts/plan_ops.py b/core/components/plays/update-plan/scripts/plan_ops.py
new file mode 100644
index 000000000..f6da43696
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/plan_ops.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""plan_ops.py — turn the approved list into the tracker writes and the model parts (C6, C7, C11).
+
+    python3 plan_ops.py --changes <changes.yaml> --plan-file <plans>/<id>.yaml \
+        --snapshot <snapshot.json> --out-github <github-ops.json> --out-model <model-ops.json>
+
+A fixed rule for each entry, in the list's order (n):
+
+  status Done / Dropped   close as completed / as not planned (when the tracker does not read so)
+  status, from Done or Dropped to an open status        reopen (when the tracker reads closed)
+  add (an issue that exists)   parent (to its plan parent), type (to its kind's type), when they differ
+  add (a new issue)            create: title, text, the kind's type, the plan parent
+  move                         parent
+  retitle                      title
+  text                         body
+  kind                         type
+  new-feature                  create the story (or, for a story that exists, body + parent), and one
+                               model part in model-ops.json
+  plan-status, plan-direction  nothing in the tracker (the plan file only)
+
+An item at the top of the plan (an epic) has the plan's business intent as its parent in the
+tracker. A parent that is a new item of the list is written "@<n>-create", the id of the op that
+makes it. Every op carries `entry` (its n). Exit 0 written; 2 bad input. No git, no network.
+"""
+
+import argparse
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_session as ps  # noqa: E402
+
+REPRESENTS = "Represents: {feature}"
+
+
+def parent_ref(value, plan_id, new_ids):
+    if value is None:
+        return int(plan_id)
+    if isinstance(value, str) and value.startswith("@"):
+        return new_ids[value]
+    return int(value)
+
+
+def story_body(entry, plan_id):
+    lines = [entry.get("body") or entry.get("description") or "", "",
+             REPRESENTS.format(feature=entry["feature"]), f"Plan: {plan_id}"]
+    return "\n".join(lines).strip() + "\n"
+
+
+def build(changes, plan, snap):
+    plan_id = str(changes.get("plan") or plan.get("id"))
+    issues = snap.get("issues") or {}
+    gh, model = [], []
+    new_ids = {}
+    for e in changes.get("entries") or []:
+        n, op = e["n"], e["op"]
+        now = issues.get(str(e.get("issue"))) if e.get("issue") is not None else None
+
+        def add(kind, **kw):
+            gh.append({"id": f"{n}-{kind}", "entry": n, "op": kind, **kw})
+
+        if op == "status":
+            to = e["to"]
+            if to in ps.CLOSED:
+                reason = ps.CLOSED[to]
+                if not now or now["state"] != "CLOSED" or now.get("state_reason") != ps.REASON_OF[reason]:
+                    add("close", issue=e["issue"], reason=reason)
+            elif now and now["state"] == "CLOSED":
+                add("reopen", issue=e["issue"])
+        elif op == "add":
+            parent = parent_ref(e.get("parent"), plan_id, new_ids)
+            if e.get("issue") is None:
+                add("create", title=e["title"], body=e.get("body") or "", type=ps.TYPES[e["kind"]], parent=parent)
+                new_ids[f"@{n}"] = f"@{n}-create"
+            else:
+                if not now or now.get("type") != ps.TYPES[e["kind"]]:
+                    add("type", issue=e["issue"], type=ps.TYPES[e["kind"]])
+                if not now or str(now.get("parent")) != str(parent):
+                    add("parent", issue=e["issue"], to=parent, **{"from": now.get("parent") if now else None})
+        elif op == "move":
+            add("parent", issue=e["issue"], to=parent_ref(e["to"], plan_id, new_ids), **{"from": e.get("from")})
+        elif op == "retitle":
+            add("title", issue=e["issue"], title=e["to"])
+        elif op == "text":
+            add("body", issue=e["issue"], body=e["body"])
+        elif op == "kind":
+            add("type", issue=e["issue"], type=ps.TYPES[e["to"]])
+        elif op == "new-feature":
+            parent = parent_ref(e.get("parent"), plan_id, new_ids)
+            if e.get("issue") is None:
+                add("create", title=e["title"], body=story_body(e, plan_id), type="Story", parent=parent)
+                story = f"@{n}-create"
+                new_ids[f"@{n}"] = story
+            else:
+                body = (now or {}).get("body") or ""
+                line = REPRESENTS.format(feature=e["feature"])
+                if line not in body:
+                    add("body", issue=e["issue"], body=body.rstrip("\n") + "\n\n" + line + "\n")
+                if not now or str(now.get("parent")) != str(parent):
+                    add("parent", issue=e["issue"], to=parent, **{"from": now.get("parent") if now else None})
+                story = e["issue"]
+            model.append({"entry": n, "feature": e["feature"], "title": e["title"],
+                          "capability": e.get("capability"), "slice": e.get("slice"),
+                          "intent": f"bi-{plan_id}", "story": story, "identified_by": e.get("identified_by"),
+                          "one_line": e.get("one_line") or e["title"], "ice": e.get("ice") or {},
+                          "description": e.get("description")})
+    return gh, model
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="the tracker writes and model parts of the approved list")
+    ap.add_argument("--changes", required=True)
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--snapshot", required=True)
+    ap.add_argument("--out-github", required=True)
+    ap.add_argument("--out-model", required=True)
+    args = ap.parse_args(argv)
+    try:
+        changes = ps.load_list(args.changes)
+        if not changes:
+            raise ps.Refused("there is no list")
+        plan = ps.load_plan(args.plan_file)
+        snap = ps.read_json(args.snapshot, "snapshot.json")
+        gh, model = build(changes, plan, snap)
+    except (ps.Refused, KeyError) as e:
+        print(f"refused: {e}", file=sys.stderr)
+        return 2
+    ps.write_json(args.out_github, {"plan": changes.get("plan"), "ops": gh})
+    ps.write_json(args.out_model, {"plan": changes.get("plan"), "parts": model})
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/update-plan/scripts/plan_session.py b/core/components/plays/update-plan/scripts/plan_session.py
