index 000000000..f6da43696
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/plan_ops.py
@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""plan_ops.py — turn the approved list into the tracker writes and the model parts (C6, C7, C11).
+
+    python3 plan_ops.py --changes <changes.yaml> --plan-file <plans>/<id>.yaml \
+        --snapshot <snapshot.json> --out-github <github-ops.json> --out-model <model-ops.json>
+
+A fixed rule for each entry, in the list's order (n):
+
+  status Done / Dropped   close as completed / as not planned (when the tracker does not read so)
+  status, from Done or Dropped to an open status        reopen (when the tracker reads closed)
+  add (an issue that exists)   parent (to its plan parent), type (to its kind's type), when they differ
+  add (a new issue)            create: title, text, the kind's type, the plan parent
+  move                         parent
+  retitle                      title
+  text                         body
+  kind                         type
+  new-feature                  create the story (or, for a story that exists, body + parent), and one
+                               model part in model-ops.json
+  plan-status, plan-direction  nothing in the tracker (the plan file only)
+
+An item at the top of the plan (an epic) has the plan's business intent as its parent in the
+tracker. A parent that is a new item of the list is written "@<n>-create", the id of the op that
+makes it. Every op carries `entry` (its n). Exit 0 written; 2 bad input. No git, no network.
+"""
+
+import argparse
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_session as ps  # noqa: E402
+
+REPRESENTS = "Represents: {feature}"
+
+
+def parent_ref(value, plan_id, new_ids):
+    if value is None:
+        return int(plan_id)
+    if isinstance(value, str) and value.startswith("@"):
+        return new_ids[value]
+    return int(value)
+
+
+def story_body(entry, plan_id):
+    lines = [entry.get("body") or entry.get("description") or "", "",
+             REPRESENTS.format(feature=entry["feature"]), f"Plan: {plan_id}"]
+    return "\n".join(lines).strip() + "\n"
+
+
+def build(changes, plan, snap):
+    plan_id = str(changes.get("plan") or plan.get("id"))
+    issues = snap.get("issues") or {}
+    gh, model = [], []
+    new_ids = {}
+    for e in changes.get("entries") or []:
+        n, op = e["n"], e["op"]
+        now = issues.get(str(e.get("issue"))) if e.get("issue") is not None else None
+
+        def add(kind, **kw):
+            gh.append({"id": f"{n}-{kind}", "entry": n, "op": kind, **kw})
+
+        if op == "status":
+            to = e["to"]
+            if to in ps.CLOSED:
+                reason = ps.CLOSED[to]
+                if not now or now["state"] != "CLOSED" or now.get("state_reason") != ps.REASON_OF[reason]:
+                    add("close", issue=e["issue"], reason=reason)
+            elif now and now["state"] == "CLOSED":
+                add("reopen", issue=e["issue"])
+        elif op == "add":
+            parent = parent_ref(e.get("parent"), plan_id, new_ids)
+            if e.get("issue") is None:
+                add("create", title=e["title"], body=e.get("body") or "", type=ps.TYPES[e["kind"]], parent=parent)
+                new_ids[f"@{n}"] = f"@{n}-create"
+            else:
+                if not now or now.get("type") != ps.TYPES[e["kind"]]:
+                    add("type", issue=e["issue"], type=ps.TYPES[e["kind"]])
+                if not now or str(now.get("parent")) != str(parent):
+                    add("parent", issue=e["issue"], to=parent, **{"from": now.get("parent") if now else None})
+        elif op == "move":
+            add("parent", issue=e["issue"], to=parent_ref(e["to"], plan_id, new_ids), **{"from": e.get("from")})
+        elif op == "retitle":
+            add("title", issue=e["issue"], title=e["to"])
+        elif op == "text":
+            add("body", issue=e["issue"], body=e["body"])
+        elif op == "kind":
+            add("type", issue=e["issue"], type=ps.TYPES[e["to"]])
+        elif op == "new-feature":
+            parent = parent_ref(e.get("parent"), plan_id, new_ids)
+            if e.get("issue") is None:
+                add("create", title=e["title"], body=story_body(e, plan_id), type="Story", parent=parent)
+                story = f"@{n}-create"
+                new_ids[f"@{n}"] = story
+            else:
+                body = (now or {}).get("body") or ""
+                line = REPRESENTS.format(feature=e["feature"])
+                if line not in body:
+                    add("body", issue=e["issue"], body=body.rstrip("\n") + "\n\n" + line + "\n")
+                if not now or str(now.get("parent")) != str(parent):
+                    add("parent", issue=e["issue"], to=parent, **{"from": now.get("parent") if now else None})
+                story = e["issue"]
+            model.append({"entry": n, "feature": e["feature"], "title": e["title"],
+                          "capability": e.get("capability"), "slice": e.get("slice"),
+                          "intent": f"bi-{plan_id}", "story": story, "identified_by": e.get("identified_by"),
+                          "one_line": e.get("one_line") or e["title"], "ice": e.get("ice") or {},
+                          "description": e.get("description")})
+    return gh, model
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="the tracker writes and model parts of the approved list")
+    ap.add_argument("--changes", required=True)
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--snapshot", required=True)
+    ap.add_argument("--out-github", required=True)
+    ap.add_argument("--out-model", required=True)
+    args = ap.parse_args(argv)
+    try:
+        changes = ps.load_list(args.changes)
+        if not changes:
+            raise ps.Refused("there is no list")
+        plan = ps.load_plan(args.plan_file)
+        snap = ps.read_json(args.snapshot, "snapshot.json")
+        gh, model = build(changes, plan, snap)
+    except (ps.Refused, KeyError) as e:
+        print(f"refused: {e}", file=sys.stderr)
+        return 2
+    ps.write_json(args.out_github, {"plan": changes.get("plan"), "ops": gh})
+    ps.write_json(args.out_model, {"plan": changes.get("plan"), "parts": model})
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/update-plan/scripts/plan_session.py b/core/components/plays/update-plan/scripts/plan_session.py
new file mode 100644
index 000000000..c3d2c6c86
--- /dev/null
+++ b/core/components/plays/update-plan/scripts/plan_session.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""plan_session.py — the parts the /update-plan scripts share (#730).
+
+Not run on its own. The scripts beside it import it for:
+
+  - the plan's rules: the item kinds a plan may hold, the parent each kind may sit under, the
+    tracker type of each kind, the item statuses and plan statuses (from the plan-view template);
+  - reading a plan file and walking its tree (`load_plan`, `walk`, `find`, `parent_of`,
+    `descendants`);
+  - the two templates' settings blocks (`load_block`);
+  - safe writes (`write_json`, `write_text`: a temp file, then a move) and `sha256_of`;
+  - the session's list (`load_list`, `save_list`), kept in changes.yaml.
+No git, no network, no judgment.
+"""
+
+import hashlib
+import json
+import os
+import re
+
+import yaml
+
+# The item kinds a plan may hold (#917), and where each may sit. None is the plan itself.
+KINDS = ("epic", "feature", "story", "spike", "chore", "bug")
+PARENTS = {
+    "epic": (None,),
+    "feature": ("epic",),
+    "story": ("epic", "feature"),
+    "spike": ("story",),
+    "chore": ("story",),
+    "bug": ("story",),
+}
+TYPES = {"epic": "Epic", "feature": "Feature", "story": "Story", "spike": "Spike",
+         "chore": "Chore", "bug": "Bug"}
+CLOSED = {"Done": "completed", "Dropped": "not planned"}
+REASON_OF = {"completed": "COMPLETED", "not planned": "NOT_PLANNED"}
+
+
+class Refused(Exception):
+    pass
+
+
+def load_block(path, name):
+    """The settings block that opens with ```yaml <name> in a template."""
+    try:
+        with open(path, encoding="utf-8") as fh:
+            text = fh.read()
+    except OSError as e:
+        raise Refused(f"cannot read the template {path}: {e.strerror}")
+    m = re.search(rf"^```yaml {re.escape(name)}\s*\n(.*?)^```", text, re.S | re.M)
+    if not m:
+        raise Refused(f"{path} has no ```yaml {name} block")
+    return yaml.safe_load(m.group(1)) or {}
+
+
+def statuses(view):
+    """(item statuses in order, {name: mark}, plan statuses, directions) from plan-view."""
+    items = [s["name"] for s in view["statuses"]]
+    marks = {s["name"]: s["mark"] for s in view["statuses"]}
+    return items, marks, list(view["list"]["plan_statuses"]), dict(view["list"]["directions"])
+
+
+def read_text(path):
+    with open(path, encoding="utf-8", newline="") as fh:
+        return fh.read()
+
+
+def load_plan(path):
+    try:
+        data = yaml.safe_load(read_text(path)) or {}
+    except (OSError, yaml.YAMLError) as e:
+        raise Refused(f"cannot read the plan file {path}: {e}")
+    if not isinstance(data, dict) or "tree" not in data:
+        raise Refused(f"{path} is not a plan file (no tree)")
+    return data
+
+
+def walk(nodes, parent=None):
+    """Each node with its parent node (None at the top)."""
+    for n in nodes or []:
+        yield n, parent
+        yield from walk(n.get("children"), n)
+
+
+def find(plan, issue):
+    for n, p in walk(plan.get("tree")):
+        if str(n.get("issue")) == str(issue):
+            return n, p
+    return None, None
+
+
+def descendants(node):
+    return [n for n, _ in walk(node.get("children"))]
+
+
+def sha256_of(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as fh:
+        h.update(fh.read())
+    return h.hexdigest()
+
+
+def write_text(path, text):
+    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
+    tmp = path + ".tmp"
+    with open(tmp, "w", encoding="utf-8", newline="") as fh:
+        fh.write(text)
+    os.replace(tmp, path)
+
+
+def write_json(path, data):
+    write_text(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
+
+
+def read_json(path, what):
+    try:
+        with open(path, encoding="utf-8") as fh:
+            return json.load(fh)
+    except (OSError, ValueError) as e:
+        raise Refused(f"cannot read {what} ({path}): {e}")
+
+
+def load_list(path):
+    if not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8") as fh:
+        return yaml.safe_load(fh) or {}
+
+
+def save_list(path, data):
+    write_text(path, yaml.safe_dump(data, sort_keys=False, allow_unicode=True, width=10 ** 9))
+
+
+def owed_of(changes):
+    """What the landing leaves owed, for each new feature: its slice or its hidden-file entry
+    (/shape-slice), and its eval scenarios (/shape-eval). The play never writes the evals folder."""
+    owed = []
+    for e in changes.get("entries") or []:
+        if e.get("op") != "new-feature":
+            continue
+        title = e.get("title")
+        if e.get("slice"):
+            owed.append(f"the hidden-file entry for '{title}' (/shape-slice)")
+        else:
+            owed.append(f"a slice for '{title}' (/shape-slice)")
+        owed.append(f"eval scenarios for '{title}' (/shape-eval)")
+    return owed
