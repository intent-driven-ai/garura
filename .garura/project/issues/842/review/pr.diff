+    for q in asked:
+        lines += question_block(q)
+    lines += ["## Your reply", "",
+              "Type **yes**, **change: <what>**, or **stop**. Answer any question by its id in the "
+              "same reply (for example `Q-scope-1: ...`). A plain yes accepts each proposed answer.",
+              ""]
