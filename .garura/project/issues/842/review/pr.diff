++def write(path, data):
++    os.makedirs(os.path.dirname(path), exist_ok=True)
++    with open(path, "w", encoding="utf-8") as fh:
++        if isinstance(data, str):
++            fh.write(data)
++        elif path.endswith(".json"):
++            json.dump(data, fh)
++        else:
++            yaml.safe_dump(data, fh, sort_keys=False)
++    return path
