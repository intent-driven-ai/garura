+    except (Missing, OSError, json.JSONDecodeError, yaml.YAMLError) as exc:
+        sys.stderr.write(f"render_brief.py: not written — {exc}\n")
+        return 2
+    atomic_write(args.out, text)
+    print(json.dumps({"ok": True, "out": args.out}, indent=2))
+    return 0
