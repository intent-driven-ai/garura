+            fh.write(json.dumps({"citation_id": "cite-20261018-001", "issue": 7, "play": None, "question": "q",
+                                 "answer": "a", "decided_by": "someone", "decided_at": "2026-10-18T00:00:00Z",
+                                 "trace": [], "from_update": None}) + "\n")
