+  intents:
+  - bi-1
+  status: proposed
+  one_line: Moves with the merge
+  doc: features/fn-1/feature.md
+  depends_on: []
+  identified_by: ''
+  issue: 11
+- id: fn-2
+  slug: fn-2
+  capability: cap-3
+  intents:
+  - bi-2
+  status: proposed
+  one_line: Repointed
+  doc: features/fn-2/feature.md
+  depends_on: []
