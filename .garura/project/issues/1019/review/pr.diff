+  identified_by: cap-1
+  decisions:
+  - dec-2
+  issue: 22
+  nfr_needs:
+    performance:
+      level: high
+  compliance_needs:
+  - gdpr
+- id: cap-3
+  slug: cap-3
+  domain: dom-1
+  intents:
+  - bi-2
+  status: proposed
+  one_line: File mail
+  doc: capabilities/cap-3/capability.md
+  depends_on:
+  - cap-2
