+# categories.yaml — work categories present in PR #1020 (issue #1019), derived from the diff.
+# Written by change-reviewer (assessment). Each treatment is copied from the playbook in short-term
+# memory (.garura/project/issues/1019/context/memory/knowledge/review/), never from prior knowledge.
+# A category with no changed file is absent. Paths are relative to the repo root.
+pr: 1020
+issue: 1019
+base: main
+memory_copied:
+  review_shelf: .garura/project/issues/1019/context/memory/knowledge/review/
+  severity_taxonomy: .garura/project/issues/1019/context/memory/standards/rules/pr.md
+  manifest: .garura/project/issues/1019/context/memory/manifest.json
+  tier: phoenix   # no short-term or Garura copy answered; the memory tool answered from Phoenix memory
+  note: >
+    Copied through the memory tool (find, then read piped to copy_memory.py): the eight files of
+    knowledge/review/ (_index plus seven playbooks) and standards/rules/pr.md.
+
+design_bearing: [harness, memory]   # the Layer 2 fan-out: one grounding dispatch for each
+
+categories:
+
+  - category: harness
+    design_bearing: true
+    playbook: review/harness
+    evidence:
+      - core/components/skills/author-intent-page/SKILL.md
+      - core/components/skills/remove-model-part/SKILL.md
+      - core/components/skills/remove-plan/SKILL.md
+      - core/components/agents/product-os-keeper.md
+      - core/components/agents/project-orchestrator.md
+    why: >
+      Three new skill definitions (SKILL.md) and two agent definitions that add the new skills to
+      their tables, routing rows, memory needs and "never" rules. These files are the system's
+      behaviour: the play to agent to skill to script wiring. The skills' own scripts are listed
+      under "code" and also belong to this wiring, so Layer 2 should read them as the skill's
+      script contract.
+    treatment:
+      reviewer: human (the design) + tool (conformance)
+      layers: [1, 2]
+      linters:
