+  metadata:
+    created_by: /test
+# A comment above the second capability, that must stay.
+- id: cap-2
+  slug: cap-2
+  domain: dom-1
+  intents:
+  - bi-1
+  - bi-2
+  status: proposed
+  one_line: Read mail
+  doc: capabilities/cap-2/capability.md
+  depends_on:
