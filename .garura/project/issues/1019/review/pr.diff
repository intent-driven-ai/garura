+
+import yaml
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SCRIPT = os.path.join(HERE, "remove_part.py")
+sys.path.insert(0, HERE)
+import remove_part  # noqa: E402
+
+SPINE = """\
