++KINDS = {"domain": "domains", "capability": "capabilities", "feature": "features", "slice": "slices"}
++SINGULAR = {key: kind for kind, key in KINDS.items()}
++REMOVABLE = ("intent", "capability", "slice")
++INTENT_ID = re.compile(r"[a-z0-9][a-z0-9-]*")
