+# Product-OS Spine Schema — v2
+#
+# The SPINE is the single structured map of the product model. You read it FIRST —
+# one read tells you the whole tree, every entry's id/slug/status, the refs that connect
+# everything, the profile, and for every entry a one-line descriptor plus a pointer to
+# its grounding doc. You open a grounding doc (domain.md /
+# capability.md / feature.md / epic.md) ONLY when you need to understand that
+# one node. Work runs on the spine; grounding is read on demand, one node at a time —
+# nobody reads all the Markdown to navigate or to do a play's job.
+#
+# This is the layer split that fixes the "files hold nothing" problem WITHOUT making
+# traversal expensive:
+#   - SPINE  (this schema, structured)  → structure + connection. Cheap to read whole.
+#   - GROUNDING (Markdown, linted + eval-gated) → meaning. Rich. Read per node.
+#
+# Supersedes the per-node `node.yaml` structural role: the tree's structural fields
+# now live as entries in the spine, not as a file in every folder. Also retires
+# `ice_ref` and the standalone ICE record — ICE content is now written INLINE in the
+# grounding docs: since ontology v4, a capability's or feature's ICE sits in its
+# page's last section, `## Agent intent (ICE)`; an epic carries its full
+# intent/constraints/failures/expectations/context. See the grounding templates under
+# `schemas/product-os/grounding/`.
+
+schema:
+  name: product-os-spine
+  version: 2
+  persistence: permanent
+
+# ---- Where the spine lives --------------------------------------------------
+# One spine file per product, at the product-os root:
+#   product-os/_spine.yaml
+# It MAY shard per domain if a product grows large (product-os/{domain}/_spine.yaml
+# with a root index) — single-file is the default and the starting shape.
+
+# ---- The tree: domain -> capability -> feature ------------------------
+# Three FIRST-CLASS collections, one per level — the taxonomy IS the structure, there is
+# no generic "node". Each entry carries only its level's structure; its meaning lives in
+# the grounding doc named by `doc`. The parent is named by its real relation: a
+# capability names its `domain`, a feature names its `capability`. The kind is
+# implied by the collection, so there is no `type` field.
+
+domains:
+  - id: string            # opaque, stable — never changes once assigned
+    slug: string          # human slug (the path is derived from slugs)
+    status: string        # proposed | active | deprecated
+    detail: string        # directional (a light page, e.g. from /discover-intent) | detailed (the
+                          # full page, /discover-domains) — drives which domain.md shape the linter
+                          # requires; absent → read from the page's headings
+    one_line: string      # the descriptor — what this domain is, readable WITHOUT opening
+                          # the doc. One sentence. This is what makes the spine browsable.
+    doc: string           # pointer to its domain.md, relative to product-os root.
+                          # The linter checks it exists and reads as a Theme doc.
+    intents: [string]     # the BUSINESS INTENT ids that touch this domain (as on capabilities
+                          # and features). A domain carries no ICE of its own; the
+                          # link says which intents reach into it. How each intent touches it
+                          # (adds / changes / removes) is on the intent page's Touches list.
+    decisions: [string]   # decision (ADR) record ids affecting this domain
+    metadata:
+      created_by: string
+      updated_by: string
+      version: integer
+
+capabilities:
+  - id: string
+    slug: string
+    domain: string        # parent DOMAIN id — the named relation, not "parent". May be empty
+                          # while proposed: a capability can be written before its domain
+                          # is known (e.g. by /discover-intent, when it cannot tell one); /discover-domains
+                          # attaches the domain later.
+    intents: [string]     # the BUSINESS INTENT ids (product-os/intents/<id>.md) this
+                          # capability's ICE is built from. Its ICE is workable only when at
+                          # least one of them is confirmed; with none, the ICE is kept but no
+                          # play works on it (ontology v3).
+    status: string        # proposed | active | deprecated
+    detail: string        # directional (/discover-intent or /discover-domains) | detailed (/discover-capabilities) — drives which
+                          # capability.md shape the linter requires
+    one_line: string
+    doc: string           # pointer to its capability.md
+    nfr_needs:            # THIS capability's own NFR targets (set by /discover-capabilities) —
+                          # per-capability, because one capability's need (e.g. uptime)
+                          # can differ from another's. Each dimension carries a `level`
+                          # (none<low<medium<high<xhigh — the roll-up input) plus a
+                          # concrete `target` and `gate`. These roll up MONOTONIC-UP
+                          # (max per dimension across all capabilities) into profile.nfr;
+                          # only the dimensions this capability actually constrains appear.
+      performance:    { level: string, target: string, gate: string }   # e.g. high, "p99 < 150ms", "load test"
+      security:       { level: string, target: string, gate: string }
+      reliability:    { level: string, target: string, gate: string }   # e.g. uptime
+      # ... any of the profile dimensions; omit those this capability does not constrain
+    compliance_needs: [string]   # regimes THIS capability triggers; union'd into profile.compliance
+    depends_on: [string]  # "needs" (ontology v5): ids of OTHER capabilities or features this
+                          # one needs done first. Field renamed to `needs` under #725.
+    identified_by: string # the capability or feature that led us to find this one; empty
+                          # when it was found on its own (ontology v5)
+    decisions: [string]
+    personas: [string]    # persona record ids attached to this capability
+    journeys: [string]    # journey record ids attached to this capability
+    metadata:
+      created_by: string
+      updated_by: string
+      version: integer
+
+features:
+  - id: string
+    slug: string
+    capability: string    # parent CAPABILITY id — the named relation. May be empty while
+                          # proposed: a feature is written on its own (ADR 043), in the
+                          # holding folder, and is not ready until it is attributed.
+    intents: [string]     # business intent ids its ICE is built from (as on capabilities)
+    status: string        # proposed | active | deprecated
+    one_line: string
+    doc: string           # pointer to its feature.md
+    depends_on: [string]  # "needs" (ontology v5): ids of capabilities or OTHER features this
+                          # one needs done first. Field renamed to `needs` under #725.
+    identified_by: string # the capability or feature that led us to find this one; empty
+                          # when it was found on its own (ontology v5)
+    decisions: [string]
+    metadata:
+      created_by: string
+      updated_by: string
+      version: integer
+
+# ---- The agent intents: one ICE for each capability and feature ------
+# Ontology v6 (ADR 047, #759): the ICE is its own node. Each capability and each
+# feature has exactly one ICE; each ICE is for exactly one of them. Its page is
+# `ice.md` in the folder of its part (it moves with its part), with three sections in this
+# order: `## Intent`, `## Context`, `## Expectation`. The entry holds no business intent
+# ids and no ready answer: the ICE finds its business intents through its part, and the
+# ready check works the answer out each time it runs. Until #765 moves a model, its ICE
+# stays inline in the part's page and the spine has no `ices` list.
+ices:
+  - id: string            # opaque, stable
+    for: string           # the id of its one capability or feature
+    for_kind: string      # capability | feature — must match the part `for` names
+    doc: string           # pointer to its ice.md
+    metadata:
+      created_by: string
+      updated_by: string
+      version: integer
+      thin: boolean       # true while the ICE is thin (ontology v11); the play that deepens it removes it
+
+# A thin ICE (ontology v11, #846; v14): proposed from the person's words when a part has no ICE —
+# by /shape-slice for a part a slice needs, or by /update-plan for a feature found mid-plan. Its
+# mark is kept in two places that agree: `metadata.thin: true` here and, on its ICE page, one line
+# just before the ICE — "Thin: proposed from the person's words; deepen with
+# `/discover-capabilities`." Any line that starts "Thin:" there counts (a page with the v11 line
+# is still thin). check_ice_workable.py reads the mark (gap "thin ICE", partly ready) and never
+# counts lines.
+
+# Tree rules (ADR 043, ready rule changed by ontology v5 / #724): every kind is written on
+# its own; the links are made later. A domain has no parent. A capability names a domain
+# (a loose link — it may be missing; the linter warns) and a feature names a
+# capability. Ready (check_ice_workable.py): a capability serves a confirmed business intent
+# and nothing in its `depends_on` ("needs") is open; a feature names a ready
+# capability and nothing it needs is open. A missing domain never blocks. A parent that is
+# named but does not exist is an error. The linter enforces that every named parent ref resolves.
+# Ontology v6 (ADR 047, #760): the ready rule lives on the ICE node — check_ice_workable.py
+# reads the `ices` list and each ice.md and answers ready | partly ready | not ready. A spine
+# with no `ices` list keeps the v5 rule above.
+
+# ---- The profile: THE BOX (structured; lives in the spine) ------------------
+# Decision: the profile is structured machine data — levels + gates — so it stays in
+# the spine, not in a grounding doc. (A short rationale per level may live in the
+# domain grounding doc, but the box itself is here.) `profile.nfr` is the MONOTONIC-UP
+# roll-up of every capability's `nfr_needs` (each dimension = max level across
+# capabilities); `profile.compliance` is the union of their `compliance_needs`. /discover-capabilities
+# writes the per-capability needs and rolls them up; an out-of-box move on an already-set
+# box halts for a human decision (recorded as an ADR).
+profile:
+  state: string                 # directional (/discover-domains) | set (/discover-capabilities) | locked (no play sets it now, ADR 053)
+  shape:
+    stage: string               # prototype | mvp | internal | public | monetized
+    users: [string]
+    monetization: string
+    surfaces: [string]          # web | mobile | cli | api | desktop | embedded | ...
+  nfr:                          # per dimension: a level AND a gate
+    performance:    { level: string, gate: string }
+    security:       { level: string, gate: string }
+    accessibility:  { level: string, gate: string }
+    scalability:    { level: string, gate: string }
+    reliability:    { level: string, gate: string }
+    privacy:        { level: string, gate: string }
+    observability:  { level: string, gate: string }
+    maintainability: { level: string, gate: string }
+    # products may carry additional named dimensions (e.g. explainability, accuracy)
+  compliance: [string]
+  quality_vision:
+    statement: string
+    gates: [string]
+
+# ---- Delivery overlays: slices + epics (indexed here, detailed in their files) --
+# Slices and epics are NOT tree nodes — they are delivery groupings over features.
+# The spine INDEXES them (so the map is complete and you can navigate to any of them);
+# their full structured records stay in their own files, and an epic's grounding lives
+# in its epic.md. The spine never duplicates that detail — it points to it.
+slices:
+  # A slice links to capabilities (through its features), and through them to every domain
+  # it touches. It has no domain home: it lives in this list, and its record lives at
+  # product-os/slices/<id>.yaml (slice.yaml schema). Whether its work has started is shown
+  # by its Epic; what must come first comes from its capabilities' needs.
+  - id: string
+    slug: string
+    feature_refs: [string]   # its features (spine feature ids), in build order
+    vertical: string         # the one surface a person tests end to end (the surface's name
+                             # in the slice record; that surface's persona_ref is the tester)
+    intents: [string]        # "serves" (ontology v10): the BUSINESS INTENT ids
+                             # (product-os/intents/<id>.md) it serves, in order — one or more;
+                             # the first is the one it was first shaped for. The linter checks
+                             # each has a page; a slice naming none is a warning.
+    record: string           # pointer to the full slice record, relative to the product-os
+                             # folder, e.g. "slices/usage-data-foundation.yaml" (slice.yaml schema)
+epics:
+  - id: string
+    slug: string
+    slice_ref: string
+    status: string        # ready | in_delivery | validated | fix_required | delivered
+    order: integer        # delivery order within the slice
+    feature_refs: [string]   # the features this epic delivers (>= 1) — LINKED;
+                                    # the linter rejects an epic naming a feature the
+                                    # spine does not have
+    surface_type: string  # web_dashboard | server_api | cli | library | service_read_model
+    surface_verified: bool
+    issue_ref: string     # GitHub issue; null until /start
+    doc: string           # pointer to the epic grounding doc, e.g.
+                          # "token-dash/slices/usage-data-foundation/epics/coverage.md"
+
+# ---- Fill rules: which play writes which part of the spine -------------------
+fill_rules:
+  # Who writes what (ADR 043): every kind is written on its own, and inside the Discovery loop
+  # each play writes one kind. The links between kinds are made by the loop's gap skills
+  # (find-model-gaps, link-model-gaps) or, run by hand, by the next play the person runs.
+  - play: "/discover-intent"
+    writes: "business intent pages only (and their Sources). No capability, ICE or domain."
+  - play: "/discover-domains"
+    writes: "`domains` entries and their detailed domain pages (with `## Sources`), each
+             domain's `intents`, and the directional profile. No capability."
+  - play: "/discover-capabilities"
+    writes: "capabilities and features, each with its ICE, read off the screens (or
+             named by the person): new capability entries — under their domain when the spine
+             holds it, else in the holding folder with domain empty — and the detail of
+             capabilities already there (detail: detailed, `nfr_needs` + `compliance_needs`),
+             with their `features` entries and pages; then rolls the per-capability
+             needs up into the profile, firming it to state: set (out-of-box moves on an
+             already-set box halt for a human decision). The last detailing step."
+  - play: "/shape-slice"
+    writes: "the `slices` entries — exactly id, slug, feature_refs, vertical, intents,
+             record — and each slice record (product-os/slices/<id>.yaml, slice.yaml v2:
+             `slice` {id, slug, name, outcome, feature_refs, vertical, intents} and
+             `surface` {id, name, persona_ref, user_action}). When a slice already serves
+             the intent, or has the same features and the same vertical, it appends the
+             intent to that slice's entry and record, keeps its features and surface, and
+             writes no new slice. It also writes a thin ICE for each part the slice needs
+             that has no ICE, and the slice's hidden file (failure-and-recovery.md, one
+             entry for each feature) in its home plan's evals folder (ontology v11). It
+             writes no plan, epic, story or eval."
+  - play: "/start … /release-epic"
+    writes: "epic status chain (ready -> in_delivery -> validated -> delivered),
+             surface_verified, issue_ref — surgical structural stamps."
+  - play: "/learn-outcomes"
+    writes: "status changes driven by real-world outcomes."
+
+# ---- On-disk layout ---------------------------------------------------------
+# product-os/
+#   _spine.yaml                                  # THIS file's instance — the map
+#   intents/{intent}.md                          # business intent pages (ontology v3, /discover-intent)
+#   capabilities/{capability}/capability.md      # holding folder: a capability whose domain is
+#                                                #   not known yet; once attributed, its doc
+#                                                #   moves under {domain}/
+#   features/{feature}/feature.md  # holding folder (ADR 043): a feature
+#                                                #   whose capability is not known yet; once
+#                                                #   attributed, its doc moves under its capability
+#   {domain}/
+#     domain.md                                  # grounding (domain template)
+#     {capability}/
+#       capability.md                            # grounding (capability template)
+#       {feature}/
+#         feature.md                       # grounding (feature template)
+#       personas/  journeys/  decisions/         # structured records (referenced by id)
+#     slices/{slice}/epics/{epic}.md             # OLDER CHAIN, not the slice chain: epic
+#     slices/{slice}/lens/{type}.yaml            #   grounding and lens docs that the stale
+#                                                #   /shape-*-lens plays and /build-epic read or
+#                                                #   write until their rebuild (#855, ADR 048).
+#                                                #   /shape-slice never writes here.
+#     slices/_deferred.yaml                      # OLDER CHAIN: the deferred bucket of a dropped play (ADR 053)
+#   slices/                                      # THE SLICE CHAIN (/shape-slice, ADR 049)
+#     {slice}.yaml                               # slice record (slice.yaml v2: slice + surface); a slice has
+#                                                #   no domain home (it links to capabilities)
+#
+# Note what is GONE vs v1: per-node `node.yaml` (structure moved into _spine.yaml) and
+# per-node `ice.yaml` (ICE content moved inline into the grounding docs).
+
+# ---- Enhance rules ----------------------------------------------------------
+enhance_rules:
+  governed_by: "PARKED — a dedicated schema-evolution play will own migrations"
+  immutable_in_v2: [domains, capabilities, features]   # the 3-level taxonomy is fixed
\ No newline at end of file
