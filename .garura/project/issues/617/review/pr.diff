+// Each capability / functionality page carries its ICE as its last section. The Intents tool
+// lists every ICE under the business intent it is built from, as its own piece to answer.
+const ICE_RE = /^(\+|x)?- (Goal|Limit|Fails if|Context|Checked by|Quality need): (.*)$/;
+const ICE_ORDER = ['Goal', 'Limit', 'Fails if', 'Context', 'Checked by', 'Quality need'];
+for (const p of PIECES.filter(p => p.tool === 'product')) {
+  const sec = p.sections.find(s => s[0] === 'Agent intent (ICE)'); if (!sec) continue;
+  const groups = {}; let touched = false;
+  for (const line of sec[1].split('\n')) {
+    const m = ICE_RE.exec(line); if (!m) continue;
+    (groups[m[2]] ||= []).push(`${m[1] || ''}- ${m[3]}`);
+    if (m[1] || /\[-|\{\+/.test(line)) touched = true;
+  }
+  const change = p.change === 'changed' ? (touched ? 'changed' : 'same') : p.change;
+  const from = PIECES.filter(i => i.tool === 'intents' && i.links.some(l => l[2] === p.id));
