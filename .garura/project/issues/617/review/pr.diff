+  color-scheme: light;
+}
+
+* { box-sizing: border-box; }
+html, body { margin: 0; height: 100%; }
+body { background: var(--bg); color: var(--fg); font: 15px/1.6 var(--f-body); }
+button { font: inherit; color: inherit; cursor: pointer; }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+h1, h2, h3 { font-family: var(--f-head); letter-spacing: -.01em; text-wrap: balance; margin: 0; }
+.label { font: 600 11px/1.2 var(--f-body); text-transform: uppercase; letter-spacing: .09em; color: var(--fg3); }
+
+.app { display: grid; grid-template-columns: var(--rail-w, 340px) minmax(0,1fr); min-height: 100%; }
+
+/* Rail */
+.rail { background: var(--rail); border-right: 1px solid var(--line); padding: 24px 16px; display: flex; flex-direction: column; gap: 20px; position: sticky; top: 0; height: 100vh; overflow: auto; }
+.brand { display: flex; align-items: center; gap: 10px; padding: 0 8px; }
+.brand b { font: 700 19px/1 var(--f-head); }
+.brand small { display: block; font: 500 12px/1.2 var(--f-body); color: var(--fg2); margin-top: 3px; }
+.seg { display: flex; background: var(--raised); border-radius: 10px; padding: 3px; gap: 2px; }
+.seg button { flex: 1; border: 0; background: transparent; border-radius: 8px; padding: 7px 12px; font-weight: 600; font-size: 13px; color: var(--fg2); white-space: nowrap; }
+.seg button[aria-pressed="true"] { background: var(--bg); color: var(--fg); box-shadow: 0 1px 3px rgba(10,14,26,.12); }
+.nav { display: flex; flex-direction: column; gap: 2px; }
+.nav .label { padding: 14px 8px 6px; }
+.item { display: flex; align-items: center; gap: 9px; width: 100%; text-align: left; border: 0; background: transparent; border-radius: 8px; padding: 7px 8px; font-size: 14px; color: var(--fg); }
+.item:hover { background: var(--raised); }
+.item[aria-current="true"] { background: var(--accent-soft); color: var(--fg); }
+.item { align-items: flex-start; line-height: 1.35; }
+.item .dot { margin-top: 6px; }
+.item .t { flex: 1; min-width: 0; white-space: normal; overflow-wrap: anywhere; }
+.grip { position: absolute; top: 0; right: -3px; width: 7px; height: 100%; cursor: col-resize; z-index: 6; }
+.grip::after { content: ""; position: absolute; top: 0; bottom: 0; left: 3px; width: 1px; background: transparent; transition: background .15s; }
+.grip:hover::after, .grip.on::after { background: var(--accent); width: 2px; }
+.resizing, .resizing * { cursor: col-resize !important; user-select: none; }
+.bint-tag { display: inline-block; font: 700 9.5px/1 var(--f-body); letter-spacing: .06em; color: var(--key); background: var(--mark); border: 1px solid currentColor; border-radius: 4px; padding: 2px 4px; margin-right: 7px; vertical-align: 2px; }
+.big.bint-tag, .big.ice-tag { font-size: 13px; padding: 4px 7px; vertical-align: 8px; margin-right: 12px; }
+.ice-tag { display: inline-block; font: 700 9.5px/1 var(--f-body); letter-spacing: .06em; color: var(--tag); border: 1px solid currentColor; border-radius: 4px; padding: 2px 4px; margin-right: 7px; vertical-align: 2px; }
+.item.l1 { padding-left: 22px; } .item.l2 { padding-left: 36px; }
+.dot { width: 7px; height: 7px; border-radius: 50%; flex: none; background: transparent; border: 1px solid var(--line); }
+.dot.added { background: var(--add); border-color: var(--add); }
+.dot.changed { background: var(--chg); border-color: var(--chg); }
+.dot.removed { background: var(--del); border-color: var(--del); }
+.tick { width: 16px; text-align: center; font-size: 12px; color: var(--fg3); flex: none; }
+.tick.accept { color: var(--add); } .tick.drop { color: var(--del); } .tick.send { color: var(--accent); }
+.rail-foot { margin-top: auto; display: flex; flex-direction: column; gap: 10px; padding: 0 8px; font-size: 12px; color: var(--fg2); }
+.linkish { border: 0; background: none; padding: 0; color: var(--fg2); text-decoration: underline; text-underline-offset: 3px; font-size: 12px; text-align: left; }
+
+/* Top bar */
+.main { min-width: 0; display: flex; flex-direction: column; }
+.top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 5; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); padding: 14px 32px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
+.top .title { flex: 1; min-width: 200px; }
+.top .title b { font: 600 15px/1.3 var(--f-head); display: block; }
+.top .title span { font-size: 12px; color: var(--fg2); }
+.pill { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; font-size: 12px; color: var(--fg2); background: var(--bg); }
+.pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--add); box-shadow: 0 0 0 0 var(--add-soft); animation: pulse 2s infinite; }
+@keyframes pulse { 0% { box-shadow: 0 0 0 0 var(--add-soft); } 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
+@media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
+.btn { border: 1px solid var(--line); background: var(--bg); border-radius: 10px; padding: 8px 14px; font-weight: 600; font-size: 13px; }
+.btn:hover { border-color: var(--fg3); }
+.btn.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
+.btn.primary[disabled] { opacity: .35; cursor: not-allowed; }
+.btn.tool[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
+
+.body { display: grid; grid-template-columns: minmax(0,1fr) 320px; gap: 0; flex: 1; }
+.body.wide { grid-template-columns: minmax(0,1fr); }
+.content { padding: 36px 32px 80px; min-width: 0; }
+.content-in { max-width: 760px; }
+.side { border-left: 1px solid var(--line); padding: 28px 24px 60px; display: flex; flex-direction: column; gap: 22px; min-width: 0; }
+
+.note { border: 1px solid var(--line); background: var(--raised); border-radius: 10px; padding: 10px 14px; font-size: 13px; color: var(--fg2); display: flex; gap: 10px; align-items: baseline; }
+.note b { color: var(--fg); font-weight: 700; }
+
+/* Overview */
+.ov h1 { font-size: clamp(30px, 4vw, 44px); line-height: 1.1; margin-top: 22px; max-width: 18ch; }
+.ov h1 em { font-style: normal; color: var(--key); }
+.ov .sub { color: var(--fg2); margin: 10px 0 0; }
+.sig { height: 3px; width: 72px; background: var(--sig); border-radius: 2px; margin-top: 18px; }
+.stats { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); margin-top: 34px; border-top: 1px solid var(--line); }
+.stat { padding: 18px 18px 0 0; border-right: 1px solid var(--line); margin-right: 18px; }
+.stat:last-child { border-right: 0; margin-right: 0; }
+.stat .n { font: 600 38px/1.1 var(--f-head); font-variant-numeric: tabular-nums; margin-top: 8px; }
+.stat .n.key { color: var(--key); }
+.stat .h { font-size: 12px; color: var(--fg2); margin-top: 4px; }
+.bar { height: 6px; background: var(--raised); border-radius: 3px; margin-top: 26px; overflow: hidden; }
+.bar i { display: block; height: 100%; background: var(--sig); border-radius: 3px; transition: width .4s; }
+.barcap { display: flex; justify-content: space-between; font-size: 12px; color: var(--fg2); margin-top: 8px; }
+.sect { margin-top: 44px; }
+.sect-h { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
+.sect-h h2 { font-size: 21px; }
+.sect-h span { font-size: 12px; color: var(--fg2); }
+.row { display: grid; grid-template-columns: 110px minmax(0,1fr) auto; gap: 16px; align-items: center; padding: 16px 4px; border-bottom: 1px solid var(--line); width: 100%; text-align: left; background: none; border-left: 0; border-right: 0; border-top: 0; }
+.row:hover { background: var(--rail); }
+.row .rt { font: 600 15px/1.35 var(--f-head); }
+.row .rw { font-size: 13px; color: var(--fg2); margin-top: 2px; }
+.row .go { color: var(--fg3); }
+
+.chip { display: inline-flex; align-items: center; gap: 5px; font: 600 11px/1 var(--f-body); padding: 5px 8px; border-radius: 6px; background: var(--raised); color: var(--fg2); white-space: nowrap; }
+.chip.added { background: var(--add-soft); color: var(--add); }
+.chip.changed { background: var(--chg-soft); color: var(--chg); }
+.chip.removed { background: var(--del-soft); color: var(--del); }
+.chip.ap { background: transparent; border: 1px solid currentColor; }
+.chip.ap-approved, .ms.ap-approved b { color: var(--add); }
+.chip.ap-changed, .ms.ap-changed b { color: var(--chg); }
+.chip.ap-progress, .ms.ap-progress b { color: var(--accent); }
+.chip.ap-accepted { color: var(--add); border-style: dashed; }
+.chip.ap-dropped { color: var(--del); border-style: dashed; }
+.mstate { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 0; margin-top: 18px; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
+.mstate .ms-h { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 16px; border-bottom: 1px solid var(--line); background: var(--rail); font-size: 12px; color: var(--fg2); }
+.mstate .ms { padding: 14px 16px; display: flex; flex-direction: column; gap: 2px; }
+.mstate .ms + .ms { border-left: 1px solid var(--line); }
+.mstate .ms b { font: 600 30px/1.1 var(--f-head); font-variant-numeric: tabular-nums; }
+.mstate .ms span { font-weight: 700; font-size: 13px; }
+.mstate .ms small { font-size: 12px; color: var(--fg3); }
+.chip.kind { background: transparent; border: 1px solid var(--line); }
+.chip.link { background: transparent; border: 1px solid var(--line); color: var(--accent); font-size: 12px; padding: 6px 10px; cursor: pointer; }
+.chip.link:hover { border-color: var(--accent); }
+
+/* Piece */
+.crumb { font-size: 12px; color: var(--fg2); display: flex; gap: 6px; flex-wrap: wrap; }
+.piece h1 { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.15; margin: 10px 0 12px; }
+.chips { display: flex; gap: 6px; flex-wrap: wrap; }
+.why { margin: 16px 0 0; color: var(--fg2); font-size: 14px; }
+.why b { color: var(--fg); }
+.doc { position: relative; margin-top: 30px; }
+.sec { padding: 16px 0 16px 18px; border-left: 2px solid transparent; position: relative; }
+.sec + .sec { border-top: 1px solid var(--line); }
+.sec.added { border-left-color: var(--add); }
+.sec.removed { border-left-color: var(--del); }
+.sec.removed .tx { text-decoration: line-through; text-decoration-color: var(--del); color: var(--fg2); }
+.sec .tx { margin-top: 6px; font-size: 16px; max-width: 66ch; }
+.tx p { margin: 0 0 8px; } .tx p:last-child { margin-bottom: 0; }
+.tx ul { margin: 2px 0 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; }
+.tx li::marker { color: var(--fg3); }
+.tx li.li-add { color: var(--add); background: var(--add-soft); border-radius: 4px; padding: 1px 6px; margin-left: -6px; }
+.tx li.li-add::marker { content: "+  "; color: var(--add); font-weight: 700; }
+.tx li.li-del { color: var(--del); text-decoration: line-through; background: var(--del-soft); border-radius: 4px; padding: 1px 6px; margin-left: -6px; }
+.tx li.li-del::marker { content: "–  "; color: var(--del); font-weight: 700; }
+.facts { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 18px 0 0; padding: 14px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
+.facts div { min-width: 0; } .facts dt { font: 600 11px/1.2 var(--f-body); text-transform: uppercase; letter-spacing: .08em; color: var(--fg3); }
+.facts dd { margin: 4px 0 0; font-size: 13px; color: var(--fg); }
+.sec .ed { position: absolute; top: 12px; right: 0; display: flex; gap: 4px; opacity: 0; transition: opacity .15s; }
+.sec:hover .ed, .sec:focus-within .ed { opacity: 1; }
+.ed button { border: 1px solid var(--line); background: var(--bg); border-radius: 7px; font-size: 12px; padding: 3px 8px; color: var(--fg2); }
+del { color: var(--del); text-decoration-thickness: 1.5px; background: var(--del-soft); border-radius: 3px; padding: 0 2px; }
+ins { color: var(--add); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; background: var(--add-soft); border-radius: 3px; padding: 0 2px; }
+mark.cmt { background: var(--mark); color: inherit; border-bottom: 2px solid var(--key); border-radius: 2px; }
+.p-del { text-decoration: line-through; text-decoration-color: var(--accent); text-decoration-thickness: 2px; color: var(--fg2); }
+.p-ins { color: var(--accent); font-weight: 600; }
+.mode-final .p-del { display: none; }
+.links { margin-top: 26px; display: flex; flex-direction: column; gap: 10px; }
+.links .chips { gap: 8px; }
+.area { position: absolute; border: 2px solid var(--key); background: var(--mark); border-radius: 6px; pointer-events: none; }
+.area span { position: absolute; top: -10px; right: -10px; width: 20px; height: 20px; border-radius: 50%; background: var(--key); color: #fff; font: 700 11px/20px var(--f-body); text-align: center; }
+.pointing .doc { cursor: crosshair; user-select: none; }
+.pointing .doc::after { content: "Drag a box over the part you want to talk about"; position: absolute; top: -26px; left: 18px; font-size: 12px; color: var(--accent); }
+
+/* Side */
+.decide { display: flex; flex-direction: column; gap: 8px; }
+.decide .q { font: 600 15px/1.35 var(--f-head); margin-bottom: 4px; }
+.dbtn { display: flex; align-items: center; gap: 10px; border: 1px solid var(--line); background: var(--bg); border-radius: 10px; padding: 10px 12px; text-align: left; }
+.dbtn small { display: block; color: var(--fg2); font-size: 12px; }
+.dbtn .k { margin-left: auto; font: 11px var(--f-mono); color: var(--fg3); border: 1px solid var(--line); border-radius: 5px; padding: 1px 6px; }
+.dbtn:hover { border-color: var(--fg3); }
+.dbtn[aria-pressed="true"].accept { border-color: var(--add); background: var(--add-soft); }
+.dbtn[aria-pressed="true"].send { border-color: var(--accent); background: var(--accent-soft); }
+.dbtn[aria-pressed="true"].drop { border-color: var(--del); background: var(--del-soft); }
+.ico { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; font-weight: 700; flex: none; }
+.accept .ico { color: var(--add); background: var(--add-soft); } .send .ico { color: var(--accent); background: var(--accent-soft); } .drop .ico { color: var(--del); background: var(--del-soft); }
+.thread { display: flex; flex-direction: column; gap: 12px; }
+.cm { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: 13px; }
+.cm q { display: block; quotes: none; color: var(--fg2); border-left: 2px solid var(--key); padding-left: 8px; margin-bottom: 6px; font-size: 12px; }
+.cm .meta { display: flex; justify-content: space-between; gap: 8px; color: var(--fg3); font-size: 11px; margin-top: 6px; }
+.cm.garura { background: var(--raised); border-color: transparent; }
+.cm.garura .who { color: var(--accent); font-weight: 700; }
+.state { font-weight: 700; }
+.state.open { color: var(--key); } .state.answered { color: var(--accent); } .state.resolved { color: var(--add); }
+.composer { border: 1px solid var(--accent); border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 8px; background: var(--bg); }
+.composer textarea { width: 100%; min-height: 70px; border: 0; resize: vertical; background: transparent; color: var(--fg); font: 14px/1.5 var(--f-body); outline: none; }
+.composer .row2 { display: flex; justify-content: flex-end; gap: 6px; }
+.feed { font-size: 12px; color: var(--fg2); display: flex; flex-direction: column; gap: 4px; }
+.feed div { display: flex; gap: 8px; } .feed code { font-family: var(--f-mono); color: var(--fg3); }
+.empty { font-size: 13px; color: var(--fg3); }
+
+/* Popover */
+.pop { position: absolute; z-index: 20; display: flex; gap: 2px; background: var(--fg); border-radius: 10px; padding: 4px; box-shadow: var(--shadow); }
+.pop button { border: 0; background: transparent; color: var(--bg); font-size: 13px; font-weight: 600; padding: 6px 10px; border-radius: 7px; }
+.pop button:hover { background: color-mix(in srgb, var(--bg) 18%, transparent); }
+
+.scrim { position: fixed; inset: 0; background: rgba(10,14,26,.45); display: grid; place-items: center; z-index: 30; padding: 16px; }
+.modal { background: var(--bg); border-radius: 16px; padding: 28px; max-width: 460px; width: 100%; box-shadow: var(--shadow); }
+.modal h2 { font-size: 24px; margin-bottom: 8px; }
+.modal p { color: var(--fg2); margin: 6px 0; }
+.modal .sig { margin: 14px 0 18px; }
+
+@media (max-width: 1080px) { .body { grid-template-columns: minmax(0,1fr); } .side { border-left: 0; border-top: 1px solid var(--line); } }
+@media (max-width: 820px) {
+  .app { grid-template-columns: minmax(0,1fr); }
+  .rail { position: static; height: auto; max-height: none; border-right: 0; border-bottom: 1px solid var(--line); }
+  .nav { max-height: 260px; overflow: auto; }
+  .grip { display: none; }
+  .top, .content { padding-left: 16px; padding-right: 16px; }
+  .side { padding-left: 16px; padding-right: 16px; }
+  .stats { grid-template-columns: repeat(2, minmax(0,1fr)); }
+  .stat { border-right: 0; margin-right: 0; }
+  .row { grid-template-columns: minmax(0,1fr) auto; } .row .chips { display: none; }
+}
+
+/* Catch up: one change per card, like Teams mobile Catch up */
+.btn.cu-open { background: var(--accent); border-color: var(--accent); color: #fff; }
+.btn.cu-open:hover { filter: brightness(1.08); }
+.cu-invite { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding: 22px 24px; border-radius: 14px; background: var(--accent-soft); }
+.cu-invite div { flex: 1; min-width: 220px; }
+.cu-invite b { font: 600 19px/1.3 var(--f-head); display: block; }
+.cu-invite span { font-size: 13px; color: var(--fg2); }
+.cu { position: fixed; inset: 0; z-index: 40; background: var(--rail); display: flex; flex-direction: column; padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
+.cu-top { display: flex; align-items: center; gap: 14px; padding: 14px 24px; flex-wrap: wrap; }
+.cu-top .ttl { flex: 1; min-width: 160px; }
+.cu-top .ttl b { font: 600 16px/1.2 var(--f-head); display: block; }
+.cu-top .ttl span { font-size: 12px; color: var(--fg2); }
+.cu-count { font: 600 14px var(--f-head); font-variant-numeric: tabular-nums; }
+.cu-segs { display: flex; gap: 3px; padding: 0 24px; }
+.cu-segs i { flex: 1; height: 4px; border-radius: 2px; background: var(--line); }
+.cu-segs i.accept { background: var(--add); } .cu-segs i.send { background: var(--accent); } .cu-segs i.drop { background: var(--del); } .cu-segs i.later { background: var(--fg3); }
+.cu-segs i.now { background: var(--fg); }
+.cu-stage { flex: 1; position: relative; display: grid; place-items: center; padding: 18px 16px 12px; min-height: 0; }
+.cu-deck { position: relative; width: min(720px, 100%); height: 100%; max-height: 780px; }
+.cu-card { position: absolute; inset: 0; background: var(--bg); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); display: flex; flex-direction: column; overflow: hidden; touch-action: pan-y; transition: transform .28s cubic-bezier(.2,.7,.2,1), opacity .28s; }
+.cu-card.peek1 { transform: translateY(12px) scale(.97); opacity: .7; z-index: 1; pointer-events: none; }
+.cu-card.peek2 { transform: translateY(24px) scale(.94); opacity: .4; z-index: 0; pointer-events: none; }
+.cu-card.cu-now { z-index: 2; }
+.cu-card.dragging { transition: none; cursor: grabbing; }
+.cu-hint { position: absolute; top: 22px; z-index: 3; font: 700 13px/1 var(--f-head); letter-spacing: .08em; text-transform: uppercase; padding: 8px 12px; border-radius: 8px; border: 2px solid; opacity: 0; pointer-events: none; }
+.cu-hint.r { right: 22px; color: var(--add); background: var(--add-soft); }
+.cu-hint.l { left: 22px; color: var(--fg2); background: var(--raised); }
+.cu-head { padding: 22px 26px 14px; border-bottom: 1px solid var(--line); }
+.cu-head .ctx { font-size: 12px; color: var(--fg2); margin-bottom: 8px; }
+.cu-head h2 { font-size: clamp(21px, 3vw, 27px); line-height: 1.2; }
+.cu-head .chips { margin-top: 10px; }
+.cu-head .why { margin-top: 10px; }
+.cu-body { flex: 1; overflow: auto; padding: 6px 26px 18px; min-height: 0; }
+.cu-body .sec { padding-left: 14px; }
+.cu-body .more { font-size: 12px; color: var(--fg3); padding: 12px 0 0 14px; }
+.cu-say { padding: 12px 26px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
+.cu-say textarea { width: 100%; min-height: 64px; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font: 14px/1.5 var(--f-body); color: var(--fg); background: var(--bg); resize: vertical; }
+.cu-say textarea:focus { outline: none; border-color: var(--accent); }
+.cu-say .row2 { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }
+.cu-say .lbl { font-size: 13px; font-weight: 600; }
+.cu-acts { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 8px; padding: 14px 18px 18px; border-top: 1px solid var(--line); }
+.cu-act { display: flex; flex-direction: column; align-items: center; gap: 4px; border: 1px solid var(--line); background: var(--bg); border-radius: 12px; padding: 10px 6px; font-size: 13px; font-weight: 700; }
+.cu-act small { font-weight: 400; font-size: 11px; color: var(--fg3); }
+.cu-act:hover { border-color: var(--fg3); }
+.cu-act.accept { background: var(--add-soft); border-color: transparent; color: var(--add); }
+.cu-act.send { color: var(--accent); } .cu-act.drop { color: var(--del); } .cu-act.later { color: var(--fg2); }
