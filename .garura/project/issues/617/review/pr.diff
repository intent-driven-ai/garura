+.cu-end .row2 { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 22px; }
+.cu-sum { display: flex; gap: 22px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }
+.cu-sum div { font-size: 12px; color: var(--fg2); } .cu-sum b { display: block; font: 600 30px/1.1 var(--f-head); color: var(--fg); }
+.cu-foot { text-align: center; font-size: 12px; color: var(--fg3); padding: 0 16px 14px; }
+.toast { position: fixed; left: 50%; bottom: calc(24px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 50; background: var(--fg); color: var(--bg); border-radius: 12px; padding: 10px 12px 10px 16px; display: flex; gap: 14px; align-items: center; font-size: 14px; box-shadow: var(--shadow); }
+.toast button { border: 0; background: color-mix(in srgb, var(--bg) 18%, transparent); color: var(--bg); border-radius: 8px; padding: 6px 10px; font-weight: 700; }
+@media (max-width: 640px) {
+  .cu-top { padding: 10px 16px; } .cu-segs { padding: 0 16px; }
+  .cu-head, .cu-body, .cu-say { padding-left: 16px; padding-right: 16px; }
+  .cu-acts { grid-template-columns: repeat(2, minmax(0,1fr)); padding: 12px; }
+  .cu-act small { display: none; }
+}
+@media (prefers-reduced-motion: reduce) { .cu-card { transition: none; } }
