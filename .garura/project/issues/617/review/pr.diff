+  { id:'p5', tool:'product', kind:'Capability', group:'Orders', level:1, change:'added', status:'Proposed',
+    title:'Refunds',
+    why:'New, for the staff refund intent. It needs more security than the product allowed, so the security limit went up.',
+    facts:[['Status','Proposed'],['Page','Full'],['Built for','1 business intent'],['Needs','Security very high · PCI-DSS'],['Serves','Shop staff'],['Depends on','Checkout']],
+    sections:[
