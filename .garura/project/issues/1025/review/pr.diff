+conditions:
+  recognises: "the PR changes human-facing prose that is not a decision record"
+  signals: ["docs/**", "README*", "CONTRIBUTING*", "CHANGELOG*", "**/*.md prose that is not a play/skill/agent/ADR/memory file"]
+provenance: "seeded:#443"
