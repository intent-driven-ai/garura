+        code, res = verdict(root, p, p["request"])
+        check("the spine as the skill left it: ok", code == 0 and res["planned"] == ["ft-pick", "ft-remind"])
+    return finish()
+
+
+if __name__ == "__main__":
+    sys.exit(main())
