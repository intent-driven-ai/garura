+++        self.assertEqual(self.read(self.cap), CAP)
+++        self.assertEqual(self.read(self.feat), FEAT)
+++
+++    def test_a_line_not_on_the_page_refuses_everything(self):
+++        self.assert_refused_and_unchanged(self.request([
