+    def test_thin_false_takes_the_mark_off_the_entry_and_the_page(self):
+        r, _ = self.run_request(parts=[self.update(thin=True)])
+        self.assertEqual(r.returncode, 0, r.stderr)
+        self.assertIn(THIN, self.read("features/fn-1/feature.md"))
+        r, report = self.run_request(parts=[self.update(thin=False)])
+        self.assertEqual(r.returncode, 0, r.stderr)
+        self.assertNotIn(THIN, self.read("features/fn-1/feature.md"))
+        self.assertEqual(self.read("features/fn-1/feature.md"), PAGE.format(title="Send one message"))
+        self.assertFalse((self.entry("features", "fn-1").get("metadata") or {}).get("thin"))
