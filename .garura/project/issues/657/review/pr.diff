diff --git a/core/tools/memory/contract/v2.json b/core/tools/memory/contract/v2.json
new file mode 100644
index 00000000..53950831
--- /dev/null
+++ b/core/tools/memory/contract/v2.json
@@ -0,0 +1,1154 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "Memory tool contract",
+  "version": "2.0.0",
+  "contract_version": "2",
+  "description": "The one agreement between agents and the memory tool: the commands to find memory and to update it, what each takes and gives back, and how each fails. A request is a JSON object; on the command line its fields are the flags, and on a server they are the request body. A response is always a JSON object with ok, contract_version and command. Plain-words guide: ../README.md. Version 2 (#657): a lookup of Garura or Phoenix memory works without an issue; a glob, like a path, never steps outside its tier; Phoenix memory is read only at its approved version; and a file read from Phoenix memory is saved into Garura memory.",
+  "tiers": {
+    "short-term": "One issue's own memory: the plans, specs and context of the work on that issue. Root: the folder that holds one folder per issue. Every lookup names its issue, and the tool reads short-term memory only in that issue's folder ('<issue>/'), never in another issue's. Otherwise another issue's notes would answer first, and Garura and Phoenix memory would never be reached.",
+    "garura": "Garura memory: the project's long-term memory. Holds the subset of Phoenix memory the project pulled, and what the project makes itself (product model, intents, decisions, answers).",
+    "phoenix": "Phoenix memory: the global memory and the superset. Its own git repository until Griffin serves it. Read only at its approved version: the commit the setting phoenix_ref names. A change reaches it when a person approves it outside Garura; until then (on a branch, or edited on disk) the tool does not read it."
+  },
+  "lookup_order": [
+    "short-term",
+    "garura",
+    "phoenix"
