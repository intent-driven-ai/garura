++++## How it is searched
+ ++
+-++def load_plan(plans_dir, pid):
+-++    path = os.path.join(plans_dir, f"{pid}.yaml")
+-++    with open(path, encoding="utf-8") as fh:
+-++        plan = yaml.safe_load(fh)
+-++    if not isinstance(plan, dict):
+-++        raise ValueError(f"{path} is not a mapping")
+-++    return plan
++++A skill calls a search script. The search engine evolves; the skill interface
++++does not.
+ ++
++++**V1 (now) — script over grep'd files.** The script uses grep/cat as plumbing:
++++fetch the index, fetch candidate learnings. The *matching* is the model's job —
++++it reasons over each candidate's **Conditions** section to find the learning
++++that fits the product's situation, and follows **Evolve when** links to the next
++++rung. Grep retrieves text; the model decides relevance. This keeps V1 simple and
++++lets us move fast.
+ ++
+-++def work_issues(nodes):
+-++    """Every issue in the tree that is not a capability (capabilities are closed by
+-++    merge-change when all their children are)."""
+-++    for node in nodes or []:
+-++        if not isinstance(node, dict):
+-++            continue
+-++        if node.get("kind") != "capability" and node.get("issue") is not None:
+-++            yield str(node["issue"])
+-++        yield from work_issues(node.get("children"))
+-++
+-++
+-++def tracker_state(issue, config, states):
+-++    if states is not None:
+-++        return states.get(str(issue), "OPEN")
+-++    import platform_adapter as pa
+-++    res = pa.dispatch("view-issue", {"issue_number": issue, "_tree": False}, config_path=config)
+-++    if res["exit_code"] != 0:
+-++        return "UNKNOWN"
+-++    try:
+-++        return json.loads(res["stdout"]).get("state", "UNKNOWN")
+-++    except ValueError:
+-++        return "UNKNOWN"
