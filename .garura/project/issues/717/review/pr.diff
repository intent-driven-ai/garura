+++++        out = os.path.join(self.base, "report.json")
+++++        r = subprocess.run([sys.executable, SCRIPT, "--request", req, "--product-base", self.base,
+++++                            "--out", out], capture_output=True, text=True)
+++++        if r.returncode != 0:
