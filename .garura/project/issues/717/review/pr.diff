+++++                                        "one_line": "Send every mail"}])
+++++        self.assertEqual(r.returncode, 0, r.stderr)
+++++        cap = yaml.safe_load(self.read("_spine.yaml"))["capabilities"][0]
+++++        self.assertEqual(cap["one_line"], "Send every mail")
