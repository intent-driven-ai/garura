++-++def classify(branch):
++-++    m = ISSUE_IN_PLAN.match(branch)
++-++    if m:
++-++        return {"branch": branch, "kind": "issue-in-plan", "plan_id": m.group(1),
++-++                "issue": m.group(2), "base": f"plan/{m.group(1)}/base"}
