+++def ref_of(branch, repo):
+++    for ref in (branch, f"origin/{branch}"):
+++        r = subprocess.run(["git", "rev-parse", "--verify", "--quiet", ref],
+++                           cwd=repo, capture_output=True, text=True)
+++        if r.returncode == 0:
