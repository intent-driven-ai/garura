++-++        raise ValueError(f"issue {issue} sits in more than one plan: {', '.join(found)}")
++-++    pid = found[0] if found else None
++-++    if pid:
++-++        return {"issue": issue, "plan_id": pid, "plan_branch": f"plan/{pid}/base",
++-++                "issue_branch": f"plan/{pid}/{issue}-{slug}"}
++-++    return {"issue": issue, "plan_id": None, "plan_branch": None,
++-++            "issue_branch": f"feature/{issue}-{slug}"}
+++++| Phase | Verb | Example |
+++++|-------|------|---------|
+++++| Product → Intent | `discover` | `discover-domains` |
+++++| Intent → Design | `shape` | `shape-slice` |
+++++| Design → Code | `build` | `build-epic` |
+++++| Code → Validation | `validate` | `validate-epic` |
+++++| Validation → Run | `release` | `release-increment` |
+++++| Run → Product | `learn` | `learn-outcomes` |
++ ++
+++++Change plays use `start`, `commit`, `propose`, `check`, `merge`, `fix`, `refactor`; plan plays
+++++`draft`, `show`, `update`, `list`; `record` writes a decision; harness plays `create`, `edit`,
+++++`install`, `uninstall`.
