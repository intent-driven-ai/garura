++++import io
++++import os
++++import subprocess
++++import tempfile
++++import textwrap
++++import unittest
++++from contextlib import redirect_stderr, redirect_stdout
++++
++++import plan
++++
++++HERE = os.path.dirname(os.path.abspath(__file__))
++++TEMPLATE = os.path.join(HERE, "..", "..", "components", "memory", "standards", "templates", "plan-view.md")
++++
++++PLANS = {
++++    "10": """
++++        id: 10
++++        title: People find a reset link in their mail
++++        status: active
++++        branch: null
++++        needs_plans: [20]
++++        tree:
++++        - issue: 11
++++          kind: epic
++++          title: A person resets a lost password
++++          status: In Progress
++++          children:
++++          - issue: 12
++++            kind: story
++++            title: Send the reset link
++++            status: Done
++++            children:
++++            - issue: 13
++++              kind: bug
++++              title: The link expires too soon
++++              status: Not Started
++++          - issue: 14
++++            kind: story
++++            title: Show the reset page
++++            status: Now
++++          - issue: 15
++++            kind: story
++++            title: Lock the account after five tries
++++            status: Dropped
++++          - issue: 16
++++            kind: story
++++            title: Log every reset
++++            status: Done
++++        """,
++++    "20": """
++++        id: 20
++++        title: Mail goes out through one service
++++        status: active
++++        branch: null
++++        tree:
++++        - issue: 21
