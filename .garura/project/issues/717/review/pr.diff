+++++        self.write("capabilities/cap-2/capability.md", PAGE.format(title="x"))
+++++        self.assert_refused_parts([{"id": "cap-2", "kind": "capability", "mode": "new", "slug": "cap-2",
+++++                                    "domain": "dom-9", "intents": ["bi-1"], "one_line": "x",
