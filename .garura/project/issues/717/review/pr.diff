+-+        plan = yaml.safe_load(fh)
+-+    if not isinstance(plan, dict):
+-+        raise ValueError(f"{path} is not a mapping")
+-+    return plan
+++def dot_get(doc, field):
+++    cur = doc
+++    for part in field.split("."):
+++        if isinstance(cur, list):
+++            cur = cur[int(part)]
+++        elif isinstance(cur, dict) and part in cur:
+++            cur = cur[part]
+++        else:
+++            return None, False
+++    return cur, True
+ +
+ +
+-+def work_issues(nodes):
+-+    """Every issue in the tree that is not a capability (capabilities are closed by
+-+    merge-change when all their children are)."""
+-+    for node in nodes or []:
+-+        if not isinstance(node, dict):
+-+            continue
+-+        if node.get("kind") != "capability" and node.get("issue") is not None:
+-+            yield str(node["issue"])
+-+        yield from work_issues(node.get("children"))
+-+
+-+
+-+def tracker_state(issue, config, states):
+-+    if states is not None:
+-+        return states.get(str(issue), "OPEN")
+-+    import platform_adapter as pa
+-+    res = pa.dispatch("view-issue", {"issue_number": issue, "_tree": False}, config_path=config)
+-+    if res["exit_code"] != 0:
+-+        return "UNKNOWN"
+++def eval_clause(clause, base):
+++    check = clause.get("check") or {}
+++    ctype = check.get("type")
+ +    try:
+-+        return json.loads(res["stdout"]).get("state", "UNKNOWN")
+-+    except ValueError:
+-+        return "UNKNOWN"
+++        if ctype == "artifact_exists":
+++            pattern = os.path.join(base, check["path"])
+++            hits = glob.glob(pattern)
+++            return ("held" if hits else "unmet",
+++                    f"{len(hits)} match(es) for {check['path']}")
+++        if ctype == "field_equals":
+++            fpath = os.path.join(base, check["file"])
+++            if not os.path.exists(fpath):
+++                return "unmet", f"file missing: {check['file']}"
+++            value, found = dot_get(load_doc(fpath), check["field"])
+++            if not found:
