+ +#!/usr/bin/env python3
+ +"""
+-+resolve_target.py — where does this branch land? (#673)
+-+
+-+The branch name says what the change is (start-change, #731):
+-+
+-+  plan/<P>/<issue>-<slug>   an issue in plan P   → lands on plan/<P>/base
+-+  plan/<P>/base             plan P itself        → lands on main, while the plan is still in
+-+                                                   progress (a plan merges when it pauses)
+-+  anything else             a one-off change     → lands on main
+-+
+-+    python3 resolve_target.py --branch <branch> [--out <target.json>]
+-+
+-+Prints { branch, kind, plan_id, issue, base }. Open work in a plan never holds its branch
+-+off main: only the merge preconditions (approved, mergeable, required checks) guard main.
+-+load_plan, work_issues and tracker_state are also used by merge_pr.py to close a
+-+capability once every issue under it is closed. Exit 0. Read only: no git, no network.
+++check_list.py — /list-plans's check: the view holds every plan once, in order, from the
+++template, the same way twice, and no plan file changed (C1–C8, F1–F6).
+++
+++    python3 check_list.py hash  --plans-dir D --out <working>/before.json
+++    python3 check_list.py check --plans-dir D --template T --mode list|graph \
+++        --view <working>/view.txt --view2 <working>/view2.txt --before <working>/before.json \
+++        [--repo R] --out <working>/check.json
+++
+++`hash` records the plan files' hashes before the tool runs. `check` re-derives what the view
+++must hold from the plan files, the template and git, and writes check.json:
+++{plans_in_folder, all_listed, in_order, template_used, same_twice, unchanged,
+++graph_numbers_match, problems, ok}. Exit 0 = ok, 1 = a check failed, 2 = bad input.
+ +"""
+++
+ +import argparse
+++import glob
+++import hashlib
+ +import json
+ +import os
+ +import re
+++import subprocess
+ +import sys
+ +
+ +import yaml
+ +
+-+HERE = os.path.dirname(os.path.abspath(__file__))
+-+sys.path.insert(0, HERE)
+++BLOCK = re.compile(r"^```yaml plan-view\s*\n(.*?)^```", re.S | re.M)
+ +
+-+ISSUE_IN_PLAN = re.compile(r"^plan/(\d+)/(\d+)(?:-|$)")
+-+PLAN_BASE = re.compile(r"^plan/(\d+)/base$")
+ +
+++def plan_paths(plans_dir):
+++    paths = [p for p in glob.glob(os.path.join(plans_dir, "*.yaml")) if os.path.basename(p) != "index.yaml"]
+++    key = lambda p: os.path.splitext(os.path.basename(p))[0]
+++    return sorted(paths, key=lambda p: (int(key(p)) if key(p).isdigit() else float("inf"), key(p)))
+ +
+-+def classify(branch):
+-+    m = ISSUE_IN_PLAN.match(branch)
+-+    if m:
+-+        return {"branch": branch, "kind": "issue-in-plan", "plan_id": m.group(1),
+-+                "issue": m.group(2), "base": f"plan/{m.group(1)}/base"}
+-+    m = PLAN_BASE.match(branch)
+-+    if m:
+-+        return {"branch": branch, "kind": "plan", "plan_id": m.group(1), "issue": m.group(1),
+-+                "base": "main"}
+-+    m = re.search(r"/(\d+)(?:-|$)", branch)
+-+    return {"branch": branch, "kind": "one-off", "plan_id": None,
+-+            "issue": m.group(1) if m else None, "base": "main"}
+ +
+++def hashes(plans_dir):
+++    out = {}
+++    for p in plan_paths(plans_dir):
+++        with open(p, "rb") as fh:
+++            out[os.path.basename(p)] = hashlib.sha256(fh.read()).hexdigest()
+++    return out
+ +
+-+def load_plan(plans_dir, pid):
+-+    path = os.path.join(plans_dir, f"{pid}.yaml")
+-+    with open(path, encoding="utf-8") as fh:
+-+        plan = yaml.safe_load(fh)
+-+    if not isinstance(plan, dict):
+-+        raise ValueError(f"{path} is not a mapping")
+-+    return plan
+ +
+++def git_ref(branch, repo):
+++    for ref in (branch, f"origin/{branch}"):
+++        if subprocess.run(["git", "rev-parse", "--verify", "--quiet", ref], cwd=repo,
+++                          capture_output=True).returncode == 0:
+++            return ref
+++    return None
+ +
+-+def work_issues(nodes):
+-+    """Every issue in the tree that is not a capability (capabilities are closed by
+-+    merge-change when all their children are)."""
+-+    for node in nodes or []:
+-+        if not isinstance(node, dict):
+-+            continue
+-+        if node.get("kind") != "capability" and node.get("issue") is not None:
+-+            yield str(node["issue"])
+-+        yield from work_issues(node.get("children"))
+-+
+-+
+-+def tracker_state(issue, config, states):
+-+    if states is not None:
+-+        return states.get(str(issue), "OPEN")
+-+    import platform_adapter as pa
+-+    res = pa.dispatch("view-issue", {"issue_number": issue, "_tree": False}, config_path=config)
+-+    if res["exit_code"] != 0:
+-+        return "UNKNOWN"
+-+    try:
+-+        return json.loads(res["stdout"]).get("state", "UNKNOWN")
+-+    except ValueError:
+-+        return "UNKNOWN"
+ +
+++def check(a):
+++    with open(a.template, encoding="utf-8") as fh:
+++        m = BLOCK.search(fh.read())
+++    if not m:
+++        raise SystemExit(2)
+++    t = yaml.safe_load(m.group(1))
+++    plans = []
+++    for p in plan_paths(a.plans_dir):
+++        with open(p, encoding="utf-8") as fh:
+++            plan = yaml.safe_load(fh) or {}
+++        plans.append((str(plan.get("id", os.path.splitext(os.path.basename(p))[0])), plan.get("title", "")))
+++    view = open(a.view, encoding="utf-8").read().splitlines()
+++    view2 = open(a.view2, encoding="utf-8").read().splitlines()
+++    with open(a.before, encoding="utf-8") as fh:
+++        before = json.load(fh)
