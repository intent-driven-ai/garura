+++    python3 plan.py list  --template <plan-view.md> [--plans-dir D]
+++    python3 plan.py show  --template <plan-view.md> [--plans-dir D] --plan <id>
+++    python3 plan.py graph --template <plan-view.md> [--plans-dir D] [--repo R]
