+++#!/usr/bin/env python3
+++"""
+++session_stamp.py — the session identity stamp (#463).
+++
+++Binds a play run to the exact slice of the Claude Code session ledger that
+++produced it, so spend and behavior are computable OFFLINE (token-burn-dash)
+++with zero in-run cost. No parsing, no summing: one directory listing, one
+++line read, one file size.
+++
+++The ledger: Claude Code writes one JSONL per session under
+++~/.claude/projects/<cwd-slug>/<session-id>.jsonl. Every line carries
+++sessionId and gitBranch; assistant lines carry token usage. This script
+++never reads more than the last line of a candidate file.
+++
+++Phases (mirrors the status-marker lifecycle):
+++    --phase start  → resolve the live session (prefer the ledger whose last
+++                     line's gitBranch matches --branch, else newest mtime),
+++                     write {session_id, ledger_file, start_offset, started_at}
+++                     to --marker.
+++    --phase close  → read --marker, take the ledger's current size as
+++                     end_offset, emit the stamp JSON to stdout (the play close
+++                     copies the fields into the evidence frontmatter).
+++
+++Failures are soft: a missing ledger yields a stamp with
+++nulls and "ledger_resolved": false — the close never blocks on the stamp.
+++"""
+ +
+-+def check(name, cond):
+-+    global PASSED, FAILED
+-+    if cond:
+-+        PASSED += 1
+-+        print(f"  [PASS] {name}")
+-+    else:
+-+        FAILED += 1
+-+        print(f"  [FAIL] {name}")
+++import argparse
+++import json
+++import sys
+++import time
+++from pathlib import Path
+ +
+ +
+-+def git(cwd, *args):
+-+    return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True).stdout.strip()
+++def cwd_slug(cwd):
+++    return "".join(ch if ch.isalnum() else "-" for ch in str(cwd))
+ +
+ +
+-+def commit(cwd, name):
+-+    with open(os.path.join(cwd, name), "w") as fh:
+-+        fh.write(name)
+-+    git(cwd, "add", name)
+-+    git(cwd, "commit", "-q", "-m", name)
+++def last_line(path, max_tail=65536):
+++    """Read the final line of a (possibly large) file without loading it."""
+++    try:
+++        with open(path, "rb") as fh:
+++            fh.seek(0, 2)
+++            size = fh.tell()
+++            fh.seek(max(0, size - max_tail))
+++            tail = fh.read().decode("utf-8", errors="replace")
+++        lines = [line for line in tail.strip().splitlines() if line.strip()]
+++        return json.loads(lines[-1]) if lines else None
+++    except Exception:
+++        return None
+++
+++
+++def resolve_ledger(projects_dir, cwd, branch):
+++    """The live session's ledger: prefer last-line gitBranch == branch,
+++    fall back to newest mtime. Returns (path, session_id) or (None, None)."""
+++    slug_dir = Path(projects_dir) / cwd_slug(cwd)
+++    if not slug_dir.is_dir():
+++        return None, None
+++    candidates = sorted(slug_dir.glob("*.jsonl"),
+++                        key=lambda p: p.stat().st_mtime, reverse=True)
+++    newest = None
+++    for p in candidates[:10]:  # only recent files can be the live session
+++        rec = last_line(p)
+++        if rec is None:
+++            continue
+++        sid = rec.get("sessionId")
+++        if newest is None and sid:
+++            newest = (p, sid)
+++        if branch and rec.get("gitBranch") == branch and sid:
+++            return p, sid
+++    return newest if newest else (None, None)
+++
+++
+++def phase_start(args):
+++    ledger, session_id = resolve_ledger(args.projects_dir, args.cwd, args.branch)
+++    marker = {
+++        "ledger_resolved": ledger is not None,
+++        "session_id": session_id,
+++        "ledger_file": str(ledger) if ledger else None,
+++        "start_offset": ledger.stat().st_size if ledger else None,
+++        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+++    }
+++    Path(args.marker).parent.mkdir(parents=True, exist_ok=True)
+++    with open(args.marker, "w", encoding="utf-8") as fh:
+++        json.dump(marker, fh, indent=2)
+++    print(json.dumps(marker, indent=2))
+ +
+ +
+-+def run(cwd, out, *args):
+-+    p = subprocess.run([sys.executable, SCRIPT, *args, "--out", out], cwd=cwd, capture_output=True, text=True)
+-+    return p.returncode, (json.load(open(out)) if p.returncode == 0 else None)
+++def phase_close(args):
+++    try:
+++        with open(args.marker, "r", encoding="utf-8") as fh:
+++            marker = json.load(fh)
+++    except Exception:
+++        marker = {"ledger_resolved": False, "session_id": None,
+++                  "ledger_file": None, "start_offset": None}
+++    ledger = marker.get("ledger_file")
+++    end_offset = None
+++    if ledger and Path(ledger).exists():
+++        end_offset = Path(ledger).stat().st_size
+++    stamp = {
+++        "ledger_resolved": bool(marker.get("ledger_resolved") and end_offset is not None),
+++        "session_id": marker.get("session_id"),
+++        "ledger_file": ledger,
+++        "ledger_start_offset": marker.get("start_offset"),
+++        "ledger_end_offset": end_offset,
+++    }
+++    print(json.dumps(stamp, indent=2))
+ +
+ +
+ +def main():
+-+    with tempfile.TemporaryDirectory() as tmp:
+-+        origin, work = os.path.join(tmp, "origin.git"), os.path.join(tmp, "work")
+-+        subprocess.run(["git", "init", "-q", "--bare", "-b", "main", origin])
+-+        subprocess.run(["git", "clone", "-q", origin, work], capture_output=True)
+-+        git(work, "config", "user.email", "t@t"); git(work, "config", "user.name", "t")
+-+        git(work, "checkout", "-q", "-b", "main")
+-+        commit(work, "a"); git(work, "push", "-q", "-u", "origin", "main")
+-+        out = os.path.join(tmp, "b.json")
+-+
+-+        rc, r = run(work, out, "--issue", "731", "--branch-name", "plan/717/731-x", "--plan-branch", "plan/717/base")
+-+        main_tip = git(work, "rev-parse", "origin/main")
+-+        check("first issue in a plan: the plan branch is cut from latest main",
+-+              rc == 0 and r["plan_branch_created"] and git(work, "rev-parse", "origin/plan/717/base") == main_tip)
+-+        check("the issue branch is a sub-branch, cut from the plan branch",
+-+              git(work, "branch", "--show-current") == "plan/717/731-x" and r["base_sha"] == main_tip)
+-+
+-+        git(work, "checkout", "-q", "main"); commit(work, "b"); git(work, "push", "-q", "origin", "main")
+-+        rc, r = run(work, out, "--issue", "673", "--branch-name", "plan/717/673-y", "--plan-branch", "plan/717/base")
+-+        plan_tip = git(work, "rev-parse", "origin/plan/717/base")
+-+        check("the plan already started: it is not cut again", rc == 0 and not r["plan_branch_created"])
+-+        check("the latest main is merged into the plan branch first",
+-+              subprocess.run(["git", "merge-base", "--is-ancestor", "origin/main", "origin/plan/717/base"], cwd=work).returncode == 0)
+-+        check("the next issue branch is cut from the updated plan branch", r["base_sha"] == plan_tip)
+-+
+-+        rc, r = run(work, out, "--issue", "999", "--branch-name", "feature/999-z")
+-+        check("an issue in no plan still branches from main",
+-+              rc == 0 and r["plan_branch"] is None and git(work, "merge-base", "HEAD", "origin/main") == git(work, "rev-parse", "origin/main"))
+-+
+-+        rc, r = run(work, out, "--issue", "731", "--branch-name", "plan/717/731-x", "--plan-branch", "plan/717/base")
+-+        check("a re-run resumes the issue branch, with no new branch", rc == 0 and git(work, "branch", "--show-current") == "plan/717/731-x")
+-+        git(work, "checkout", "-q", "main"); commit(work, "c"); git(work, "push", "-q", "origin", "main")
+-+        rc, r = run(work, out, "--issue", "731", "--branch-name", "plan/717/731-x", "--plan-branch", "plan/717/base")
+-+        check("a resume records the plan branch tip as its base, not main's (H4)",
+-+              rc == 0 and r["base_sha"] == git(work, "rev-parse", "origin/plan/717/base")
+-+              and r["base_sha"] != git(work, "rev-parse", "origin/main"))
+-+
+-+        # The plan paused: its branch merged into main and was deleted on origin; a stale copy stays here.
+-+        git(work, "checkout", "-q", "main")
+-+        git(work, "push", "-q", "origin", "--delete", "plan/717/base")
+-+        stale = git(work, "rev-parse", "plan/717/base")
+-+        commit(work, "d"); git(work, "push", "-q", "origin", "main")
+-+        rc, r = run(work, out, "--issue", "740", "--branch-name", "plan/717/740-w", "--plan-branch", "plan/717/base")
+-+        check("a plan that starts again gets a fresh cut from main, not the stale local copy (H10)",
+-+              rc == 0 and r["plan_branch_created"]
+-+              and git(work, "rev-parse", "origin/plan/717/base") == git(work, "rev-parse", "origin/main")
+-+              and git(work, "rev-parse", "origin/plan/717/base") != stale)
+-+    print(f"\n{PASSED} passed, {FAILED} failed")
+-+    sys.exit(1 if FAILED else 0)
+++    ap = argparse.ArgumentParser()
+++    ap.add_argument("--phase", required=True, choices=["start", "close"])
+++    ap.add_argument("--marker", required=True,
+++                    help="status-marker path for the stamp (per play run)")
+++    ap.add_argument("--cwd", default=str(Path.cwd()),
+++                    help="project root the session runs in")
+++    ap.add_argument("--branch", default=None,
+++                    help="current git branch (start phase; ledger match hint)")
+++    ap.add_argument("--projects-dir",
+++                    default=str(Path.home() / ".claude" / "projects"))
+++    args = ap.parse_args()
+++    phase_start(args) if args.phase == "start" else phase_close(args)
+ +
+ +
+ +if __name__ == "__main__":
+ +    main()
