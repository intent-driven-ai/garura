++    for h in HEADINGS:
++        if h not in md:
++            problems.append(f"brief.md has no `{h}` heading")
++    return problems, {"gaps": len(gaps), "proposals": len(proposals), "pages": len(listed),
++                      "prototype_notes": feedback}
++
++
++def load(path):
++    with open(path, encoding="utf-8") as fh:
++        return json.load(fh)
++
