-            way = g.get("closed_by")
-            if way == "source":
-                ev = g.get("evidence") or []
-                if not ev or not all(str(e.get("quote") or "").strip() and str(e.get("file") or "").strip()
-                                     for e in ev):
-                    gaps.append(f"{gid}: a source answer needs a quote and the file it came from")
-            elif way == "memory":
