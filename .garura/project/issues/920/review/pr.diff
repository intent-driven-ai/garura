+    bgroups = build.get("groups") or []
+    proposals = [g.get("id") for g in bgroups if g.get("closed_by") == "proposal"]
+    updates = sorted({str(g.get("update")) for g in bgroups if g.get("closed_by") == "update"} | set(waiting))
