+def set_capability_delta(work, delta):
+    path = os.path.join(work, "enrich.yaml")
+    with open(path) as fh:
+        man = yaml.safe_load(fh)
+    man["enrich"]["capability"].update(delta)
+    with open(path, "w") as fh:
+        yaml.safe_dump(man, fh)
+
+
+def test_slug():
