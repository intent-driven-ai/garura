+{
+  "doc": ".garura/product/product-os/software-delivery-planning/initialize/capability.md",
+  "fingerprint": "fa0569e7a9d97a9b76d0e6a47cd7f999b5d25a7ad4f7a2efed396c35622548b2",
+  "passed": true,
+  "failures": [],
