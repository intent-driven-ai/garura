+{
+  "doc": ".garura/product/product-os/software-delivery-planning/initialize/fn-review-rule-groups/feature.md",
+  "fingerprint": "09b00830cb912c700abc4af3c42a498effbe68b82ca244367d718c9dd6902a16",
