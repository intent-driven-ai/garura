+# Context gathered by adr-keeper for /record-decision (issue 882), Step 2.
+shape: yaml
+id: dec-cap-initialize-security-none-medium      # fixed by the caller; the spine already links it
+replaces_thin_record: .garura/product/product-os/decisions/dec-cap-initialize-security-none-medium.yaml
+keep_from_thin_record:
+  title: kept in meaning, rewritten as a statement of the move
