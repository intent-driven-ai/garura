+{
+  "doc": ".garura/product/product-os/software-delivery-planning/initialize/fn-rerun-initialize/feature.md",
+  "fingerprint": "68e24d8075442a2189dbda0664898f52bde851b57f3aad8d870bb9fad60d210d",
