+  "kind": "capability",
+  "criteria": [
+    {"id": "completeness", "verdict": "pass", "evidence": "\"We believe that when the product owner answers one short set of questions after the Garura install, the project gets only the memory and the review rules that fit it\" \"Out: running a review and deciding its findings (the review play, /check-change, owns it).\" \"The questions are built from Phoenix memory, not written by hand.\" \"Set up the tracker's work-item types (fn-881):\"", "fix": ""},
+    {"id": "self_explanation", "verdict": "pass", "evidence": "\"Never: make an issue type in the tracker, or record a stand-in, before the product owner's typed yes. A tracker is an outside system, and a write there is visible to the whole team.\" \"One run sets up memory, review rules and tracker types from the same answers. A second set of questions for the tracker or the review would ask the person the same things twice.\" \"An empty answer there would look like \\\"nothing fits\\\" and leave the project with too little memory.\"", "fix": ""},
+    {"id": "discreteness_form", "verdict": "pass", "evidence": "\"- Ask the setup questions (fn-setup-questions): asks the product owner the short set of questions built from Phoenix memory, each with choices and a proposed answer that names its source, and keeps the confirmed answers for the other features.\" \"Fails if: a proposed answer names no source, or an answer is recorded that the person never gave.\"", "fix": ""},
+    {"id": "depth_gradient", "verdict": "pass", "evidence": "\"A memory block is the relevant part of Phoenix memory that one setup answer selects, down to the part of a file\" \"A review in the project runs only the rule groups that fit it, and the review's record names each group it skipped.\"", "fix": ""},
+    {"id": "stranger_test", "verdict": "pass", "evidence": "\"Words this page uses. Phoenix memory is the one shared memory on a machine\" \"A rule group is a set of the review's rules that check one kind of thing\" \"Out: the Garura install, which runs once per project and lays only the pieces\" \"These six jobs share one moment (the project is being set up) and one input (the product owner's answers), so they live in one capability.\"", "fix": ""}
+  ],
+  "prior": []
+}
