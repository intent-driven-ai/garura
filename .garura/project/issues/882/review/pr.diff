+  dates: metadata.date 2026-10-25 kept; metadata.decided_by /discover-capabilities kept; version 1 kept
+level: product
+node_ref: cap-initialize
+template: .garura/project/issues/_adr/20261025T135102Z/context/templates/standards/templates/adr.md
