new file mode 100644
index 000000000..3fed33cfb
--- /dev/null
+++ b/core/components/plays/drive-creator/references/drive_status.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""drive_status.py — keep the run's status file current (standards/rules/run-status.md).
+
+A drive presents what it is doing now in one small file; a display — for Claude Code, a
+plugin — reads it. The drive never displays anything itself. This script writes the file whole
+(a temporary file renamed over it), so a reader never sees half a file. Canonical copy lives at
+drive-creator/references/drive_status.py and is stamped into each drive's scripts/.
+
+    python3 drive_status.py --file <stm_base><issue>/status/run-<drive>.json \
+        [--name kickoff --issue 7 --run-id kickoff-<ts>]   # the first call
+        [--state running|asking|checking|landing|done|halted] [--round N] \
+        [--play <play>] [--step "<plain words>"] [--note "<plain words>"]
+
+Fields not given keep their last value; `updated_at` is always set to now; `started_at` is set
+on the first call. Exit 0 written; 2 bad input. Standard library only.
+"""
+import argparse
+import datetime
+import json
+import os
+import sys
+import tempfile
+
+STATES = ("running", "asking", "checking", "landing", "done", "halted")
+
+
+def now():
+    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Keep the run's status file current.")
+    ap.add_argument("--file", required=True)
+    ap.add_argument("--name")
+    ap.add_argument("--issue", type=int)
+    ap.add_argument("--run-id")
+    ap.add_argument("--state", choices=STATES)
+    ap.add_argument("--round", type=int)
+    ap.add_argument("--play")
+    ap.add_argument("--step")
+    ap.add_argument("--note")
+    args = ap.parse_args(argv)
+    status = {}
+    if os.path.isfile(args.file):
+        try:
+            with open(args.file, encoding="utf-8") as fh:
+                status = json.load(fh)
+        except (OSError, ValueError):
+            status = {}  # a broken file is replaced, never trusted
+    if not status and not (args.name and args.run_id):
+        sys.stderr.write("drive_status.py: the first call names the run (--name and --run-id)\n")
+        return 2
+    status.setdefault("kind", "drive")
+    status.setdefault("started_at", now())
+    status.setdefault("state", "running")
+    for key in ("name", "issue", "run_id", "state", "round", "play", "step", "note"):
+        value = getattr(args, key.replace("-", "_"))
+        if value is not None:
+            status[key] = value
+    status["updated_at"] = now()
+    folder = os.path.dirname(os.path.abspath(args.file))
+    os.makedirs(folder, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".run-status-")
+    with os.fdopen(fd, "w", encoding="utf-8") as fh:
+        json.dump(status, fh, indent=2)
+    os.replace(tmp, args.file)
+    print(json.dumps({k: status.get(k) for k in ("state", "round", "play", "step")}))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/core/components/plays/drive-creator/references/prepare_check.py b/core/components/plays/drive-creator/references/prepare_check.py
new file mode 100644
index 000000000..cf7b83508
--- /dev/null
+++ b/core/components/plays/drive-creator/references/prepare_check.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""prepare_check.py — build the bundle the drive's checker judges (Shared Drive Run, R6).
+
+The checker sees the drive's outputs and its criteria, never its reasoning (ADR 029 §2). This
+script gathers exactly that into one folder, so the checker — a sub-agent on another model or a
+coding agent — can be pointed at the folder and nothing else:
+
+  criteria.md            the drive's goal, constraints and Done means, cut from its ICE
+  manifest.json          criteria_ids (every id the checker must judge), issue, base, files
+  change.diff            git diff <base>..HEAD, without the issue's own run records
+  review/                each play's review record (the issue's review/drive/)
+  answers.json, answers-sources.json   the answers gathered first, and their sources
+  traces.json            the memory tool's `citations --issue <n> --check` answer
+  done/                  each play's <play>-done.json
+
+Canonical copy lives at drive-creator/references/prepare_check.py and is stamped into each
+drive's scripts/.
+
+    python3 prepare_check.py --ice <drive>/reference/ice.md --issue <n> \
+        --issue-dir <stm_base><n>/ --working <working> --base <sha> \
+        [--memory-tool .garura/core/tools/memory/memory.py] --out-dir <working>/check/
+
+Exit 0 built; 2 the ICE has no goal or criteria, or git cannot diff — nothing to judge. A
+missing piece (no review records, no memory tool) is recorded in the manifest, not hidden: the
+checker fails a criterion that needs it. Standard library only.
+"""
+import argparse
+import glob
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+
+
+def section(text, title, level=2):
+    """Body under a `#… <title>` header, up to the next header of the same or higher level."""
+    m = re.search(rf"(?m)^#{{{level}}}\s+{re.escape(title)}\b.*$", text)
+    if not m:
+        return ""
+    rest = text[m.end():]
+    nxt = re.search(rf"(?m)^#{{1,{level}}}\s", rest)
+    return rest[: nxt.start()] if nxt else rest
+
+
+def criteria_of(ice_text):
+    """(criteria markdown, ids): the goal as G, the constraints C-n, the Done means D-n."""
+    intent = section(ice_text, "Intent")
+    goal = re.search(r"\*\*Goal:\*\*\s*(.+?)(?:\n\s*\n|$)", intent, re.S)
+    constraints = section(intent, "Constraints", 3)
+    done = section(section(ice_text, "Expectation"), "Done means", 3) or section(ice_text, "Done means", 3)
+    ids = (["G"] if goal else []) + sorted(set(re.findall(r"(?m)^-\s*(C\d+)\b", constraints)),
+                                           key=lambda x: int(x[1:]))
+    ids += sorted(set(re.findall(r"(?m)^-\s*(D\d+)\b", done)), key=lambda x: int(x[1:]))
+    text = "# Criteria\n\nJudge every id below.\n\n"
+    if goal:
+        text += f"## G — the goal\n\n{' '.join(goal.group(1).split())}\n\n"
+    text += f"## Constraints\n{constraints.rstrip()}\n\n## Done means\n{done.rstrip()}\n"
+    return text, ids
+
+
+def run(cmd):
+    return subprocess.run(cmd, capture_output=True, text=True)
+
+
+def build(args):
+    with open(args.ice, encoding="utf-8") as fh:
+        text, ids = criteria_of(fh.read())
+    if "G" not in ids or len(ids) < 2:
+        raise ValueError("the ICE has no goal, or no constraints and no Done means, to judge")
+    out = args.out_dir
+    if os.path.isdir(out):
+        shutil.rmtree(out)
+    os.makedirs(os.path.join(out, "review"))
+    os.makedirs(os.path.join(out, "done"))
+    missing = []
+    with open(os.path.join(out, "criteria.md"), "w", encoding="utf-8") as fh:
+        fh.write(text)
+
+    issue_dir = args.issue_dir.rstrip("/")
+    diff = run(["git", "diff", f"{args.base}..HEAD", "--", ".", f":(exclude){issue_dir}"])
+    if diff.returncode != 0:
+        raise ValueError(f"git diff failed: {diff.stderr.strip()}")
+    with open(os.path.join(out, "change.diff"), "w", encoding="utf-8") as fh:
+        fh.write(diff.stdout)
+
+    reviews = sorted(glob.glob(os.path.join(issue_dir, "review", "drive", "*")))
+    for path in reviews:
+        if os.path.isfile(path):
+            shutil.copy(path, os.path.join(out, "review", os.path.basename(path)))
+    if not reviews:
+        missing.append("review records")
+    for name in ("answers.json", "answers-sources.json"):
+        src = os.path.join(args.working, name)
+        if os.path.isfile(src):
+            shutil.copy(src, os.path.join(out, name))
+        else:
+            missing.append(name)
+    for path in sorted(glob.glob(os.path.join(args.working, "*-done.json"))):
+        shutil.copy(path, os.path.join(out, "done", os.path.basename(path)))
+    if not os.listdir(os.path.join(out, "done")):
+        missing.append("done checks")
+
+    traces = {"ok": False, "why": "the memory tool is not installed"}
+    if args.memory_tool and os.path.isfile(args.memory_tool):
+        t = run([sys.executable, args.memory_tool, "citations", "--issue", str(args.issue), "--check"])
+        try:
+            traces = json.loads(t.stdout.splitlines()[0]) if t.stdout.strip() else {
+                "ok": False, "why": t.stderr.strip()[-500:]}
+        except ValueError:
+            traces = {"ok": False, "why": "the memory tool's answer could not be read"}
+    else:
+        missing.append("decision-trace check")
+    with open(os.path.join(out, "traces.json"), "w", encoding="utf-8") as fh:
+        json.dump(traces, fh, indent=2)
+
+    files = sorted(os.path.relpath(os.path.join(d, f), out)
+                   for d, _, fs in os.walk(out) for f in fs)
+    manifest = {"criteria_ids": ids, "issue": args.issue, "base": args.base,
+                "files": files + ["manifest.json"], "missing": missing}
+    with open(os.path.join(out, "manifest.json"), "w", encoding="utf-8") as fh:
+        json.dump(manifest, fh, indent=2)
+    return manifest
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Build the drive checker's bundle.")
+    ap.add_argument("--ice", required=True)
+    ap.add_argument("--issue", required=True, type=int)
+    ap.add_argument("--issue-dir", required=True)
+    ap.add_argument("--working", required=True, help="the drive's run folder")
+    ap.add_argument("--base", required=True, help="the commit the drive's branch was cut from")
+    ap.add_argument("--memory-tool", default=".garura/core/tools/memory/memory.py")
+    ap.add_argument("--out-dir", required=True)
+    args = ap.parse_args(argv)
+    try:
+        manifest = build(args)
+    except (OSError, ValueError) as exc:
+        sys.stderr.write(f"prepare_check.py: {exc} — nothing to judge\n")
+        return 2
+    print(json.dumps({"bundle": args.out_dir, "criteria_ids": manifest["criteria_ids"],
+                      "missing": manifest["missing"]}))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/core/components/plays/drive-creator/references/record_check.py b/core/components/plays/drive-creator/references/record_check.py
new file mode 100644
index 000000000..986dc3061
--- /dev/null
+++ b/core/components/plays/drive-creator/references/record_check.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""record_check.py — check the checker's verdict and write the drive's check.yaml (R6).
+
+Whichever checker ran (a sub-agent on another model, or a coding agent), its verdict is JSON in
+the shape `judge-drive-result` defines. This script checks that shape against the bundle's
+manifest — every criterion judged, no other, each with evidence, the verdict agreeing with the
+criteria, a reason for each failure — and writes `check.yaml`, the file the drive's stop
+condition reads. Canonical copy lives at drive-creator/references/record_check.py and is
+stamped into each drive's scripts/.
+
+    python3 record_check.py --verdict <working>/check/verdict.json \
+        --manifest <working>/check/manifest.json --kind subagent|coding-agent [--model M] \
+        --out <working>/check.yaml
+
+Exit 0 pass; 1 reject (the drive halts: checker_reject); 2 the verdict is missing or does not
+match the shape — never a pass (the drive halts). Standard library only.
+"""
+import argparse
+import json
+import os
+import sys
+
+
+class Bad(Exception):
+    """Why the verdict cannot be used, in plain words."""
+
+
+def check(verdict, ids):
+    if not isinstance(verdict, dict):
+        raise Bad("the verdict is not a JSON object")
+    if verdict.get("verdict") not in ("pass", "reject"):
+        raise Bad("`verdict` must be pass or reject")
+    crit = verdict.get("criteria")
+    if not isinstance(crit, list):
+        raise Bad("`criteria` must be a list")
+    seen = {}
+    for c in crit:
+        if not isinstance(c, dict) or c.get("result") not in ("pass", "fail"):
+            raise Bad("each criterion needs a result of pass or fail")
+        if not str(c.get("evidence", "")).strip():
+            raise Bad(f"criterion {c.get('id')} has no evidence")
+        seen[str(c.get("id"))] = c["result"]
+    if sorted(seen) != sorted(ids):
+        lacking = sorted(set(ids) - set(seen))
+        extra = sorted(set(seen) - set(ids))
+        raise Bad("the criteria judged do not match the criteria asked"
+                  + (f"; not judged: {', '.join(lacking)}" if lacking else "")
+                  + (f"; not asked: {', '.join(extra)}" if extra else ""))
+    failed = sorted(i for i, r in seen.items() if r == "fail")
+    if verdict["verdict"] == "pass" and failed:
+        raise Bad(f"the verdict says pass, but these failed: {', '.join(failed)}")
+    if verdict["verdict"] == "reject":
+        if not failed:
+            raise Bad("the verdict says reject, but no criterion failed")
+        reasons = [r for r in verdict.get("reasons") or [] if str(r).strip()]
+        if not reasons:
+            raise Bad("a reject must give its reasons")
+    return failed
+
+
+def as_yaml(verdict, kind, model, failed):
+    q = json.dumps  # a JSON string is a valid YAML scalar
+    lines = [f"verdict: {verdict['verdict']}", "checker:", f"  kind: {kind}",
+             f"  model: {q(model) if model else 'null'}", "criteria:"]
+    for c in verdict["criteria"]:
+        lines += [f"  - id: {q(str(c['id']))}", f"    result: {c['result']}",
+                  f"    evidence: {q(str(c['evidence']))}"]
+    lines.append("failed: [" + ", ".join(q(f) for f in failed) + "]")
+    lines.append("reasons:" + ("" if verdict.get("reasons") else " []"))
+    lines += [f"  - {q(str(r))}" for r in verdict.get("reasons") or []]
+    return "\n".join(lines) + "\n"
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Record the drive checker's verdict.")
+    ap.add_argument("--verdict", required=True)
+    ap.add_argument("--manifest", required=True)
+    ap.add_argument("--kind", required=True, choices=("subagent", "coding-agent"))
+    ap.add_argument("--model")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    try:
+        with open(args.manifest, encoding="utf-8") as fh:
+            ids = [str(i) for i in json.load(fh)["criteria_ids"]]
+        with open(args.verdict, encoding="utf-8") as fh:
+            verdict = json.load(fh)
+        failed = check(verdict, ids)
+    except (OSError, ValueError, KeyError, Bad) as why:
+        msg = why if isinstance(why, Bad) else f"cannot read the verdict: {why.__class__.__name__}"
+        sys.stderr.write(f"record_check.py: {msg} — not a pass\n")
+        return 2
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    with open(args.out, "w", encoding="utf-8") as fh:
+        fh.write(as_yaml(verdict, args.kind, args.model, failed))
+    print(json.dumps({"verdict": verdict["verdict"], "failed": failed}))
+    return 0 if verdict["verdict"] == "pass" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
