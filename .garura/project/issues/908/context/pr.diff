+        code, out, _ = run("check-list", "--before", before, "--list", ok_list, "--evals", evals,
+                           "--out", os.path.join(work, "lc-e.json"))
+        check("check-list --evals: an eval file named by its name in the listing holds", code == 0)
+        named["out_of_date"] = [{"record": "eval.ft-none.feature.md", "why": "made up"}]
+        bad_list = write(os.path.join(work, "named-bad.json"), json.dumps(named))
+        code, out, _ = run("check-list", "--before", before, "--list", bad_list, "--evals", evals,
+                           "--out", os.path.join(work, "lc-e2.json"))
+        check("check-list --evals: an eval file that is not the slice's is refused (exit 1)",
+              code == 1 and "not one of the slice's eval files" in " ".join(out["problems"]))
+        named_req = write(os.path.join(work, "named-request.md"), "Ask Jo Bloggs: F1 should go to a person.\n")
+        code, out, _ = run("check-list", "--before", before, "--list", two, "--request", named_req,
+                           "--forbid-name", "Jo Bloggs", "--out", os.path.join(work, "lc-n.json"))
+        check("check-list --forbid-name: words that name a real person are refused (exit 1)",
+              code == 1 and "say it as a role" in " ".join(out["problems"]))
+        code, out, _ = run("check-list", "--before", before, "--list", two, "--request", req,
+                           "--forbid-name", "Jo Bloggs", "--out", os.path.join(work, "lc-n2.json"))
+        check("check-list --forbid-name: words with no name hold", code == 0)
+        code, out, _ = run("apply", "--before", before, "--list", two, "--request", req,
+                           "--by", "the product owner", "--at", "2026-10-27",
+                           "--out", os.path.join(work, "apply.json"))
+        text = read(hidden)
+        check("apply: the two named lines change, F2 stays with the builder",
+              code == 0 and text.count("Who fixes: a person must decide") == 2
+              and text.count("Who fixes: the builder can fix this alone") == 1)
+        check("apply: the hidden file holds a history line with the person's words",
+              "Edited on 2026-10-27 by the product owner" in text and "F1 and F3 should go to a person." in text)
+        rec = yaml.safe_load(read(os.path.join(root, "slices", "sl-self.yaml")))
+        check("apply: the slice record holds a history entry, and nothing else of it changed",
