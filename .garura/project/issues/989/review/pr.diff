+    def test_after_the_merge_main_s_plan_file_is_the_branch_s(self):
+        self.on_main("plans/50.yaml", PLAN.replace("People pay without an account", "People pay as guests"),
+                     "retitle on main")
+        self.ready()
+        sh(["git", "commit", "--quiet", "-am", "raise"], self.repo)
