+    taxonomy_row: none (bucket definition)
+
+  - id: M5
+    severity: P3
+    file: "core/components/memory/tools/github/adapter.md (paired file not changed: core/components/memory/tools/gitlab/adapter.md)"
+    lines: "view-issue section"
+    principle: "G5 - GitHub and GitLab tool docs mirror platform differences for each verb."
+    basis: >
