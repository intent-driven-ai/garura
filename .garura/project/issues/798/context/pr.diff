+      ],
+      "from_record": [
+        "Q-flag-1",
+        "Q-builders-1"
+      ]
+    },
+    {
+      "question": "In which order are the features built?",
+      "answer": "fn-795, then fn-818, then fn-798, then fn-898, the order the slice already has: /shape-plan runs after /shape-slice, and /shape-eval after /shape-plan; the check of fn-898 comes last.",
