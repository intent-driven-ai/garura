+{
+  "id": "sl-intent-to-design",
+  "slug": "intent-to-design",
+  "name": "Name a business intent, and three plays write its slice, plan and eval",
+  "outcome": "The product owner runs three plays on a business intent and gets a slice to test, a plan with one epic and one story for each feature, and an eval that no build is given; a check flags each build session that read the evals folder, and the flag is recorded in that build run's evidence.",
+  "feature_refs": [
+    "fn-795",
+    "fn-818",
+    "fn-798",
+    "fn-898"
+  ],
+  "vertical": "the Claude Code command line",
+  "intents": [
+    "bi-788"
+  ],
+  "surface": {
+    "id": "surf-claude-code-cli",
+    "name": "the Claude Code command line",
+    "persona_ref": "product-owner",
+    "user_action": "runs /shape-slice, then /shape-plan, then /shape-eval on a business intent, then runs the check that shows no build play's inputs name the evals folder, and finds the flag of a build session that read it in that build run's evidence"
+  },
+  "why_this_order": "The slice must exist before its plan, and the plan's epic and stories before the eval that reads them. The check of fn-898 comes last, because it can only be tested when the evals folder holds an eval that a build must not be given.",
+  "left_out": [
+    {
+      "what": "Running the eval after the build (also on Griffin)",
+      "why": "fn-798 lists it as out of scope (fn-798/feature.md line 29), and the shape-eval capability's ICE puts running the eval out (shape-eval/capability.md line 27); the eval runner is a later play (#819)."
+    },
+    {
+      "what": "Blocking a read of the evals folder by a hook (#893)",
+      "why": "fn-898's check only flags the read and does not block it; blocking is the guardrails work (#893), out of scope on fn-898's page (fn-898/feature.md lines 16 and 28)."
+    },
+    {
+      "what": "Encrypting the eval (#828)",
+      "why": "The product owner dropped encryption and closed #828 on 2026-10-26: the eval stays in plain text, and the build is given the business intent through the stories, never the eval (ADR 057, section 7)."
+    },
+    {
+      "what": "Showing the flag anywhere other than the build run's evidence: in the run's close report, or as drift checks and evidence warnings in Griffin",
+      "why": "The product owner said the flag is recorded in the build run's evidence for now, and that the drift checks and evidence warnings that show it will be built in Griffin later (Q-flag-1, #798)."
+    },
+    {
+      "what": "Changing the proof line of business intent 788 that says no builder can read the eval",
+      "why": "This slice changes no word of a confirmed intent page except its Touches list. The proof line already says the new words the product owner said yes to (Q-proof-1, #798; bi-788.md line 16): the play that owns the intent page wrote it before this run."
+    },
+    {
+      "what": "The design, build, test or validation of an epic (#819)",
+      "why": "The intent's Must not excludes it (bi-788.md line 18); so the slice has no build play of its own, and the check of fn-898 treats every play, skill and agent that builds the software, and every context sub-agent it starts, as a build play; only /shape-slice, /shape-eval and the eval may name the evals folder (Q-builders-1, #798)."
+    },
+    {
+      "what": "Changing the eval files that /shape-eval wrote in run 1",
+      "why": "The eval is a fixed yardstick, and the product owner said a later /shape-eval names the moved story lines for a person (Q5 of the #798 run 2 change, run2/change.md line 3); this run changes hidden-file entries only (change.md line 5)."
+    }
+  ],
+  "decisions": [
+    {
+      "question": "Which features does the slice hold?",
+      "answer": "fn-795, fn-818, fn-798 and fn-898, kept as they are in the slice: the product owner's run 3 change keeps the slice sl-intent-to-design as run 2 left it. fn-898 serves the answers to Q-flag-1 and Q-builders-1.",
