+        rec_md = os.path.join(work, "grounding-questions.md")
+        write(os.path.join(work, "reply.md"), "yes\n")
+        for _ in range(2):
+            r = subprocess.run([sys.executable, os.path.join(HERE, "record_questions.py"), "edit",
+                                "--record", rec_md, "--issue", "908", "--request", req,
