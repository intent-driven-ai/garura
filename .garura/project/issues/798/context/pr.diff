@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""
+session_stamp.py — the session identity stamp (#463).
+
+Binds a play run to the exact slice of the Claude Code session ledger that
+produced it, so spend and behavior are computable OFFLINE (token-burn-dash)
+with zero in-run cost. No parsing, no summing: one directory listing, one
+line read, one file size.
+
+The ledger: Claude Code writes one JSONL per session under
+~/.claude/projects/<cwd-slug>/<session-id>.jsonl. Every line carries
+sessionId and gitBranch; assistant lines carry token usage. This script
+never reads more than the last line of a candidate file.
+
+Phases (mirrors the status-marker lifecycle):
+    --phase start  → resolve the live session (prefer the ledger whose last
+                     line's gitBranch matches --branch, else newest mtime),
+                     write {session_id, ledger_file, start_offset, started_at}
+                     to --marker.
+    --phase close  → read --marker, take the ledger's current size as
+                     end_offset, emit the stamp JSON to stdout (the play close
+                     copies the fields into the evidence frontmatter).
+
+Failures are soft: a missing ledger yields a stamp with
+nulls and "ledger_resolved": false — the close never blocks on the stamp.
+"""
+
+import argparse
+import json
+import sys
+import time
+from pathlib import Path
+
+
+def cwd_slug(cwd):
+    return "".join(ch if ch.isalnum() else "-" for ch in str(cwd))
+
+
+def last_line(path, max_tail=65536):
+    """Read the final line of a (possibly large) file without loading it."""
+    try:
+        with open(path, "rb") as fh:
+            fh.seek(0, 2)
+            size = fh.tell()
+            fh.seek(max(0, size - max_tail))
+            tail = fh.read().decode("utf-8", errors="replace")
+        lines = [line for line in tail.strip().splitlines() if line.strip()]
+        return json.loads(lines[-1]) if lines else None
+    except Exception:
+        return None
+
+
+def resolve_ledger(projects_dir, cwd, branch):
+    """The live session's ledger: prefer last-line gitBranch == branch,
+    fall back to newest mtime. Returns (path, session_id) or (None, None)."""
+    slug_dir = Path(projects_dir) / cwd_slug(cwd)
+    if not slug_dir.is_dir():
+        return None, None
+    candidates = sorted(slug_dir.glob("*.jsonl"),
+                        key=lambda p: p.stat().st_mtime, reverse=True)
+    newest = None
+    for p in candidates[:10]:  # only recent files can be the live session
+        rec = last_line(p)
+        if rec is None:
+            continue
+        sid = rec.get("sessionId")
+        if newest is None and sid:
+            newest = (p, sid)
+        if branch and rec.get("gitBranch") == branch and sid:
+            return p, sid
+    return newest if newest else (None, None)
+
+
+def phase_start(args):
+    ledger, session_id = resolve_ledger(args.projects_dir, args.cwd, args.branch)
+    marker = {
+        "ledger_resolved": ledger is not None,
+        "session_id": session_id,
+        "ledger_file": str(ledger) if ledger else None,
+        "start_offset": ledger.stat().st_size if ledger else None,
+        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+    }
+    Path(args.marker).parent.mkdir(parents=True, exist_ok=True)
+    with open(args.marker, "w", encoding="utf-8") as fh:
+        json.dump(marker, fh, indent=2)
+    print(json.dumps(marker, indent=2))
+
+
+def phase_close(args):
+    try:
+        with open(args.marker, "r", encoding="utf-8") as fh:
+            marker = json.load(fh)
+    except Exception:
+        marker = {"ledger_resolved": False, "session_id": None,
+                  "ledger_file": None, "start_offset": None}
+    ledger = marker.get("ledger_file")
+    end_offset = None
+    if ledger and Path(ledger).exists():
+        end_offset = Path(ledger).stat().st_size
+    stamp = {
+        "ledger_resolved": bool(marker.get("ledger_resolved") and end_offset is not None),
+        "session_id": marker.get("session_id"),
+        "ledger_file": ledger,
+        "ledger_start_offset": marker.get("start_offset"),
+        "ledger_end_offset": end_offset,
+    }
+    print(json.dumps(stamp, indent=2))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--phase", required=True, choices=["start", "close"])
+    ap.add_argument("--marker", required=True,
+                    help="status-marker path for the stamp (per play run)")
+    ap.add_argument("--cwd", default=str(Path.cwd()),
+                    help="project root the session runs in")
+    ap.add_argument("--branch", default=None,
+                    help="current git branch (start phase; ledger match hint)")
+    ap.add_argument("--projects-dir",
+                    default=str(Path.home() / ".claude" / "projects"))
+    args = ap.parse_args()
+    phase_start(args) if args.phase == "start" else phase_close(args)
+
+
+if __name__ == "__main__":
+    main()
+    sys.exit(0)
diff --git a/core/components/plays/shape-eval/scripts/test_shape_eval_scripts.py b/core/components/plays/shape-eval/scripts/test_shape_eval_scripts.py
--- /dev/null
+++ b/core/components/plays/shape-eval/scripts/test_shape_eval_scripts.py
@@ -0,0 +1,518 @@
+#!/usr/bin/env python3
+"""test_shape_eval_scripts.py — the /shape-eval scripts: gather, input check, place, eval file check, summary (#798).
+
+    python3 test_shape_eval_scripts.py
+"""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+LIB = os.path.normpath(os.path.join(HERE, "..", "..", "..", "memory", "standards", "schemas", "eval",
+                                    "steps-command-line.yaml"))
+PASSED = 0
+FAILED = 0
+
+
+def check(name, cond):
+    global PASSED, FAILED
+    if cond:
+        PASSED += 1
+        print(f"  [PASS] {name}")
+    else:
+        FAILED += 1
+        print(f"  [FAIL] {name}")
+    return cond
+
+
+def run(script, *args):
+    p = subprocess.run([sys.executable, os.path.join(HERE, script), *args], capture_output=True, text=True)
+    try:
+        out = json.loads(p.stdout) if p.stdout.strip() else None
+    except json.JSONDecodeError:
+        out = None
+    return p.returncode, out, p.stderr
+
+
+def write(path, text):
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    with open(path, "w", encoding="utf-8") as fh:
+        fh.write(text if isinstance(text, str) else json.dumps(text, indent=2))
+    return path
+
+
+def read(path):
+    with open(path, encoding="utf-8") as fh:
+        return fh.read()
+
+
+STORY = """Feature: {name}
+
+## Scope of work
+
+Goals:
+- {goal}
+
+Limits:
+- Write only the booking.
+
+Expectations:
+- {exp1}
+- {exp2}
+
+## Context guidance
+
+- Read: the booking page.
+- Never read: the code.
+- Persona: the patient.
+- In and out: booking is in; payment is out.
+"""
+
+HIDDEN = """# Failure and recovery: slice sl-self-booking
+
+Slice: Self booking (sl-self-booking). Plan: 1 (business intent bi-1). Surface: the booking command line; tested by the patient.
+
+## fn-pick: Pick a free slot
+
+### Failure conditions
+
+- F1 (from the feature ICE): a slot is booked twice.
+
+### Recovery
+
+- For F1
+  - When: two bookings are on one slot.
+  - Way back: keep the first booking, free the second, tell the second patient.
+  - Who fixes: the builder can fix this alone
+
+## fn-remind: Send a reminder
+
+### Failure conditions
+
+- F2 (from the feature ICE): a reminder goes to the wrong patient.
+
+### Recovery
+
+- For F2
+  - When: a patient gets a reminder for a visit that is not theirs.
+  - Way back: send the reminder only to the patient of the booking.
+  - Who fixes: a person must decide
+"""
+
+
+def project(tmp, features=(("fn-pick", 3), ("fn-remind", 4)), surface=None):
+    plans = os.path.join(tmp, "plans")
+    write(os.path.join(plans, "1.yaml"),
+          "id: 1\ntitle: Patients book their own visits\nstatus: active\ntree:\n"
+          "- issue: 2\n  kind: epic\n  represents: sl-self-booking\n  title: Self booking\n")
+    hidden = HIDDEN if surface is None else HIDDEN.replace("the booking command line", surface)
+    write(os.path.join(plans, "1", "evals", "self-booking", "failure-and-recovery.md"), hidden)
+    epic = "Delivers: a patient books a slot.\n\n## Feature-to-story map\n\n" + "".join(
+        f"- {f} → #{n}\n" for f, n in features)
+    issues = [{"number": 2, "title": "Self booking", "body": epic},
+              {"number": 3, "title": "Pick a free slot",
+               "body": STORY.format(name="pick", goal="A patient books a free slot.",
+                                    exp1="The booking shows as booked.", exp2="The slot is gone from the list.")},
+              {"number": 4, "title": "Send a reminder",
+               "body": STORY.format(name="remind", goal="A patient gets a reminder.",
+                                    exp1="The reminder names the visit.", exp2="It is sent one day before.")},
+              {"number": 5, "title": "Cancel online",
+               "body": STORY.format(name="cancel", goal="A patient cancels.", exp1="The slot is free.",
+                                    exp2="The patient gets a note.")}]
+    tracker = write(os.path.join(tmp, "tracker.json"), {"issues": issues})
+    working = os.path.join(tmp, "work")
+    os.makedirs(working, exist_ok=True)
+    return plans, tracker, working
+
+
+LINES = {3: {"goal-1": "A patient books a free slot.", "expectation-1": "The booking shows as booked.",
+             "expectation-2": "The slot is gone from the list."},
+         4: {"goal-1": "A patient gets a reminder.", "expectation-1": "The reminder names the visit.",
+             "expectation-2": "It is sent one day before."},
+         5: {"goal-1": "A patient cancels.", "expectation-1": "The slot is free.", "expectation-2": "The patient gets a note."}}
+
+
+def story_draft(feature, issue, scenarios, untestable="", covered=None):
+    import re as _re
+    tags = sorted({t for t in _re.findall(r"`@((?:goal|expectation)-\d+)`", scenarios)})
+    covered = covered if covered is not None else {t: LINES.get(issue, {}).get(t, "?") for t in tags}
+    cov = "".join(f"- `@{t}`: {x}\n" for t, x in covered.items())
+    return (f"`@story-{issue}`\n# Feature: Story #{issue} — {feature}\n\nFeature {feature} of slice sl-self-booking.\n\n"
+            "## Background:\n* Given [the clinic] is set up\n\n" + scenarios
+            + (f"\n## Untestable\n\n{untestable}" if untestable else "")
+            + (f"\n## Lines covered\n\n{cov}" if cov else ""))
+
+
+PICK = """`@goal-1` `@expectation-1`
+## Scenario: a patient books a free slot
+* When I run [the book command] and answer "10:00"
+* Then the exit code is 0
+* And the output contains "booked"
+
+`@expectation-2`
+## Scenario: the slot leaves the list
+* When I run [the list command]
+* Then the output does not contain "10:00"
+
+`@F1`
+## Scenario: a slot is not booked twice
+* Given the file "bookings.json" holds "[]"
+* When I run [the book command] and answer "10:00"
+* And I run [the book command] and answer "10:00"
+* Then the file "bookings.json" field "slots.10:00" has 1 items
+"""
+
+REMIND = """`@goal-1` `@expectation-1`
+## Scenario: the reminder names the visit
+* When I run [the remind command]
+* Then the output contains "10:00"
+
+`@F2`
+## Scenario: the reminder goes only to the patient of the booking
+* When I run [the remind command]
+* Then the output does not contain "another patient"
+"""
+
+SLICE = """# Eval: slice sl-self-booking — epic #2
+
+Plan 1, business intent "Patients book their own visits" (#1).
+Surface: the booking command line
+Surface kind: command-line
+Time limit for each scenario: 120 seconds
+
+## Pass rule
+
+The eval passes only when every scenario of every story below passes.
+
+## Stories, in build order
+
+{stories}
+{out}
+## Names
+
+- [the clinic]: a test clinic with one doctor and free slots.
+- [the book command]: the command that books a slot.
+- [the list command]: the command that lists free slots.
+- [the remind command]: the command that sends reminders.
+
+## Context
+
+- Read: the booking page.
+"""
+
+
+def drafts(working, pick=PICK, remind=REMIND, untestable="- `@expectation-2`: it is sent one day before, and the eval cannot wait a day.\n",
+           order=(("fn-pick", 3), ("fn-remind", 4)), out=""):
+    d = os.path.join(working, "drafts", "self-booking")
+    if os.path.isdir(d):
+        shutil.rmtree(d)
+    write(os.path.join(d, "eval.fn-pick.feature.md"), story_draft("fn-pick", 3, pick))
+    write(os.path.join(d, "eval.fn-remind.feature.md"), story_draft("fn-remind", 4, remind, untestable))
+    stories = "\n".join(f"{i}. Story #{n} ({f}) — eval.{f}.feature.md" for i, (f, n) in enumerate(order, 1))
+    write(os.path.join(d, "eval.sl-self-booking.md"), SLICE.format(stories=stories, out=out))
+    return os.path.join(working, "drafts")
+
+
+def gather(plans, tracker, working):
+    return run("gather_eval.py", "--plan-file", os.path.join(plans, "1.yaml"), "--plans", plans,
+               "--library", LIB, "--tracker-file", tracker, "--working", working,
+               "--out", os.path.join(working, "inputs.json"))
+
+
+def place(working, d):
+    return run("place_eval.py", "--inputs", os.path.join(working, "inputs.json"), "--drafts", d,
+               "--out", os.path.join(working, "place.json"),
+               "--yardstick-out", os.path.join(working, "yardstick-check.json"))
+
+
+def evalcheck(working):
