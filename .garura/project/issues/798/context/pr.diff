--- /dev/null
+++ b/core/components/plays/shape-eval/scripts/check_stop_condition.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""
+check_stop_condition.py — evaluate a play's baked stop condition (#464).
+
+A play ends because "done" was PROVEN, not because its step list ran out.
+The proof is this script: it reads the play's compiled stop-condition
+manifest (stop-condition.yaml, baked by create-play from the ICE's
+"### Done means" section) and evaluates every clause against what actually
+exists on disk at close. Pure assertions — it executes nothing, so the
+close gate stays instant and side-effect-free (implement's hand-built
+check_done.py pattern, made play-agnostic).
+
+Clause types (mechanical, closed set):
+    artifact_exists     {path}                       — glob ok, ≥1 match
+    field_equals        {file, field, equals}        — dot-path into JSON/YAML
+    gate_outcomes_pass  {file}                       — check-quality-gates output: ok == true
+
+Manifest shape (content.done is the clause list):
+    schema: {name: stop-condition}
+    content:
+      done:
+        - id: D1
+          says: "the commits exist and the tree is clean"   # human sentence
+          check: {type: artifact_exists, path: "...commits.yaml"}
+
+Usage:
+    python3 check_stop_condition.py --manifest <stop-condition.yaml> \
+        --base <run/STM root for relative paths> --out <verdict.yaml>
+
+Verdict: {stop_condition: held|unmet, clauses: [{id, says, status, detail}]}
+Exit 0 held, 1 unmet, 2 manifest/clause error (an unevaluable clause is an
+error, never a silent pass — the check-quality-gates rule, reused).
+"""
+
+import argparse
+import glob
+import json
+import os
+import sys
+
+try:
+    import yaml
+except ImportError:
+    print("PyYAML required: pip install pyyaml", file=sys.stderr)
+    sys.exit(2)
+
+
+def load_doc(path):
+    with open(path, "r", encoding="utf-8") as fh:
+        if path.endswith(".json"):
+            return json.load(fh)
+        return yaml.safe_load(fh)
+
+
+def dot_get(doc, field):
+    cur = doc
+    for part in field.split("."):
+        if isinstance(cur, list):
+            cur = cur[int(part)]
+        elif isinstance(cur, dict) and part in cur:
+            cur = cur[part]
+        else:
+            return None, False
+    return cur, True
+
+
+def eval_clause(clause, base):
+    check = clause.get("check") or {}
+    ctype = check.get("type")
+    try:
+        if ctype == "artifact_exists":
+            pattern = os.path.join(base, check["path"])
+            hits = glob.glob(pattern)
+            return ("held" if hits else "unmet",
+                    f"{len(hits)} match(es) for {check['path']}")
+        if ctype == "field_equals":
+            fpath = os.path.join(base, check["file"])
+            if not os.path.exists(fpath):
+                return "unmet", f"file missing: {check['file']}"
+            value, found = dot_get(load_doc(fpath), check["field"])
+            if not found:
+                return "unmet", f"field missing: {check['field']}"
+            ok = value == check["equals"]
+            return ("held" if ok else "unmet",
+                    f"{check['field']} = {value!r} (want {check['equals']!r})")
+        if ctype == "gate_outcomes_pass":
+            fpath = os.path.join(base, check["file"])
+            if not os.path.exists(fpath):
+                return "unmet", f"gate outcomes missing: {check['file']}"
+            doc = load_doc(fpath)
+            ok = bool(doc.get("ok"))
+            counts = doc.get("counts", {})
+            return ("held" if ok else "unmet", f"gates ok={ok} counts={counts}")
+        return "error", f"unknown check type: {ctype!r}"
+    except Exception as exc:  # noqa: BLE001 — an unevaluable clause is an error
+        return "error", f"clause evaluation failed: {exc}"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--manifest", required=True)
+    ap.add_argument("--base", required=True,
+                    help="root for the manifest's relative paths (the run's STM)")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    doc = load_doc(args.manifest) or {}
+    clauses = (doc.get("content") or {}).get("done") or []
+    if not clauses:
+        verdict = {"stop_condition": "error",
+                   "clauses": [],
+                   "detail": "manifest has no content.done clauses"}
+        code = 2
+    else:
+        results = []
+        for c in clauses:
+            status, detail = eval_clause(c, args.base)
+            results.append({"id": c.get("id"), "says": c.get("says"),
+                            "status": status, "detail": detail})
+        if any(r["status"] == "error" for r in results):
+            overall, code = "error", 2
+        elif all(r["status"] == "held" for r in results):
+            overall, code = "held", 0
+        else:
+            overall, code = "unmet", 1
+        verdict = {"stop_condition": overall, "clauses": results}
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    with open(args.out, "w", encoding="utf-8") as fh:
+        yaml.safe_dump(verdict, fh, sort_keys=False)
+    print(json.dumps(verdict, indent=2))
+    sys.exit(code)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/core/components/plays/shape-eval/scripts/eval_common.py b/core/components/plays/shape-eval/scripts/eval_common.py
--- /dev/null
+++ b/core/components/plays/shape-eval/scripts/eval_common.py
@@ -0,0 +1,400 @@
+#!/usr/bin/env python3
+"""eval_common.py — the parts the /shape-eval scripts share.
+
+Not run on its own. The scripts beside it import it for six jobs:
+
+  - Safe writes. `atomic_write` and `write_json` write through a temp file in the same folder,
+    then move it into place with os.replace, so a run that stops half way never leaves half a
+    file.
+  - The tracker, read only. `open_tracker` gives a file tracker (`--tracker-file <json>`, for
+    tests and dry runs: {"issues": [{"number", "title", "body"}]}) or the code host, reached only
+    through platform_adapter.py's `view-issue` verb. Both have `get(number)`.
+  - A story's text. `parse_story` reads the "Scope of work" section that /shape-plan writes
+    (the "Goals:", "Limits:" and "Expectations:" lists) and the "Context guidance" section.
+    `parse_map` reads an epic's "Feature-to-story map" (`- fn-795 → #795`), in its order.
+  - The hidden file. `parse_hidden` reads the slice's failure-and-recovery.md: the slice id of
+    its first heading, its Surface line, each feature's failure conditions (`F<n>`) and the text
+    of every recovery line, which must never reach an eval.
+  - The step library of a surface kind (`standards/schemas/eval/steps-<kind>.yaml`).
+    `load_library` turns each sentence into a pattern; `match_step` says which sentence a step
+    is, or None.
+  - The eval files. `parse_story_file` reads a story file (Markdown with Gherkin, the
+    `eval-story.feature.md` template): its tags, its `Feature:` title, its Background, each
+    Scenario with its tags, steps and raw text, its Untestable lines and its Lines covered list
+    (the text of each story line a tag covers, as the file recorded it). `parse_slice_file`
+    reads the slice file (`eval-slice.md`).
+
+No judgment is made here: every rule is fixed.
+"""
+
+import json
+import os
+import re
+import tempfile
+
+try:
+    import yaml
+except ImportError:  # the scripts say so in plain words
+    yaml = None
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+RECOVERY_WORDS = ("the builder can fix this alone", "a person must decide", "way back:", "who fixes:")
+
+
+class Refused(Exception):
+    """A refusal or bad input: the script writes nothing and exits 2."""
+
+
+# ---- files ------------------------------------------------------------------------------
+
+def atomic_write(path, text):
+    folder = os.path.dirname(os.path.abspath(path))
+    os.makedirs(folder, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".tmp-", suffix=os.path.basename(path))
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            fh.write(text)
+        os.replace(tmp, path)
+    except BaseException:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+        raise
+
+
+def write_json(path, data):
+    atomic_write(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
+
+
+def read_text(path, what):
+    try:
+        with open(path, encoding="utf-8") as fh:
+            return fh.read()
+    except OSError as exc:
+        raise Refused(f"cannot read {what} at {path}: {exc}")
+
+
+def read_json(path, what):
+    try:
+        return json.loads(read_text(path, what))
+    except json.JSONDecodeError as exc:
+        raise Refused(f"{what} at {path} is not JSON: {exc}")
+
+
+def read_yaml(path, what):
+    if yaml is None:
+        raise Refused("PyYAML is needed (pip install pyyaml)")
+    try:
+        return yaml.safe_load(read_text(path, what))
+    except yaml.YAMLError as exc:
+        raise Refused(f"{what} at {path} is not YAML: {exc}")
+
+
+# ---- the tracker, read only ------------------------------------------------------------
+
+class FileTracker:
+    def __init__(self, path):
+        data = read_json(path, "the tracker file")
+        if not isinstance(data, dict) or not isinstance(data.get("issues"), list):
+            raise Refused('the tracker file must be {"issues": [...]}')
+        self.issues = {int(i["number"]): i for i in data["issues"] if isinstance(i, dict) and "number" in i}
+
+    def get(self, number):
+        it = self.issues.get(int(number))
+        return {"number": it["number"], "title": it.get("title") or "", "body": it.get("body") or ""} if it else None
+
+
+class HostTracker:
+    def __init__(self, config):
+        import sys
+        sys.path.insert(0, HERE)
+        import platform_adapter as pa  # noqa: E402  (copied beside this script)
+        self.pa, self.config = pa, config
+
+    def get(self, number):
+        res = self.pa.dispatch("view-issue", {"issue_number": str(number)}, config_path=self.config)
+        if res["exit_code"] != 0:
+            return None
+        raw = json.loads(res["stdout"])
+        return {"number": raw["number"], "title": raw.get("title") or "", "body": raw.get("body") or ""}
+
+
+def open_tracker(tracker_file=None, config=".garura/core/config.yaml"):
+    return FileTracker(tracker_file) if tracker_file else HostTracker(config)
+
+
+# ---- a story, an epic ------------------------------------------------------------------
+
+def _section(body, name):
+    """The lines of the `## <name>` section of an issue body, up to the next heading of level 1 or 2."""
+    out, inside = [], False
+    for line in (body or "").splitlines():
+        m = re.match(r"^(#{1,6})\s+(.*?)\s*$", line)
+        if m and len(m.group(1)) <= 2:
+            if inside:
+                break
+            inside = m.group(2).strip().lower() == name.lower()
+            continue
+        if inside:
+            out.append(line)
+    return out
+
+
+def _bullets(lines):
+    """Each `- ` item of a list, with its wrapped lines joined."""
+    items = []
+    for line in lines:
+        if re.match(r"^\s*[-*]\s+", line):
+            items.append(re.sub(r"^\s*[-*]\s+", "", line).strip())
+        elif items and line.startswith("  ") and line.strip():
+            items[-1] += " " + line.strip()
+    return items
+
+
+def parse_story(body):
+    """{goals, limits, expectations, context, has_scope}: the story's Scope of work lists, in order."""
+    scope = _section(body, "Scope of work")
+    lists, current = {"goals": [], "limits": [], "expectations": []}, None
+    chunk = {"goals": [], "limits": [], "expectations": []}
+    for line in scope:
+        head = line.strip().rstrip(":").lower()
+        if line.strip().endswith(":") and head in lists:
+            current = head
+            continue
+        if current:
+            chunk[current].append(line)
+    for key in lists:
+        lists[key] = _bullets(chunk[key])
+    context = _bullets(_section(body, "Context guidance"))
+    return dict(lists, context=context, has_scope=bool(scope))
+
+
+MAP_LINE = re.compile(r"^\s*[-*]\s*(?P<feature>[\w.-]+)\s*(?:→|->)\s*#(?P<story>\d+)\s*$")
+
+
+def parse_map(body):
+    """The epic's feature-to-story map, in its order: [(feature id, story number)]."""
+    return [(m["feature"], int(m["story"])) for m in
+            (MAP_LINE.match(ln) for ln in _section(body, "Feature-to-story map")) if m]
+
+
+# ---- the hidden file --------------------------------------------------------------------
+
+HIDDEN_ENTRY = re.compile(r"^##\s+(?P<feature>[\w.-]+):")
+FAILURE = re.compile(r"^\s*-\s*(?P<id>F\d+)\b[^:]*:\s*(?P<text>.+)$")
+
+
+def parse_hidden(text):
+    """{slice_id, surface, failures: {feature: [{id, text}]}, recovery_lines: [...]}."""
+    first = next((ln for ln in text.splitlines() if ln.startswith("# ")), "")
+    m = re.search(r"slice\s+([\w.-]+)", first)
+    m2 = re.search(r"Surface:\s*([^.;\n]+)", text)
+    surface = m2.group(1).strip() if m2 else None
+    failures, recovery, feature, part = {}, [], None, None
+    for line in text.splitlines():
+        e = HIDDEN_ENTRY.match(line)
+        if e:
+            feature, part = e["feature"], None
+            failures.setdefault(feature, [])
+            continue
+        if line.startswith("### "):
+            part = line[4:].strip().lower()
+            continue
+        if feature and part == "failure conditions":
+            f = FAILURE.match(line)
+            if f:
+                failures[feature].append({"id": f["id"], "text": f["text"].strip()})
+        elif feature and part == "recovery":
+            r = re.match(r"^\s*-\s*(When|Way back|Who fixes):\s*(.+)$", line)
+            if r and r.group(1) != "Who fixes":
+                recovery.append(r.group(2).strip())
+    return {"slice_id": m.group(1) if m else None, "surface": surface,
+            "failures": failures, "recovery_lines": recovery}
+
+
+# ---- the step library -------------------------------------------------------------------
+
+VALUE = r'(?:"[^"]*"|\[[^\]]+\])'
+NAME = r'\[[^\]]+\]'
+
+
+def _pattern(sentence):
+    out, pos = "", 0
+    for m in re.finditer(r"\{(value|name|n)\}", sentence):
+        out += re.escape(sentence[pos:m.start()])
+        out += {"value": VALUE, "name": NAME, "n": r"\d+"}[m.group(1)]
+        pos = m.end()
+    return re.compile("^" + out + re.escape(sentence[pos:]) + "$")
+
+
+def load_library(path):
+    data = read_yaml(path, "the step library")
+    if not isinstance(data, dict) or not data.get("kind") or not isinstance(data.get("steps"), list):
+        raise Refused(f"{path} is not a step library (kind and steps are needed)")
+    steps = [{"id": s["id"], "keyword": s["keyword"], "text": s["text"], "re": _pattern(s["text"])}
+             for s in data["steps"]]
+    return {"kind": data["kind"], "matches": [m.lower() for m in data.get("matches") or []], "steps": steps}
+
+
+def kind_of(surface, libraries):
+    """The library whose `matches` names the surface, or None."""
+    s = (surface or "").lower()
+    for lib in libraries:
+        if any(m in s for m in lib["matches"]) or lib["kind"] in s:
+            return lib
+    return None
+
+
+def match_step(keyword, text, library):
+    """The library sentence a step is (keyword already resolved for And / But), or None."""
+    return next((s for s in library["steps"] if s["keyword"] == keyword and s["re"].match(text)), None)
+
+
+def names_in(text):
+    return re.findall(r"\[([^\]]+)\]", text)
+
+
+# ---- the eval files ---------------------------------------------------------------------
+
+TAG_LINE = re.compile(r"^\s*(`@[\w.-]+`\s*)+$")
+KEYWORD = re.compile(r"^#+\s*(?P<kw>Feature|Business Need|Ability|Background|Rule|Scenario|Example)\s*:\s*(?P<title>.*)$")
+STEP = re.compile(r"^\s*[-*]\s+(?P<kw>Given|When|Then|And|But)\s+(?P<text>.+?)\s*$")
+COVERED = re.compile(r"^\s*[-*]\s*`@(?P<tag>[\w.-]+)`\s*:\s*(?P<text>.+)$")
+UNTESTABLE = re.compile(r"^\s*[-*]\s*(?P<tags>(?:`@[\w.-]+`\s*)+):\s*(?P<reason>.+)$")
+
+
+def tags_of(line):
+    return re.findall(r"`@([\w.-]+)`", line)
+
+
+def parse_story_file(text):
+    """{top_tags, feature, background, scenarios: [{tags, title, steps: [(kw, text)], raw}], untestable,
+    lines_covered: {tag: the story line's text as the file recorded it}, errors}."""
+    lines = text.splitlines()
+    res = {"top_tags": [], "feature": None, "background": [], "scenarios": [], "untestable": [],
+           "lines_covered": {}, "errors": []}
+    pending, block, current, section = [], None, None, None
+    for i, line in enumerate(lines):
+        if TAG_LINE.match(line):
+            pending = tags_of(line)
+            block = [line]
+            continue
+        k = KEYWORD.match(line)
+        if k:
+            kw = k["kw"]
+            if kw in ("Feature", "Business Need", "Ability"):
+                if res["feature"] is not None:
+                    res["errors"].append("more than one Feature: in the file")
+                res["feature"], res["top_tags"] = k["title"].strip(), pending
+                current, section = None, "feature"
+            elif kw == "Background":
+                current, section = None, "background"
+            elif kw in ("Scenario", "Example"):
+                current = {"tags": pending, "title": k["title"].strip(), "steps": [],
+                           "raw": (block or []) + [line]}
+                res["scenarios"].append(current)
+                section = "scenario"
+            else:  # Rule: allowed, groups scenarios
+                current, section = None, "rule"
+            pending, block = [], None
+            continue
+        if re.match(r"^#+\s*Untestable\s*$", line):
+            current, section, pending, block = None, "untestable", [], None
+            continue
+        if re.match(r"^#+\s*Lines covered\s*$", line):
+            current, section, pending, block = None, "covered", [], None
+            continue
+        if re.match(r"^#+\s", line):
+            current, section, pending, block = None, "prose", [], None
+            continue
+        s = STEP.match(line)
+        if s and section in ("scenario", "background"):
+            target = current["steps"] if section == "scenario" else res["background"]
+            target.append((s["kw"], s["text"]))
+            if current is not None:
+                current["raw"].append(line)
+            continue
+        if section == "covered":
+            c = COVERED.match(line)
+            if c:
+                res["lines_covered"][c["tag"]] = c["text"].strip()
+            continue
+        if section == "untestable":
+            u = UNTESTABLE.match(line)
+            if u:
+                res["untestable"].append({"tags": tags_of(u["tags"]), "reason": u["reason"].strip()})
+            continue
+        if current is not None and section == "scenario":
+            current["raw"].append(line)
+    for sc in res["scenarios"]:
+        while sc["raw"] and not sc["raw"][-1].strip():
+            sc["raw"].pop()
+        sc["raw"] = "\n".join(sc["raw"])
+    return res
+
+
+def resolve_keywords(steps):
+    """[(keyword for the library, text, as written)]: And / But take the keyword of the step before."""
+    out, last = [], None
+    for kw, text in steps:
+        real = last if kw in ("And", "But") else kw
+        out.append((real, text, kw))
+        last = real
+    return out
+
+
+def parse_slice_file(text):
+    """{title, surface_kind, time_limit, stories: [(feature, story, file)], out_of_slice, names, has_pass_rule}."""
+    res = {"title": None, "surface_kind": None, "time_limit": None, "stories": [], "out_of_slice": [],
+           "names": [], "has_pass_rule": False}
+    section = None
+    for line in text.splitlines():
+        if line.startswith("# ") and res["title"] is None:
+            res["title"] = line[2:].strip()
+            continue
+        m = re.match(r"^Surface kind:\s*(\S+)", line)
+        if m:
+            res["surface_kind"] = m.group(1)
+        m = re.match(r"^Time limit for each scenario:\s*(\d+)\s*seconds?\s*$", line)
+        if m:
+            res["time_limit"] = int(m.group(1))
+        h = re.match(r"^##\s+(.*?)\s*$", line)
+        if h:
+            section = h.group(1).lower()
+            if section == "pass rule":
+                res["has_pass_rule"] = True
+            continue
+        if section == "stories, in build order":
+            m = re.match(r"^\s*\d+\.\s*Story #(\d+)\s*\(([\w.-]+)\)\s*—\s*(\S+)", line)
+            if m:
+                res["stories"].append((m.group(2), int(m.group(1)), m.group(3)))
+        elif section == "out of the slice":
+            m = re.match(r"^\s*[-*]\s*Story #(\d+)\s*\(([\w.-]+)\)\s*—\s*(\S+?):?\s", line + " ")
+            if m:
+                res["out_of_slice"].append((m.group(2), int(m.group(1)), m.group(3).rstrip(":")))
+        elif section == "names":
+            m = re.match(r"^\s*[-*]\s*\[([^\]]+)\]", line)
+            if m:
+                res["names"].append(m.group(1))
+    return res
+
+
+def story_line(story, tag):
+    """The story's line a `goal-<k>` or `expectation-<k>` tag points at now, or None."""
+    m = re.match(r"^(goal|expectation)-(\d+)$", tag)
+    if not m:
+        return None
+    items = story.get("goals" if m.group(1) == "goal" else "expectations") or []
+    k = int(m.group(2))
+    return items[k - 1] if 1 <= k <= len(items) else None
+
+
+def same_line(a, b):
+    return " ".join(str(a or "").split()) == " ".join(str(b or "").split())
+
+
+def story_file_name(feature):
+    return f"eval.{feature}.feature.md"
+
+
+def slice_file_name(slice_id):
+    return f"eval.{slice_id}.md"
diff --git a/core/components/plays/shape-eval/scripts/gather_eval.py b/core/components/plays/shape-eval/scripts/gather_eval.py
--- /dev/null
+++ b/core/components/plays/shape-eval/scripts/gather_eval.py
@@ -0,0 +1,172 @@
+#!/usr/bin/env python3
+"""gather_eval.py — gather the three inputs of each slice's eval, and copy them (C1, C8, C12).
+
+    python3 gather_eval.py --plan-file <plans>/<id>.yaml --plans <plans> \
+        --library <copy of steps-<kind>.yaml> [--library ...] [--tracker-file <json>] \
+        --working <working> --out <working>inputs.json
+
+For each epic node of the plan file that stands for a slice (`kind: epic`, `represents: <slice
+id>`), it reads, and only reads:
+  - the epic, from the tracker, and its feature-to-story map, in its order (the build order);
+  - each story of the map, from the tracker: its "Scope of work" (Goals, Limits, Expectations)
+    and its "Context guidance";
+  - the slice's hidden file, found by the slice id of its first heading in
+    `<plans>/<home>/evals/<slug>/failure-and-recovery.md`, where <home> is the slice's home plan (the
+    plan of its first intent, which need not be this plan): its Surface line and each feature's
+    failure conditions. The eval is read and written in that same folder.
+It never reads an ICE page, the usage guide, the code or the product model (C1). It copies the
+epic, each story and the hidden file into `<working>inputs/`, and any eval files the slice
+already has into `<working>inputs/existing/<slug>/` (the state before this run), so the agent
+and the skill are given only those copies.
+
+A slice is ready when its epic, its map, a "Scope of work" on each story, its hidden file, an
+entry in it for each feature of the map, and a step library for its surface kind are all there.
+A slice that is not ready gets `ready: false` and a `reason`, and no eval (C8, C12).
+
+Writes inputs.json: {plan_id, intent_title, plans, slices: [{slice_id, slug, folder, epic,
+epic_title, ready, reason, surface, surface_kind, library, stories: [{feature, issue, title,
+goals, limits, expectations, context, path}], failures: {feature: [{id, text}]},
+recovery_lines, hidden, existing: [file names], out_of_slice: [file names]}]}.
+Exit 0 written (also when no slice is ready), 2 refused (no plan file, or no epic node).
+"""
+
+import argparse
+import glob
+import json
+import os
+import shutil
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import eval_common as ec  # noqa: E402
+
+
+def walk(nodes):
+    for node in nodes or []:
+        if isinstance(node, dict):
+            yield node
+            yield from walk(node.get("children"))
+
+
+def find_hidden(plans, plan_id, slice_id):
+    """The slice's hidden file, in its home plan's evals folder (the plan of its first intent, which need
+    not be this plan): this plan's folder first, then every other plan's."""
+    own = sorted(glob.glob(os.path.join(plans, str(plan_id), "evals", "*", "failure-and-recovery.md")))
+    rest = [p for p in sorted(glob.glob(os.path.join(plans, "*", "evals", "*", "failure-and-recovery.md")))
+            if p not in own]
+    for path in own + rest:
+        if ec.parse_hidden(ec.read_text(path, "a hidden file"))["slice_id"] == slice_id:
+            return path
+    return None
+
+
+def gather(plan_file, plans, libraries, tracker, working):
+    plan = ec.read_yaml(plan_file, "the plan file")
+    if not isinstance(plan, dict):
+        raise ec.Refused(f"no plan file at {plan_file}: run /shape-plan <intent> first")
+    plan_id = plan.get("id")
+    epics = [n for n in walk(plan.get("tree")) if n.get("kind") == "epic" and n.get("represents")]
+    if not epics:
+        raise ec.Refused("the plan file has no epic that stands for a slice: run /shape-plan first")
+    inputs_dir = os.path.join(working, "inputs")
+    if os.path.isdir(inputs_dir):
+        shutil.rmtree(inputs_dir)
+    os.makedirs(inputs_dir)
+    out = {"plan_id": plan_id, "intent_title": plan.get("title"), "plans": plans, "slices": []}
+    for node in epics:
+        sl = {"slice_id": node["represents"], "slug": None, "folder": None, "epic": node.get("issue"),
+              "epic_title": None, "ready": False, "reason": None, "surface": None, "surface_kind": None,
+              "library": None, "stories": [], "failures": {}, "recovery_lines": [], "hidden": None,
+              "existing": [], "out_of_slice": []}
+        out["slices"].append(sl)
+        epic = tracker.get(node["issue"]) if node.get("issue") else None
+        if epic is None:
+            sl["reason"] = f"the epic of slice {sl['slice_id']} is not in the tracker"
+            continue
+        sl["epic_title"] = epic["title"]
+        ec.atomic_write(os.path.join(inputs_dir, f"epic-{epic['number']}.md"), epic["body"])
+        fmap = ec.parse_map(epic["body"])
+        hidden = find_hidden(plans, plan_id, sl["slice_id"])
+        if hidden:
+            sl["folder"] = os.path.dirname(hidden)
+            sl["slug"] = os.path.basename(sl["folder"])
+            copy = os.path.join(inputs_dir, f"hidden-{sl['slug']}.md")
+            shutil.copyfile(hidden, copy)
+            sl["hidden"] = copy
+            h = ec.parse_hidden(ec.read_text(hidden, "the hidden file"))
+            sl["surface"], sl["failures"], sl["recovery_lines"] = h["surface"], h["failures"], h["recovery_lines"]
+            lib = ec.kind_of(h["surface"], [ec.load_library(p) | {"path": p} for p in libraries])
+            if lib:
+                sl["surface_kind"], sl["library"] = lib["kind"], lib["path"]
+            existing_dir = os.path.join(inputs_dir, "existing", sl["slug"])
+            for path in sorted(glob.glob(os.path.join(sl["folder"], "eval.*"))):
+                os.makedirs(existing_dir, exist_ok=True)
+                shutil.copyfile(path, os.path.join(existing_dir, os.path.basename(path)))
+                sl["existing"].append(os.path.basename(path))
+        for feature, number in fmap:
+            story = tracker.get(number)
+            if story is None:
+                sl["stories"].append({"feature": feature, "issue": number, "missing": True})
+                continue
+            path = os.path.join(inputs_dir, f"story-{number}.md")
+            ec.atomic_write(path, story["body"])
+            parsed = ec.parse_story(story["body"])
+            sl["stories"].append({"feature": feature, "issue": number, "title": story["title"],
+                                  "goals": parsed["goals"], "limits": parsed["limits"],
+                                  "expectations": parsed["expectations"], "context": parsed["context"],
+                                  "has_scope": parsed["has_scope"], "path": path})
+        in_map = {ec.story_file_name(f) for f, _ in fmap}
+        sl["out_of_slice"] = [f for f in sl["existing"] if f.endswith(".feature.md") and f not in in_map]
+        sl["reason"] = why_not_ready(sl, fmap)
+        sl["ready"] = sl["reason"] is None
+    return out
+
+
+def why_not_ready(sl, fmap):
+    if not fmap:
+        return f"epic #{sl['epic']} has no feature-to-story map: run /shape-plan first"
+    missing = [str(s["issue"]) for s in sl["stories"] if s.get("missing")]
+    if missing:
+        return "the tracker has no story #" + ", #".join(missing)
+    no_scope = [str(s["issue"]) for s in sl["stories"] if not s.get("has_scope")]
+    if no_scope:
+        return "story #" + ", #".join(no_scope) + " has no Scope of work: run /shape-plan first"
+    if not sl["hidden"]:
+        return f"slice {sl['slice_id']} has no hidden file in the plan's evals folder: run /shape-slice first"
+    no_entry = [f for f, _ in fmap if f not in sl["failures"]]
+    if no_entry:
+        return "the hidden file has no entry for " + ", ".join(no_entry) + ": run /shape-slice again"
+    if not sl["surface_kind"]:
+        return f"no step library for the surface '{sl['surface']}' yet"
+    return None
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Gather and copy the inputs of each slice's eval.")
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--plans", required=True)
+    ap.add_argument("--library", action="append", default=[], required=True)
+    ap.add_argument("--tracker-file")
+    ap.add_argument("--config", default=".garura/core/config.yaml")
+    ap.add_argument("--working", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    try:
+        if not os.path.isfile(args.plan_file):
+            raise ec.Refused(f"no plan file at {args.plan_file}: run /shape-plan <intent> first")
+        res = gather(args.plan_file, args.plans, args.library,
+                     ec.open_tracker(args.tracker_file, args.config), args.working)
+    except ec.Refused as exc:
+        sys.stderr.write(f"gather_eval.py: {exc}\n")
+        print(json.dumps({"ok": False, "reason": str(exc)}))
+        return 2
+    ec.write_json(args.out, res)
+    print(json.dumps({"ok": True, "ready": [s["slice_id"] for s in res["slices"] if s["ready"]],
+                      "skipped": [{"slice": s["slice_id"], "reason": s["reason"]}
+                                  for s in res["slices"] if not s["ready"]]}, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/shape-eval/scripts/place_eval.py b/core/components/plays/shape-eval/scripts/place_eval.py
--- /dev/null
+++ b/core/components/plays/shape-eval/scripts/place_eval.py
@@ -0,0 +1,276 @@
+#!/usr/bin/env python3
+"""place_eval.py — put the skill's drafts into each slice's evals folder; an eval is a fixed yardstick (C2, C7).
+
+    python3 place_eval.py --inputs <working>inputs.json --drafts <working>drafts \
+        --out <working>place.json --yardstick-out <working>yardstick-check.json
+    python3 place_eval.py --undo <working>place.json --inputs <working>inputs.json
+    python3 place_eval.py --clear <working>clear.json --inputs <working>inputs.json
+
+The drafts are in `<drafts>/<slug>/`: one story file `eval.<feature-id>.feature.md` for each
+story of the slice's map, and the slice file `eval.<slice-id>.md`. For each ready slice:
+
+  - A story file the slice does not have yet is written as drafted.
+  - A story file the slice has keeps every line it has. Only the drafted scenarios that cover
+    something the file does not cover yet (a tag no scenario and no Untestable line of the file
+    has) are added, before its "Untestable" section, and only the drafted Untestable lines for
+    what is still not covered are added to that section. A file with nothing to add is not
+    touched.
+  - A story file whose feature left the slice (in inputs.json `out_of_slice`) stays; its first
+    tag line gains `@out-of-slice`.
+  - The slice file is written from the draft, unless what it says (the stories in order, the
+    stories out of the slice, the surface kind, the time limit, the names) is the same as the file
+    the slice has; then the file is not touched.
+A slice that is not ready gets nothing. Each placing starts from the state before the run: an
+earlier place.json of the run is undone first, and the files the slice had are read from the copies
+in `<working>inputs/existing/<slug>/`, so placing again after a fix gives the same files.
+
+The yardstick check reads each story file the slice had before and the file now: every scenario
+it had must be in it, word for word (C7). It writes yardstick-check.json {ok, problems, kept,
+added}. place.json lists each file written, with whether it was there before, for the guard and
+for --undo, which puts back each file as it was before the run (a stop or a change, C9). A story
+file's "Lines covered" list only grows: a placed scenario's covered lines are added, and a line the
+file had stays as it was (C16). --clear deletes the drafts, the hidden-file copy and the copies of
+the slice's eval files from before the run, and writes clear.json {ok, removed, left}: run it after
+the eval commit and after a stop's undo (C15).
+Exit 0 written and the yardstick holds, 1 the yardstick does not hold, 2 refused.
+"""
+
+import argparse
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import eval_common as ec  # noqa: E402
+
+OUT = "out-of-slice"
+
+
+def covered(parsed):
+    tags = set()
+    for sc in parsed["scenarios"]:
+        tags.update(sc["tags"])
+    for u in parsed["untestable"]:
+        tags.update(u["tags"])
+    return tags
+
+
+def merge_story(old, draft):
+    """(new text, scenarios added, untestable lines added) for a story file the slice has."""
+    po, pd = ec.parse_story_file(old), ec.parse_story_file(draft)
+    have = covered(po)
+    new_sc = [sc for sc in pd["scenarios"] if set(sc["tags"]) - have]
+    after = have | {t for sc in new_sc for t in sc["tags"]}
+    new_un = [u for u in pd["untestable"] if set(u["tags"]) - after]
+    new_cov = {t: x for t, x in pd["lines_covered"].items()
+               if t not in po["lines_covered"] and t in {t for sc in new_sc for t in sc["tags"]}}
+    if not new_sc and not new_un:
+        return old, 0, 0
+    lines = old.rstrip("\n").split("\n")
+
+    def section(name):
+        return next((i for i, ln in enumerate(lines) if ln.lstrip().startswith("#")
+                     and ln.strip().lstrip("#").strip() == name), None)
+
+    first = min([i for i in (section("Untestable"), section("Lines covered")) if i is not None], default=None)
+    head, tail = (lines, []) if first is None else (lines[:first], lines[first:])
+    while head and not head[-1].strip():
+        head.pop()
+    for sc in new_sc:
+        head += ["", sc["raw"]]
+    tail = add_lines(tail, "Untestable",
+                     ["- " + " ".join(f"`@{t}`" for t in u["tags"]) + f": {u['reason']}" for u in new_un])
+    tail = add_lines(tail, "Lines covered", [f"- `@{t}`: {x}" for t, x in new_cov.items()])
+    text = "\n".join(head + ([""] + tail if tail else [])) + "\n"
+    return text, len(new_sc), len(new_un)
+
+
+def add_lines(tail, name, new):
+    """Append lines at the end of the `## <name>` section of `tail` (made at the end when missing)."""
+    if not new:
+        return tail
+    at = next((i for i, ln in enumerate(tail) if ln.lstrip().startswith("#")
+               and ln.strip().lstrip("#").strip() == name), None)
+    if at is None:
+        while tail and not tail[-1].strip():
+            tail.pop()
+        return tail + ([""] if tail else []) + [f"## {name}", ""] + new
+    end = next((i for i in range(at + 1, len(tail)) if tail[i].lstrip().startswith("#")), len(tail))
+    body = tail[at + 1:end]
+    while body and not body[-1].strip():
+        body.pop()
+    return tail[:at + 1] + body + new + ([""] + tail[end:] if end < len(tail) else [])
+
+
+def mark_out(text):
+    lines = text.split("\n")
+    for i, ln in enumerate(lines):
+        if ec.TAG_LINE.match(ln):
+            if f"`@{OUT}`" not in ln:
+                lines[i] = ln.rstrip() + f" `@{OUT}`"
+            return "\n".join(lines)
+        if ec.KEYWORD.match(ln):
+            break
+    return f"`@{OUT}`\n" + text
+
+
+def same_slice(a, b):
+    pa, pb = ec.parse_slice_file(a), ec.parse_slice_file(b)
+    keys = ("stories", "out_of_slice", "surface_kind", "time_limit", "names")
+    return all(pa[k] == pb[k] for k in keys) and sorted(pa["names"]) == sorted(pb["names"])
+
+
+def plan_slice(sl, working, drafts):
+    existing_dir = os.path.join(working, "inputs", "existing", sl["slug"])
+    draft_dir = os.path.join(drafts, sl["slug"])
+    writes, added_sc, added_un, kept, problems = {}, 0, 0, 0, []
+
+    def before(name):
+        p = os.path.join(existing_dir, name)
+        return ec.read_text(p, "an eval file") if os.path.isfile(p) else None
+
+    for story in sl["stories"]:
+        name = ec.story_file_name(story["feature"])
+        dpath = os.path.join(draft_dir, name)
+        if not os.path.isfile(dpath):
+            problems.append(f"no draft {name} for story #{story['issue']}")
+            continue
+        draft, old = ec.read_text(dpath, "a draft"), before(name)
+        if old is None:
+            writes[name] = draft
+        else:
+            text, n_sc, n_un = merge_story(old, draft)
+            added_sc, added_un = added_sc + n_sc, added_un + n_un
+            if text != old:
+                writes[name] = text
+    for name in sl["out_of_slice"]:
+        old = before(name)
+        text = mark_out(old)
+        if text != old:
+            writes[name] = text
+    sname = ec.slice_file_name(sl["slice_id"])
+    spath = os.path.join(draft_dir, sname)
+    if not os.path.isfile(spath):
+        problems.append(f"no draft {sname}")
+    else:
+        draft, old = ec.read_text(spath, "a draft"), before(sname)
+        if old is None or not same_slice(old, draft):
+            writes[sname] = draft
+    # the yardstick: every scenario of every story file the slice had stays, word for word
+    for name in sl["existing"]:
+        if not name.endswith(".feature.md"):
+            continue
+        old = before(name)
+        now = writes.get(name, old)
+        for sc in ec.parse_story_file(old)["scenarios"]:
+            kept += 1
+            if sc["raw"] not in now:
+                problems.append(f"{name}: the scenario '{sc['title']}' changed or went away")
+    return writes, added_sc, added_un, kept, problems
+
+
+def place(inputs, working, drafts):
+    record = {"ok": True, "slices": [], "files": []}
+    yard = {"ok": True, "problems": [], "kept": 0, "added": 0}
+    for sl in inputs["slices"]:
+        if not sl["ready"]:
+            record["slices"].append({"slice": sl["slice_id"], "skipped": sl["reason"]})
+            continue
+        writes, n_sc, n_un, kept, problems = plan_slice(sl, working, drafts)
+        yard["kept"] += kept
+        yard["added"] += n_sc
+        missing = [p for p in problems if p.startswith("no draft")]
+        if missing:
+            raise ec.Refused("; ".join(missing))
+        if problems:
+            yard["ok"] = False
+            yard["problems"] += problems
+            continue
+        written = []
+        for name, text in writes.items():
+            path = os.path.join(sl["folder"], name)
+            record["files"].append({"path": path, "existed": name in sl["existing"]})
+            ec.atomic_write(path, text)
+            written.append(path)
+        record["slices"].append({"slice": sl["slice_id"], "written": written,
+                                 "added_scenarios": n_sc, "added_untestable": n_un,
+                                 "new_files": [os.path.join(sl["folder"], n) for n in writes
+                                               if n not in sl["existing"]]})
+    record["ok"] = yard["ok"]
+    return record, yard
+
+
+def clear(working, inputs):
+    """C15: delete every copy of an eval or the hidden file from the run's short-term memory."""
+    import shutil
+    removed = []
+    for path in [os.path.join(working, "drafts"), os.path.join(working, "inputs", "existing")] + \
+            [s["hidden"] for s in inputs["slices"] if s.get("hidden")]:
+        if os.path.isdir(path):
+            shutil.rmtree(path)
+            removed.append(path)
+        elif os.path.isfile(path):
+            os.unlink(path)
+            removed.append(path)
+    left = [p for p in (os.path.join(working, "drafts"), os.path.join(working, "inputs", "existing"))
+            if os.path.exists(p)] + [s["hidden"] for s in inputs["slices"] if s.get("hidden") and os.path.exists(s["hidden"])]
+    return {"ok": not left, "removed": removed, "left": left}
+
+
+def undo(place_path, inputs):
+    rec = ec.read_json(place_path, "the place record")
+    slug_of = {s["folder"]: s["slug"] for s in inputs["slices"] if s.get("folder")}
+    undone = []
+    for f in rec.get("files") or []:
+        path = f["path"]
+        if f["existed"]:
+            slug = slug_of[os.path.dirname(path)]
+            src = os.path.join(inputs["_working"], "inputs", "existing", slug, os.path.basename(path))
+            ec.atomic_write(path, ec.read_text(src, "the copy from before the run"))
+        elif os.path.isfile(path):
+            os.unlink(path)
+        undone.append(path)
+    return {"ok": True, "undone": undone}
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Place the eval drafts; keep every scenario that was there.")
+    ap.add_argument("--inputs", required=True)
+    ap.add_argument("--drafts")
+    ap.add_argument("--out")
+    ap.add_argument("--yardstick-out")
+    ap.add_argument("--undo", help="a place.json: put back each file as it was before the run")
+    ap.add_argument("--clear", help="write clear.json here: delete the drafts and every copy of an eval or hidden file (C15)")
+    args = ap.parse_args(argv)
+    try:
+        inputs = ec.read_json(args.inputs, "inputs.json")
+        working = os.path.dirname(os.path.abspath(args.inputs))
+        if args.undo:
+            inputs["_working"] = working
+            print(json.dumps(undo(args.undo, inputs), indent=2))
+            if not args.clear:
+                return 0
+        if args.clear:
+            res = clear(working, inputs)
+            ec.write_json(args.clear, res)
+            print(json.dumps(res, indent=2))
+            return 0 if res["ok"] else 1
+        if not (args.drafts and args.out and args.yardstick_out):
+            raise ec.Refused("give --drafts, --out and --yardstick-out (or --undo)")
+        if os.path.isfile(args.out):  # placing again after a fix starts from the state before the run
+            inputs["_working"] = working
+            undo(args.out, inputs)
+        record, yard = place(inputs, working, args.drafts)
+    except ec.Refused as exc:
+        sys.stderr.write(f"place_eval.py: {exc}\n")
+        print(json.dumps({"ok": False, "reason": str(exc)}))
+        return 2
+    ec.write_json(args.yardstick_out, yard)
+    ec.write_json(args.out, record)
+    print(json.dumps({"ok": record["ok"], "files": len(record["files"]), "yardstick": yard["ok"]}, indent=2))
+    return 0 if yard["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
