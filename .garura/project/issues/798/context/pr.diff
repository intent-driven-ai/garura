+
+    with tempfile.TemporaryDirectory() as tmp:
+        root, plans, work, spine, hidden, req, before = setup(tmp)
+        by_intent = os.path.join(work, "by-intent.json")
+        code, out, _ = run("snapshot", "--root", root, "--spine", spine, "--intent", "bi-340",
