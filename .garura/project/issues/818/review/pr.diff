+  signals: ["core/components/plays/**", "core/components/skills/**", "core/components/agents/**", "core/grounding/**", ".claude/skills/**", ".claude/agents/**", ".agents/skills/**", "AGENTS.md scaffolding"]
+provenance: "seeded:#443"
