+++ b/core/components/plays/shape-plan/scripts/check_stop_condition.py
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""
+check_stop_condition.py — evaluate a play's baked stop condition (#464).
+
+A play ends because "done" was PROVEN, not because its step list ran out.
+The proof is this script: it reads the play's compiled stop-condition
+manifest (stop-condition.yaml, baked by create-play from the ICE's
+"### Done means" section) and evaluates every clause against what actually
+exists on disk at close. Pure assertions — it executes nothing, so the
+close gate stays instant and side-effect-free (implement's hand-built
+check_done.py pattern, made play-agnostic).
+
+Clause types (mechanical, closed set):
+    artifact_exists     {path}                       — glob ok, ≥1 match
+    field_equals        {file, field, equals}        — dot-path into JSON/YAML
+    gate_outcomes_pass  {file}                       — check-quality-gates output: ok == true
+
+Manifest shape (content.done is the clause list):
+    schema: {name: stop-condition}
+    content:
+      done:
+        - id: D1
+          says: "the commits exist and the tree is clean"   # human sentence
+          check: {type: artifact_exists, path: "...commits.yaml"}
+
+Usage:
+    python3 check_stop_condition.py --manifest <stop-condition.yaml> \
+        --base <run/STM root for relative paths> --out <verdict.yaml>
+
+Verdict: {stop_condition: held|unmet, clauses: [{id, says, status, detail}]}
+Exit 0 held, 1 unmet, 2 manifest/clause error (an unevaluable clause is an
+error, never a silent pass — the check-quality-gates rule, reused).
+"""
+
+import argparse
+import glob
+import json
+import os
+import sys
+
+try:
+    import yaml
+except ImportError:
+    print("PyYAML required: pip install pyyaml", file=sys.stderr)
+    sys.exit(2)
+
+
+def load_doc(path):
+    with open(path, "r", encoding="utf-8") as fh:
+        if path.endswith(".json"):
+            return json.load(fh)
+        return yaml.safe_load(fh)
+
+
+def dot_get(doc, field):
+    cur = doc
+    for part in field.split("."):
+        if isinstance(cur, list):
+            cur = cur[int(part)]
+        elif isinstance(cur, dict) and part in cur:
+            cur = cur[part]
+        else:
+            return None, False
+    return cur, True
+
+
+def eval_clause(clause, base):
+    check = clause.get("check") or {}
+    ctype = check.get("type")
+    try:
+        if ctype == "artifact_exists":
+            pattern = os.path.join(base, check["path"])
+            hits = glob.glob(pattern)
+            return ("held" if hits else "unmet",
+                    f"{len(hits)} match(es) for {check['path']}")
+        if ctype == "field_equals":
+            fpath = os.path.join(base, check["file"])
+            if not os.path.exists(fpath):
+                return "unmet", f"file missing: {check['file']}"
+            value, found = dot_get(load_doc(fpath), check["field"])
+            if not found:
+                return "unmet", f"field missing: {check['field']}"
+            ok = value == check["equals"]
+            return ("held" if ok else "unmet",
+                    f"{check['field']} = {value!r} (want {check['equals']!r})")
+        if ctype == "gate_outcomes_pass":
+            fpath = os.path.join(base, check["file"])
+            if not os.path.exists(fpath):
+                return "unmet", f"gate outcomes missing: {check['file']}"
+            doc = load_doc(fpath)
+            ok = bool(doc.get("ok"))
+            counts = doc.get("counts", {})
+            return ("held" if ok else "unmet", f"gates ok={ok} counts={counts}")
+        return "error", f"unknown check type: {ctype!r}"
+    except Exception as exc:  # noqa: BLE001 — an unevaluable clause is an error
+        return "error", f"clause evaluation failed: {exc}"
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--manifest", required=True)
+    ap.add_argument("--base", required=True,
+                    help="root for the manifest's relative paths (the run's STM)")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args()
+
+    doc = load_doc(args.manifest) or {}
+    clauses = (doc.get("content") or {}).get("done") or []
+    if not clauses:
+        verdict = {"stop_condition": "error",
+                   "clauses": [],
+                   "detail": "manifest has no content.done clauses"}
+        code = 2
+    else:
+        results = []
+        for c in clauses:
+            status, detail = eval_clause(c, args.base)
+            results.append({"id": c.get("id"), "says": c.get("says"),
+                            "status": status, "detail": detail})
+        if any(r["status"] == "error" for r in results):
+            overall, code = "error", 2
+        elif all(r["status"] == "held" for r in results):
+            overall, code = "held", 0
+        else:
+            overall, code = "unmet", 1
+        verdict = {"stop_condition": overall, "clauses": results}
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
+    with open(args.out, "w", encoding="utf-8") as fh:
+        yaml.safe_dump(verdict, fh, sort_keys=False)
+    print(json.dumps(verdict, indent=2))
+    sys.exit(code)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/core/components/plays/shape-plan/scripts/check_tracker.py b/core/components/plays/shape-plan/scripts/check_tracker.py
new file mode 100644
index 00000000..44ce6b40
--- /dev/null
+++ b/core/components/plays/shape-plan/scripts/check_tracker.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""check_tracker.py — the tracker check (/shape-plan, D4; C4, C5, C12, C13).
+
+    python3 check_tracker.py --record <tracker-record.json> [--tracker-file <json>] \
+        --out <working>/tracker-check.json
+
+It reads each work item of the record back from the tracker (through platform_adapter.py, or
+the --tracker-file fixture). `ok: true` only when:
+  - each issue the record names exists;
+  - each epic has type Feature and each story type Story, and none has a label;
+  - each epic's sub-issues are its stories: the stories of its map, no more and no fewer;
+  - each story's body has the sections "Scope of work" and "Context guidance" and the line
+    "Represents: <feature id>"; each epic's body has "Represents: <slice id>" and its map;
+    and no body this run made holds the words "Fails if" or a recovery phrase (a found item's
+    own lines are a person's, and are kept as they are);
+  - each moved-out story is open and is not a sub-issue of its epic.
+
+Output: {ok, problems: [..], checked: [issue numbers]}
+Exit 0 ok; 1 not ok (written); 2 bad input (nothing written). Reads only; writes nothing in the tracker.
+"""
+
+import argparse
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_common as pc  # noqa: E402
+
+
+def check(rec, tracker):
+    problems, checked = [], []
+    made = {int(c["issue"]) for c in rec.get("created") or []}
+
+    def fetch(number, what):
+        it = tracker.get(number)
+        checked.append(int(number))
+        if it is None:
+            problems.append(f"{what} #{number} is not in the tracker")
+        return it
+
+    for sid, epic_no in (rec.get("epics") or {}).items():
+        epic = fetch(epic_no, "the epic")
+        stories = {f: int(n) for f, n in ((rec.get("maps") or {}).get(sid) or {}).items()}
+        for fid, n in stories.items():
+            st = fetch(n, f"the story of {fid}")
+            if st is None:
+                continue
+            if st["type"] != pc.STORY_TYPE:
+                problems.append(f"story #{n} has type {st['type'] or 'none'}, not {pc.STORY_TYPE}")
+            if st["labels"]:
+                problems.append(f"story #{n} carries a label: {', '.join(st['labels'])}")
+            for sec in ("Scope of work", "Context guidance"):
+                if not pc.has_heading(st["body"], sec):
+                    problems.append(f"story #{n} has no \"{sec}\" section")
+            if not pc.has_line(st["body"], f"Represents: {fid}"):
+                problems.append(f"story #{n} has no line \"Represents: {fid}\"")
+            if n in made:
+                for reason in pc.forbidden_in(st["body"]):
+                    problems.append(f"story #{n}: {reason}")
+        if epic is None:
+            continue
+        if epic["type"] != pc.EPIC_TYPE:
+            problems.append(f"epic #{epic_no} has type {epic['type'] or 'none'}, not {pc.EPIC_TYPE}")
+        if epic["labels"]:
+            problems.append(f"epic #{epic_no} carries a label: {', '.join(epic['labels'])}")
+        if not pc.has_line(epic["body"], f"Represents: {sid}"):
+            problems.append(f"epic #{epic_no} has no line \"Represents: {sid}\"")
+        if pc.read_map(epic["body"]) != stories:
+            problems.append(f"epic #{epic_no}'s map in the tracker is not the map of the record")
+        if int(epic_no) in made:
+            for reason in pc.forbidden_in(epic["body"]):
+                problems.append(f"epic #{epic_no}: {reason}")
+        if sorted(epic["sub_issues"]) != sorted(stories.values()):
+            problems.append(f"epic #{epic_no}'s sub-issues {sorted(epic['sub_issues'])} are not its "
+                            f"stories {sorted(stories.values())}")
+    for mo in rec.get("moved_out") or []:
+        st = fetch(mo["issue"], "the moved-out story")
+        if st is not None and st["state"] != "open":
+            problems.append(f"the moved-out story #{mo['issue']} is {st['state']}, not open")
+        epic = tracker.get(mo.get("epic")) if mo.get("epic") is not None else None
+        if epic is not None and int(mo["issue"]) in epic["sub_issues"]:
+            problems.append(f"the moved-out story #{mo['issue']} is still a sub-issue of epic #{mo['epic']}")
+    for item in (rec.get("created") or []) + (rec.get("updated") or []):
+        if int(item["issue"]) not in checked:
+            fetch(item["issue"], f"the {item.get('kind', 'work item')}")
+    return {"ok": not problems, "problems": problems, "checked": sorted(set(checked))}
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Check the tracker against the run's record.")
+    ap.add_argument("--record", required=True)
+    ap.add_argument("--tracker-file")
+    ap.add_argument("--config", default=".garura/core/config.yaml")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    try:
+        rec = pc.read_json(args.record, "tracker-record.json")
+        tracker = pc.open_tracker(args.tracker_file, args.config)
+        result = check(rec, tracker)
+    except (pc.Refused, pc.TrackerError, ValueError, TypeError) as exc:
+        sys.stderr.write(f"check_tracker.py: {exc}\n")
+        print(json.dumps({"ok": False, "reason": str(exc)}))
+        return 2
+    pc.write_json(args.out, result)
+    print(json.dumps({"ok": result["ok"], "problems": result["problems"]}))
+    return 0 if result["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/shape-plan/scripts/find_work_items.py b/core/components/plays/shape-plan/scripts/find_work_items.py
new file mode 100644
index 00000000..e0f79ac4
--- /dev/null
+++ b/core/components/plays/shape-plan/scripts/find_work_items.py
@@ -0,0 +1,141 @@
+#!/usr/bin/env python3
+"""find_work_items.py — find each epic and story before any is made (/shape-plan, C3, C4, C9, C12).
+
+    python3 find_work_items.py --gather <gather.json> --plan-file <plans>/<id>.yaml \
+        [--tracker-file <json>] --out <working>/work-items.json
+
+A work item stands for a slice or a feature only when the plan file marks it so:
+`represents: <slice id>` on the epic's node, `represents: <feature id>` on a story's node under
+that epic. A title is never compared.
+
+For each slice of gather.json:
+  - the epic is `use` (with its issue) when a node of the tree has `represents: <slice id>`,
+    else `make`;
+  - each feature is `use` (its marked story has both "Scope of work" and "Context guidance"),
+    `add-sections` (marked, but one of the two sections is missing; `missing` names it),
+    `make` (no marked story), or `skip` (the feature is not ready; `reason` says why, and a
+    marked story is left as it is);
+  - `move_out` lists each marked story under the epic whose feature is no longer in the slice.
+The tracker is only read here (through platform_adapter.py, or the --tracker-file fixture).
+For each used item it records its type, labels, title and whether a story is a sub-issue of
+its epic, and for a used epic its feature-to-story map as its text holds it now, so the brief
+can show each change the write will make.
+
+Output:
+    {ok, plan_file_exists, problems: [..], duplicates: [..],
+     slices: [{slice, epic: {action, issue, title, type, labels, represents_line, map},
+               stories: [{feature, action, issue, missing, reason, title, type, labels,
+                          represents_line, attached}],
+               move_out: [{issue, feature, title}]}]}
+
+Exit 0 written; 1 written, with a problem (a marked issue the tracker does not have) or a
+duplicate (two nodes stand for one slice, or for one feature in one epic): the run shows them
+to the person and stops; 2 bad input (nothing written).
+"""
+
+import argparse
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_common as pc  # noqa: E402
+
+SECTIONS = ("Scope of work", "Context guidance")
+
+
+def tracker_facts(tracker, number, represents, problems, what):
+    it = tracker.get(number) if number is not None else None
+    if it is None:
+        problems.append(f"the plan file names #{number} as the {what} for {represents}, "
+                        "but the tracker has no such issue")
+        return None
+    return it
+
+
+def find(gather, plan, tracker):
+    tree = (plan or {}).get("tree") or []
+    problems, duplicates, out = [], [], []
+    for sl in gather.get("slices") or []:
+        sid = sl["id"]
+        feature_ids = [f["id"] for f in sl.get("features") or []]
+        epics = pc.marked(tree, sid)
+        if len(epics) > 1:
+            duplicates.append({"kind": "epic", "represents": sid, "kept": epics[0].get("issue"),
+                               "copies": [e.get("issue") for e in epics[1:]]})
+        node = epics[0] if epics else None
+        epic = {"action": "make", "issue": None, "title": None, "type": None, "labels": [],
+                "represents_line": False, "map": None}
+        kids = pc.children(node) if node else []
+        sub_issues = []
+        if node is not None:
+            epic.update(action="use", issue=node.get("issue"))
+            it = tracker_facts(tracker, node.get("issue"), sid, problems, "epic")
+            if it:
+                epic.update(title=it["title"], type=it["type"], labels=it["labels"],
+                            represents_line=pc.has_line(it["body"], f"Represents: {sid}"),
+                            map=pc.read_map(it["body"]))
+                sub_issues = it["sub_issues"]
+        stories = []
+        for f in sl.get("features") or []:
+            fid = f["id"]
+            mine = [k for k in kids if str(k.get("represents") or "") == fid]
+            if len(mine) > 1:
+                duplicates.append({"kind": "story", "represents": fid, "epic": epic["issue"],
+                                   "kept": mine[0].get("issue"),
+                                   "copies": [k.get("issue") for k in mine[1:]]})
+            story = {"feature": fid, "action": "make", "issue": None, "missing": [], "reason": "",
+                     "title": None, "type": None, "labels": [], "represents_line": False,
+                     "attached": False}
+            if mine:
+                story["issue"] = mine[0].get("issue")
+            if not f.get("ready"):
+                story.update(action="skip", reason=f.get("reason") or "its ICE is not ready")
+                stories.append(story)
+                continue
+            if mine:
+                it = tracker_facts(tracker, story["issue"], fid, problems, "story")
+                if it:
+                    missing = [s for s in SECTIONS if not pc.has_heading(it["body"], s)]
+                    story.update(action="add-sections" if missing else "use", missing=missing,
+                                 title=it["title"], type=it["type"], labels=it["labels"],
+                                 represents_line=pc.has_line(it["body"], f"Represents: {fid}"),
+                                 attached=int(story["issue"]) in sub_issues)
+                else:
+                    story["action"] = "use"
+            stories.append(story)
+        move_out = []
+        for k in kids:
+            rep = str(k.get("represents") or "")
+            if rep and rep not in feature_ids:
+                move_out.append({"issue": k.get("issue"), "feature": rep, "title": k.get("title")})
+        out.append({"slice": sid, "epic": epic, "stories": stories, "move_out": move_out})
+    return {"ok": not problems and not duplicates, "plan_file_exists": plan is not None,
+            "problems": problems, "duplicates": duplicates, "slices": out}
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Find the epics and stories that already stand for a slice or a feature.")
+    ap.add_argument("--gather", required=True)
+    ap.add_argument("--plan-file", required=True)
+    ap.add_argument("--tracker-file")
+    ap.add_argument("--config", default=".garura/core/config.yaml")
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    try:
+        gather = pc.read_json(args.gather, "gather.json")
+        plan = pc.load_plan(args.plan_file)
+        tracker = pc.open_tracker(args.tracker_file, args.config)
+        result = find(gather, plan, tracker)
+    except (pc.Refused, pc.TrackerError) as exc:
+        sys.stderr.write(f"find_work_items.py: {exc}\n")
+        print(json.dumps({"ok": False, "reason": str(exc)}))
+        return 2
+    pc.write_json(args.out, result)
+    print(json.dumps({"ok": result["ok"], "out": args.out, "problems": result["problems"],
+                      "duplicates": result["duplicates"]}))
+    return 0 if result["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/shape-plan/scripts/gather_plan.py b/core/components/plays/shape-plan/scripts/gather_plan.py
new file mode 100644
index 00000000..79d8646f
--- /dev/null
+++ b/core/components/plays/shape-plan/scripts/gather_plan.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""gather_plan.py — what the plan of one business intent holds (/shape-plan, C1, C2, C5, C9).
+
+    python3 gather_plan.py --root <model dir> --spine <spine> --intent bi-<n> \
+        --plans <plans dir> --out <working>/gather.json
+
+It finds every slice whose `intents` lists the business intent, in the order of the spine (the
+link "slice serves business intent"); it never picks or orders the slices itself. For each
+slice it lists the features (`feature_refs`, in build order), each feature's capability, and the
+page of each of the two ICE: the feature's and its capability's.
+
+For each feature it runs the ready check (check_ice_workable.py, beside this script) on both
+ICE. A feature is `ready: false`, with a `reason`, when either ICE is not ready, or has no
+lines. For each ready feature it writes one clean copy, `<working>/ice/<feature id>.md`, that
+holds both ICE with every "Fails if" block taken out: the line and every line under it (nested
+bullets, wrapped text). The clean copy names no ICE page. A clean copy left from an earlier
+run for a feature that is not ready now is deleted.
+
+It also writes `<working>/skill-input.json`, the only file the skill reads besides the clean
+copies: the intent and its title, and for each slice its id, name and outcome, and for each
+ready feature its id, name, one line and its clean copy's path. It holds no ICE page path.
+
+Output:
+    {intent, intent_title, plan_id, plan_file,
+     slices: [{id, slug, name, outcome,
+               features: [{id, name, one_line, capability, ready, reason, ice_pages: [..],
+                           clean_ice}]}]}
+
+skill-input.json:
+    {intent, intent_title, slices: [{id, name, outcome, features: [{id, name, one_line, clean_ice}]}]}
+
+Exit 0 written; 2 when no slice serves the intent, or an input is wrong (nothing written).
+No git, no network.
+"""
+
+import argparse
+import glob
+import json
+import os
+import re
+import subprocess
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import plan_common as pc  # noqa: E402
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def ready_check(spine_path, intents_dir, node):
+    """(ready, reason) from check_ice_workable.py for one ICE."""
+    p = subprocess.run([sys.executable, os.path.join(HERE, "check_ice_workable.py"),
+                        "--spine", spine_path, "--intents-dir", intents_dir, "--node", node],
+                       capture_output=True, text=True)
+    try:
+        report = json.loads(p.stdout) if p.stdout.strip() else {}
+    except json.JSONDecodeError:
+        report = {}
+    if p.returncode == 0:
+        return True, ""
+    if p.returncode == 1:
+        stops = report.get("stops") or [report.get("reason") or "not ready"]
+        return False, "; ".join(str(s) for s in stops)
+    return False, "the ready check could not run: " + str(report.get("error") or p.stderr.strip())
+
+
+def clean_copy(fid, parts):
+    """The clean copy's text: both ICE, headings one level down, no "Fails if" block, and no
+    ICE page path."""
+    out = [f"# The two ICE of {fid}", "",
+           "Written by gather_plan.py for /shape-plan. The failure lines are taken out.", ""]
+    for label, pid, lines in parts:
+        out += [f"## {label} ICE — {pid}", ""]
+        for ln in pc.without_fails_if(lines):
+            out.append("#" + ln if ln.startswith("#") else ln)
+        out.append("")
+    return "\n".join(out).rstrip() + "\n"
+
+
+def gather(args):
+    m = re.fullmatch(r"bi-(\d+)", args.intent or "")
+    if not m:
+        raise pc.Refused(f"the intent must read bi-<issue number>, not {args.intent!r}")
+    plan_id = m.group(1)
+    spine = pc.read_yaml(args.spine, "the spine")
+    if not isinstance(spine, dict):
+        raise pc.Refused("the spine must be a YAML mapping")
+    working = os.path.dirname(os.path.abspath(args.out))
+    intents_dir = os.path.join(args.root, "intents")
+    slices = [s for s in spine.get("slices") or []
+              if isinstance(s, dict) and args.intent in (s.get("intents") or [])]
+    if not slices:
+        raise pc.Refused(f"no slice in the spine serves {args.intent}; run /shape-slice {plan_id} first")
+    out_slices, ready_ids = [], set()
+    for sl in slices:
+        record = {}
+        if sl.get("record") and os.path.isfile(os.path.join(args.root, sl["record"])):
+            rec = pc.read_yaml(os.path.join(args.root, sl["record"]), "the slice record") or {}
+            record = (rec.get("slice") or {}) if isinstance(rec, dict) else {}
+        features = []
+        for fid in sl.get("feature_refs") or []:
+            f = pc.entry(spine, "features", fid)
+            if f is None:
+                features.append({"id": fid, "name": fid, "one_line": "", "capability": None,
+                                 "ready": False, "reason": "the feature is not in the spine",
+                                 "ice_pages": [], "clean_ice": None})
+                continue
+            cap = pc.entry(spine, "capabilities", f.get("capability")) if f.get("capability") else None
+            f_page, c_page = pc.ice_page(spine, f), pc.ice_page(spine, cap)
+            pages = [os.path.join(args.root, p) for p in (f_page, c_page) if p]
+            reasons = []
+            for label, part in (("feature", f), ("capability", cap)):
+                if part is None:
+                    reasons.append(f"the {label} is not in the spine")
+                    continue
+                ok, why = ready_check(args.spine, intents_dir, part["id"])
+                if not ok:
+                    reasons.append(f"the {label} ICE ({part['id']}) is not ready: {why}")
+                lines = pc.ice_lines(args.root, spine, part)
+                if lines is None:
+                    reasons.append(f"the {label} ICE ({part['id']}) has no page")
+                elif not [ln for ln in pc.without_fails_if(lines) if ln.strip()]:
+                    reasons.append(f"the {label} ICE ({part['id']}) has no lines")
+            item = {"id": fid, "name": pc.page_title(args.root, f.get("doc"), "Feature:") or fid,
+                    "one_line": f.get("one_line") or "", "capability": f.get("capability"),
+                    "ready": not reasons, "reason": "; ".join(reasons), "ice_pages": pages,
+                    "clean_ice": None}
+            if not reasons:
+                path = os.path.join(working, "ice", f"{fid}.md")
+                pc.atomic_write(path, clean_copy(fid, [
+                    ("Feature", fid, pc.ice_lines(args.root, spine, f)),
+                    ("Capability", cap["id"], pc.ice_lines(args.root, spine, cap))]))
+                item["clean_ice"] = path
+                ready_ids.add(fid)
+            features.append(item)
+        out_slices.append({"id": sl.get("id"), "slug": sl.get("slug"),
+                           "name": record.get("name") or sl.get("slug") or sl.get("id"),
+                           "outcome": record.get("outcome") or "", "features": features})
+    for old in glob.glob(os.path.join(working, "ice", "*.md")):
+        if os.path.splitext(os.path.basename(old))[0] not in ready_ids:
+            os.remove(old)
+    title = pc.page_title(args.root, os.path.join("intents", f"{args.intent}.md"), "") or f"Plan {plan_id}"
+    return {"intent": args.intent, "intent_title": title, "plan_id": plan_id,
+            "plan_file": os.path.join(args.plans, f"{plan_id}.yaml"), "slices": out_slices}
+
+
+def skill_input(result):
+    """What the skill may read: no ICE page path, no feature that is not ready."""
+    return {"intent": result["intent"], "intent_title": result["intent_title"],
+            "slices": [{"id": sl["id"], "name": sl["name"], "outcome": sl["outcome"],
+                        "features": [{"id": f["id"], "name": f["name"], "one_line": f["one_line"],
+                                      "clean_ice": f["clean_ice"]}
+                                     for f in sl["features"] if f["ready"]]}
+                       for sl in result["slices"]]}
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser(description="Gather the slices and ICE of one business intent's plan.")
+    ap.add_argument("--root", required=True)
+    ap.add_argument("--spine", required=True)
+    ap.add_argument("--intent", required=True)
+    ap.add_argument("--plans", required=True)
+    ap.add_argument("--out", required=True)
+    args = ap.parse_args(argv)
+    try:
+        result = gather(args)
+    except pc.Refused as exc:
+        sys.stderr.write(f"gather_plan.py: {exc}\n")
+        print(json.dumps({"ok": False, "reason": str(exc)}))
+        return 2
+    pc.write_json(args.out, result)
+    pc.write_json(os.path.join(os.path.dirname(os.path.abspath(args.out)), "skill-input.json"),
+                  skill_input(result))
+    print(json.dumps({"ok": True, "out": args.out, "slices": len(result["slices"]),
+                      "not_ready": sum(not f["ready"] for s in result["slices"] for f in s["features"])}))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/core/components/plays/shape-plan/scripts/model_names.py b/core/components/plays/shape-plan/scripts/model_names.py
new file mode 100644
index 00000000..d16bcb17
--- /dev/null
+++ b/core/components/plays/shape-plan/scripts/model_names.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""
+model_names.py — stop on a product model written before the feature rename (#807).
+
+Issue #807 renamed the model's "functionality" to "feature". A script that reads an old
+model with the new names finds no features and goes on as if the model were empty. This
+guard makes that loud: on any old key it prints a plain message naming the key, the file
+and the script that moves the model (migrate_model.py), and exits with code 2.
+
+Old names it stops on:
+  functionalities:          (spine list, or a slice record's slice.functionalities)
+  functionality_refs        (an epic's list of feature references)
+  functionality_ref         (a slice record's feature reference)
+  for_kind: functionality   (an ICE entry)
+
+Old page names it stops on (in the product-os folder):
+  functionality.md          (a feature's page, now feature.md)
+  functionalities/          (a folder of feature pages, now features/)
+
+Use, right after the YAML is parsed:
+    check_spine(spine, path)     # a _spine.yaml
+    check_slice(record, path)    # a slice record
+    check_model(data, path)      # any other model YAML
+    check_pages(model_dir)       # the product-os folder, before reading its pages
+
+SHARED script: every copy matches the others byte for byte (the component linter checks this). Standard library only.
+"""
+
+import os
+import sys
+
+OLD_KEYS = {
+    "functionalities": "features",
+    "functionality_refs": "feature_refs",
+    "functionality_ref": "feature_ref",
+}
+
+OLD_PAGES = {"functionality.md": "feature.md"}
+OLD_FOLDERS = {"functionalities": "features"}
+
+UPGRADE_STEP = (
+    "To upgrade the model to the new names, a person runs the script that moves it:\n"
+    "  python3 <install-garura>/scripts/migrate_model.py --target <project>"
+)
+
+
+def _stop(path, where, old, new):
+    sys.stderr.write(
+        f"{path}: this product model uses the old name '{old}' (at {where}); "
+        f"since #807 it is '{new}'.\n"
+        f"Reading it with the new names would see no features, so this script stops here.\n"
+        f"{UPGRADE_STEP}\n"
+    )
+    sys.exit(2)
+
+
+def _find_old(data, where):
+    """Return (where, old, new) for the first old name in data, or None."""
+    if isinstance(data, dict):
+        for key, value in data.items():
+            here = f"{where}.{key}" if where else str(key)
+            if key in OLD_KEYS:
+                return here, key, OLD_KEYS[key]
+            if key == "for_kind" and value == "functionality":
+                return here, "for_kind: functionality", "for_kind: feature"
+            found = _find_old(value, here)
+            if found:
+                return found
+    elif isinstance(data, list):
+        for i, item in enumerate(data):
+            found = _find_old(item, f"{where}[{i}]")
+            if found:
+                return found
+    return None
+
+
+def check_model(data, path):
+    """Stop (exit 2) if any old name appears anywhere in this parsed YAML."""
+    found = _find_old(data, "")
+    if found:
+        _stop(path, *found)
+    return data
+
+
+def check_spine(spine, path):
+    """Stop (exit 2) if a parsed _spine.yaml still uses an old name."""
+    return check_model(spine, path)
+
+
+def check_slice(record, path):
+    """Stop (exit 2) if a parsed slice record still uses an old name."""
+    return check_model(record, path)
+
+
+def check_pages(model_dir):
+    """Stop (exit 2) if the product-os folder still has a page or folder with an old name."""
+    if not os.path.isdir(model_dir):
+        return model_dir
+    for here, dirs, files in os.walk(model_dir):
+        dirs.sort()
+        for name in dirs:
+            if name in OLD_FOLDERS:
+                _stop_page(os.path.join(here, name), "folder", name + "/", OLD_FOLDERS[name] + "/")
+        for name in sorted(files):
+            if name in OLD_PAGES:
+                _stop_page(os.path.join(here, name), "page", name, OLD_PAGES[name])
+    return model_dir
+
+
+def _stop_page(path, what, old, new):
+    sys.stderr.write(
+        f"{path}: this product model has a {what} with the old name '{old}'; "
+        f"since #807 it is '{new}'.\n"
+        f"Reading it with the new names would miss these features, so this script stops here.\n"
+        f"{UPGRADE_STEP}\n"
+    )
+    sys.exit(2)
diff --git a/core/components/plays/shape-plan/scripts/plan_common.py b/core/components/plays/shape-plan/scripts/plan_common.py
new file mode 100644
index 00000000..83152ecc
--- /dev/null
+++ b/core/components/plays/shape-plan/scripts/plan_common.py
@@ -0,0 +1,574 @@
+#!/usr/bin/env python3
+"""plan_common.py — the parts the /shape-plan scripts share.
+
+Not run on its own. The scripts beside it import it for four jobs:
+
+  - Safe writes. `atomic_write` and `write_json` write through a temp file in the same folder,
+    then move it into place with os.replace. A run that stops half way never leaves half a
+    file.
+  - The ICE text of a part. `ice_lines` reads the ICE of a feature or a capability: the inline
+    `## Agent intent (ICE)` section of the part's page, or, when the spine has an `ices` list,
+    the `## Intent`, `## Context` and `## Expectation` sections of the part's ice.md.
+    `fails_if_texts` lists every line of each "Fails if" block (the line itself and every line
+    under it: nested bullets, wrapped text) and `without_fails_if` takes each block out.
+  - The words that must never reach an epic, a story or a plan file: "Fails if" and the two
+    recovery phrases (`forbidden_in`).
+  - The tracker. `open_tracker` gives a file tracker (`--tracker-file <json>`, for tests and
+    dry runs) or the code host, reached only through platform_adapter.py. Both have the same
+    methods: get, create (title, body, type and parent in one write), set_type, set_body,
+    remove_labels, add_sub, remove_sub, save.
+  - The hash of a file (`sha256_of`), so a yes stays tied to the files the person saw.
+
+The file tracker is a JSON file {"issues": [{"number", "title", "type", "labels": [],
+"state", "body", "sub_issues": [numbers]}]}. A new issue takes the next free number. Like a
+real tracker, it keeps each write at once: the file is written after every write. A test can
+make one write fail: `"fail_at_write": <n>` in the file makes the n-th write of the run fail,
+with nothing changed by it.
+
+The code host is reached through the adapter's verbs only: view-issue, create-issue-typed,
+set-issue-type, edit-issue-body, remove-label, attach-sub-issue and remove-sub-issue. No
+judgment is made here.
+"""
+
+import hashlib
+
+import json
+import os
+import re
+import tempfile
+
+try:
+    import yaml
+except ImportError:  # the scripts say so in plain words
+    yaml = None
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+RECOVERY_PHRASES = ("the builder can fix this alone", "a person must decide")
+EPIC_TYPE, STORY_TYPE = "Feature", "Story"
+
+
+class Refused(Exception):
+    """A refusal or bad input: the script writes nothing and exits 2."""
+
+
+class TrackerError(Exception):
+    """The tracker did not do what it was asked."""
+
+
+# ---- files ------------------------------------------------------------------------------
+
+def atomic_write(path, text):
+    """Write `text` to `path` through a temp file in the same folder, then os.replace it."""
+    folder = os.path.dirname(os.path.abspath(path))
+    os.makedirs(folder, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix=".shape-plan-", suffix=".tmp", dir=folder)
+    try:
+        with os.fdopen(fd, "w", encoding="utf-8") as fh:
+            fh.write(text)
+        os.replace(tmp, path)
+    except BaseException:
+        if os.path.exists(tmp):
+            os.remove(tmp)
+        raise
+
+
+def sha256_of(path):
+    """The sha256 of a file's bytes, or None when it cannot be read."""
+    try:
+        with open(path, "rb") as fh:
+            return hashlib.sha256(fh.read()).hexdigest()
+    except OSError:
+        return None
+
+
+def write_json(path, obj):
+    atomic_write(path, json.dumps(obj, indent=2, ensure_ascii=False) + "\n")
+
+
+def read_text(path):
+    with open(path, encoding="utf-8") as fh:
+        return fh.read()
+
+
+def read_json(path, what):
+    try:
+        return json.loads(read_text(path))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise Refused(f"cannot read {what} at {path}: {exc}")
+
+
+def read_yaml(path, what):
+    if yaml is None:
+        raise Refused("PyYAML is needed (pip install pyyaml)")
+    try:
+        return yaml.safe_load(read_text(path))
+    except (OSError, yaml.YAMLError) as exc:
+        raise Refused(f"cannot read {what} at {path}: {exc}")
+
+
+# ---- text -------------------------------------------------------------------------------
+
+def norm(text):
+    """Text for matching: case, spacing and a closing full stop do not count."""
+    return " ".join(str(text).split()).rstrip(".").lower()
+
+
+def forbidden_in(text, fails_lines=()):
+    """What in `text` must never reach an epic, a story or a plan file, as plain reasons."""
+    found = []
+    low = norm(text)
+    if "fails if" in low:
+        found.append('it holds the words "Fails if"')
+    for phrase in RECOVERY_PHRASES:
+        if phrase in low:
+            found.append(f'it holds the recovery phrase "{phrase}"')
+    for line in fails_lines:
+        n = norm(line)
+        if len(n.split()) >= 2 and n in low:
+            found.append(f'it holds a failure line of its ICE: "{line}"')
+    return found
+
+
+def all_text(value):
+    """Every string inside a JSON value, joined, so one check reads all of it."""
+    if isinstance(value, str):
+        return value
+    if isinstance(value, dict):
+        return "\n".join(all_text(v) for v in value.values())
+    if isinstance(value, list):
+        return "\n".join(all_text(v) for v in value)
+    return ""
+
+
+# ---- the ICE of a part ------------------------------------------------------------------
+
+FAILS_BULLET = re.compile(r"^(?P<lead>\s*)[-*]\s+(?:\*\*)?Fails if:?(?:\*\*)?:?\s*(?P<text>.*?)\s*$",
+                          re.IGNORECASE)
+NEW_ITEM = re.compile(r"^\s*(?:[-*+]\s|\d+[.)]\s|#|\*\*|>|```)")
+FAILS_HEAD = re.compile(r"^\s*(?:#+\s*|\*\*)Fails if\b", re.IGNORECASE)
+HEADING = re.compile(r"^(#+)\s")
+ICE_PARTS = ("## Intent", "## Context", "## Expectation")
+
+
+def entry(spine, key, eid):
+    return next((e for e in spine.get(key) or [] if isinstance(e, dict) and e.get("id") == eid), None)
+
+
+def _section(lines, heading):
+    at = next((i for i, ln in enumerate(lines) if ln.strip() == heading), None)
+    if at is None:
+        return None
+    end = next((i for i in range(at + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
+    return lines[at + 1:end]
+
+
+def ice_page(spine, part):
+    """The page (relative to the model folder) that holds the part's ICE, or None."""
+    if part is None:
+        return None
+    if "ices" in spine:
+        ice = next((i for i in spine.get("ices") or [] if isinstance(i, dict)
+                    and i.get("for") == part.get("id")), None)
+        return ice.get("doc") if ice else None
+    return part.get("doc")
+
+
+def ice_lines(root, spine, part):
+    """The lines of the part's ICE (a list, maybe empty), or None when its page is missing."""
+    rel = ice_page(spine, part)
+    if not rel:
+        return None
+    path = os.path.join(root, rel)
+    if not os.path.isfile(path):
+        return None
+    lines = read_text(path).splitlines()
+    if "ices" in spine:
+        out = []
+        for head in ICE_PARTS:
+            body = _section(lines, head)
+            if body is not None:
+                out.append(head)
+                out.extend(body)
+        return out
+    body = _section(lines, "## Agent intent (ICE)")
+    return body if body is not None else []
+
+
+def _split(lines):
+    """(kept lines, blocks): each block is the lines of one "Fails if" line, label or heading,
+    with every line under it — deeper lines, nested bullets, wrapped text."""
+    kept, blocks, cur = [], [], None
+    for ln in lines or []:
+        indent = len(ln) - len(ln.lstrip())
+        if cur is not None:
+            kind, depth, seen_blank = cur["kind"], cur["depth"], cur["blank"]
+            if not ln.strip():
+                cur["blank"] = True
+                continue
+            if kind == "heading":
+                hm = HEADING.match(ln.lstrip())
+                if not (hm and len(hm.group(1)) <= depth):
+                    cur["lines"].append(ln)
+                    continue
+            elif indent > depth:
+                cur["lines"].append(ln)
+                continue
+            elif kind == "label" and not seen_blank and ln.lstrip().startswith(("- ", "* ", "+ ")):
+                cur["lines"].append(ln)
+                continue
+            elif not seen_blank and not NEW_ITEM.match(ln):
+                cur["lines"].append(ln)  # wrapped text that goes on from the line above
+                continue
+            blocks.append(cur["lines"])
+            cur = None
+        if FAILS_BULLET.match(ln):
+            cur = {"kind": "bullet", "depth": indent, "blank": False, "lines": [ln]}
+            continue
+        if FAILS_HEAD.match(ln):
+            hm = HEADING.match(ln.lstrip())
+            cur = {"kind": "heading" if hm else "label", "depth": len(hm.group(1)) if hm else indent,
+                   "blank": False, "lines": [ln]}
+            continue
+        if "fails if" in ln.lower():
+            blocks.append([ln])
+            continue
+        kept.append(ln)
+    if cur is not None:
+        blocks.append(cur["lines"])
+    return kept, blocks
+
+
+def _text_of(line):
+    m = FAILS_BULLET.match(line)
+    if m:
+        return m.group("text")
+    text = re.sub(r"^\s*(?:[-*+]\s+|\d+[.)]\s+|#+\s*)", "", line).strip()
+    return re.sub(r"^(?:\*\*)?Fails if:?(?:\*\*)?:?\s*", "", text, flags=re.IGNORECASE).strip()
+
+
+def fails_if_texts(lines):
+    """The text of every line of every "Fails if" block, children included."""
+    return [t for block in _split(lines)[1] for t in (_text_of(ln) for ln in block) if t]
+
+
+def without_fails_if(lines):
+    """The lines with every "Fails if" block taken out: the line, label or heading and every
+    line under it. Any other line that still names the words is taken out too."""
+    return _split(lines)[0]
+
+
+def page_title(root, rel, prefix):
+    path = os.path.join(root, rel or "")
+    if rel and os.path.isfile(path):
+        for ln in read_text(path).splitlines():
+            if ln.startswith("# "):
+                head = ln[2:].strip()
+                return head[len(prefix):].strip() if head.startswith(prefix) else head
+    return None
+
+
+# ---- the approval -----------------------------------------------------------------------
+
+def approval_is_yes(path):
+    """(ok, decision, reason): ok only when the file reads decision yes with a typed reply."""
+    try:
+        rec = json.loads(read_text(path))
+    except (OSError, json.JSONDecodeError):
+        return False, None, "no approval is recorded"
+    decision = rec.get("decision") if isinstance(rec, dict) else None
+    reply = rec.get("reply") if isinstance(rec, dict) else None
+    if decision != "yes":
+        return False, decision, f"the decision is {decision!r}, not yes"
+    if not isinstance(reply, str) or not reply.strip():
+        return False, decision, "the reply is empty"
+    return True, decision, "the person typed yes"
+
+
+def approval_matches(path, work_items, drafts):
+    """(ok, reason): ok only when the brief, work-items.json and drafts.json are still the
+    files the person saw when they typed their answer (their sha256 is the one recorded)."""
+    try:
+        files = json.loads(read_text(path)).get("files") or {}
+    except (OSError, json.JSONDecodeError, AttributeError):
+        return False, "no approval is recorded"
+    want = {"brief": (files.get("brief") or {}).get("path"), "work_items": work_items, "drafts": drafts}
+    for key, file_path in want.items():
+        seen = (files.get(key) or {}).get("sha256")
+        if not seen:
+            return False, f"the approval does not record which {key.replace('_', '-')} the person saw"
+        if not file_path or sha256_of(file_path) != seen:
+            return False, (f"{key.replace('_', '-')} ({file_path}) is not the file the person saw; "
+                           "show the brief again")
+    return True, "the files are the ones the person saw"
+
+
+# ---- the tracker ------------------------------------------------------------------------
+
+def _issue(raw):
+    return {"number": int(raw["number"]), "title": raw.get("title") or "",
+            "type": raw.get("type"), "labels": list(raw.get("labels") or []),
+            "state": (raw.get("state") or "open").lower(), "body": raw.get("body") or "",
+            "sub_issues": [int(n) for n in raw.get("sub_issues") or []]}
+
+
+class FileTracker:
+    """A tracker kept in a JSON file. Like a real tracker, each write is kept at once."""
+
+    def __init__(self, path):
+        self.path = path
+        data = read_json(path, "the tracker file")
+        if not isinstance(data, dict) or not isinstance(data.get("issues"), list):
+            raise Refused('the tracker file must be {"issues": [...]}')
+        self.fail_at = data.get("fail_at_write")
+        self.writes = 0
+        self.issues = {}
+        for raw in data["issues"]:
+            if not isinstance(raw, dict) or "number" not in raw:
+                raise Refused("each issue in the tracker file needs a number")
+            self.issues[int(raw["number"])] = _issue(raw)
+
+    def get(self, number):
+        it = self.issues.get(int(number)) if number is not None else None
+        return json.loads(json.dumps(it)) if it else None
+
+    def _must(self, number):
+        it = self.issues.get(int(number))
+        if it is None:
+            raise TrackerError(f"the tracker has no issue #{number}")
+        return it
+
+    def _write(self, what):
+        self.writes += 1
+        if self.fail_at is not None and self.writes == int(self.fail_at):
+            raise TrackerError(f"the tracker did not take write {self.writes} ({what})")
+
+    def _keep(self):
+        data = {"issues": [self.issues[n] for n in sorted(self.issues)]}
+        if self.fail_at is not None:
+            data["fail_at_write"] = self.fail_at
+        write_json(self.path, data)
+
+    def create(self, title, body, type_, parent=None):
+        self._write("make an issue")
+        if parent is not None:
+            self._must(parent)
+        number = max(self.issues, default=0) + 1
+        self.issues[number] = _issue({"number": number, "title": title, "type": type_,
+                                      "labels": [], "state": "open", "body": body})
+        if parent is not None:
+            self.issues[int(parent)]["sub_issues"].append(number)
+        self._keep()
+        return number
+
+    def set_type(self, number, type_):
+        self._write("set the type")
+        self._must(number)["type"] = type_
+        self._keep()
+
+    def set_body(self, number, body):
+        self._write("change the body")
+        self._must(number)["body"] = body
+        self._keep()
+
+    def remove_labels(self, number, labels):
+        self._write("take off labels")
+        it = self._must(number)
+        it["labels"] = [lb for lb in it["labels"] if lb not in labels]
+        self._keep()
+
+    def add_sub(self, parent, child):
+        self._write("add a sub-issue")
+        self._must(child)
+        subs = self._must(parent)["sub_issues"]
+        if int(child) not in subs:
+            subs.append(int(child))
+        self._keep()
+
+    def remove_sub(self, parent, child):
+        self._write("take off a sub-issue")
+        it = self._must(parent)
+        it["sub_issues"] = [n for n in it["sub_issues"] if n != int(child)]
+        self._keep()
+
+    def save(self):
+        return None
+
+
+class HostTracker:
+    """The code host, reached only through platform_adapter.py's verbs."""
+
+    def __init__(self, config):
+        import sys
+        sys.path.insert(0, HERE)
+        import platform_adapter as pa  # noqa: E402  (copied beside this script)
+        self.pa, self.config = pa, config
+
+    def _adapter(self, verb, args):
+        res = self.pa.dispatch(verb, args, config_path=self.config)
+        if res["exit_code"] != 0:
+            raise TrackerError(f"{verb} failed: {res['stderr'].strip() or res['stdout'].strip()}")
+        return res
+
+    def get(self, number):
+        if number is None:
+            return None
+        try:
+            res = self._adapter("view-issue", {"issue_number": str(number)})
+        except TrackerError:
+            return None
+        if not res.get("tree_available"):
+            raise Refused("the tracker cannot show the issue type and sub-issues "
+                          "(on GitHub, gh 2.94.0 or later is needed)")
+        raw = json.loads(res["stdout"])
+        subs = raw.get("subIssues") or []
+        if isinstance(subs, dict):
+            subs = subs.get("nodes") or []
+        itype = raw.get("issueType") or {}
+        return _issue({"number": raw["number"], "title": raw.get("title"),
+                       "type": itype.get("name") if isinstance(itype, dict) else itype,
+                       "labels": [lb.get("name") for lb in raw.get("labels") or []],
+                       "state": raw.get("state"), "body": raw.get("body"),
+                       "sub_issues": [s.get("number") for s in subs if isinstance(s, dict)]})
+
+    def create(self, title, body, type_, parent=None):
+        args = {"title": title, "body": body, "issue_type": type_}
+        if parent is not None:
+            args["parent_number"] = str(parent)
+        res = self._adapter("create-issue-typed", args)
+        number = res["stdout"].strip()
+        if not number.isdigit():
+            raise TrackerError(f"create-issue-typed gave no issue number: {number!r}")
+        return int(number)
+
+    def set_type(self, number, type_):
+        self._adapter("set-issue-type", {"issue_number": str(number), "issue_type": type_})
+
+    def set_body(self, number, body):
+        self._adapter("edit-issue-body", {"issue_number": str(number), "body": body})
+
+    def remove_labels(self, number, labels):
+        for label in labels:
+            self._adapter("remove-label", {"issue_number": str(number), "label": label})
+
+    def add_sub(self, parent, child):
+        self._adapter("attach-sub-issue", {"parent_number": str(parent), "child_number": str(child)})
+
+    def remove_sub(self, parent, child):
+        self._adapter("remove-sub-issue", {"parent_number": str(parent), "child_number": str(child)})
+
+    def save(self):
+        return None
+
+
+def open_tracker(tracker_file=None, config=".garura/core/config.yaml"):
+    return FileTracker(tracker_file) if tracker_file else HostTracker(config)
+
+
+# ---- issue bodies -----------------------------------------------------------------------
+
+def has_heading(body, name):
+    return re.search(rf"(?im)^#{{1,6}}\s*{re.escape(name)}\s*$", body or "") is not None
+
+
+def has_line(body, line):
+    return any(ln.strip() == line for ln in (body or "").splitlines())
+
+
+def lines_kept(old, new):
+    """True when every line of `old` is in `new`, in the same order."""
+    it = iter((new or "").splitlines())
+    return all(any(ln == x for x in it) for ln in (old or "").splitlines())
+
+
+# ---- the plan file's tree ---------------------------------------------------------------
+
+def load_plan(path):
+    """The plan file as a mapping, or None when there is no plan file."""
+    if not os.path.isfile(path):
+        return None
+    plan = read_yaml(path, "the plan file")
+    if not isinstance(plan, dict):
+        raise Refused("the plan file must be a YAML mapping")
+    return plan
+
+
+def walk(nodes):
+    """Every node of a tree, at any depth."""
+    for node in nodes or []:
+        if isinstance(node, dict):
+            yield node
+            yield from walk(node.get("children"))
+
+
+def marked(nodes, represents):
+    """The nodes, at any depth, whose `represents` is the given id."""
+    return [n for n in walk(nodes) if str(n.get("represents") or "") == str(represents)]
+
+
+def children(node):
+    return [c for c in node.get("children") or [] if isinstance(c, dict)]
+
+
+# ---- the epic's feature-to-story map ----------------------------------------------------
+
+MAP_HEADING = "Feature-to-story map"
+MAP_LINE = re.compile(r"^\s*[-*]\s+(?P<feature>\S+)\s+→\s+#(?P<issue>\d+)\s*$")
+
+
+def _map_span(lines):
+    """(start, end) of the map section's lines (heading included), or None."""
+    at = next((i for i, ln in enumerate(lines)
+               if re.match(rf"^(#{{1,6}})\s*{re.escape(MAP_HEADING)}\s*$", ln, re.IGNORECASE)), None)
+    if at is None:
+        return None
+    level = len(re.match(r"^(#+)", lines[at]).group(1))
+    end = next((i for i in range(at + 1, len(lines))
+                if re.match(r"^(#+)\s", lines[i]) and len(re.match(r"^(#+)", lines[i]).group(1)) <= level),
+               len(lines))
+    return at, end
+
+
+def read_map(body):
+    """{feature: issue} from the epic's map section, or None when it has no map section."""
+    lines = (body or "").splitlines()
+    span = _map_span(lines)
+    if span is None:
+        return None
+    out = {}
+    for ln in lines[span[0] + 1:span[1]]:
+        m = MAP_LINE.match(ln)
+        if m:
+            out[m.group("feature")] = int(m.group("issue"))
+    return out
+
+
+def map_lines(pairs):
+    """The map section's text: the heading, then one line "<feature> → #<story>" each."""
+    return [f"## {MAP_HEADING}", ""] + [f"- {f} → #{n}" for f, n in pairs]
+
+
+def with_map(body, pairs):
+    """The body with its map section written again; every other line stays where it is."""
+    lines = (body or "").splitlines()
+    new = map_lines(pairs)
+    span = _map_span(lines)
+    if span is None:
+        while lines and not lines[-1].strip():
+            lines.pop()
+        lines = lines + ([""] if lines else []) + new
+    else:
+        tail = lines[span[1]:]
+        lines = lines[:span[0]] + new + ([""] if tail else []) + tail
+    return "\n".join(lines).rstrip() + "\n"
+
+
+def map_pairs(slice_items, made=None):
+    """[(feature, story issue)] in the slice's order: each feature that has a story, made in
+    this run (`made`: {feature: issue}) or there before. A moved-out story is not in it."""
+    made = made or {}
+    out = []
+    for st in slice_items.get("stories") or []:
+        issue = made.get(st.get("feature")) or st.get("issue")
+        if issue is not None:
+            out.append((st.get("feature"), int(issue)))
+    return out
