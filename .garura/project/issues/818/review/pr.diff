++            return None
++        if not res.get("tree_available"):
++            raise Refused("the tracker cannot show the issue type and sub-issues (gh 2.94.0 or later is needed)")
++        raw = json.loads(res["stdout"])
++        subs = raw.get("subIssues") or []
++        if isinstance(subs, dict):
